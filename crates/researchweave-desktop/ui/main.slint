        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    private property <[string]> pages: [
        "Welcome", "Dashboard", "Question", "Search", "Protocol", "Library", "Reader", "PDF Reader",
        "Evidence", "Review", "PRISMA", "Extraction", "Data View", "Variable View", "Statistics",
        "Analysis Results", "Qualitative", "Codebook", "Mixed Methods", "Manuscript", "References",
        "Notebook", "Publishing", "Agent", "Providers", "Privacy", "Integrations", "Exports",
        "Backups", "Recovery", "Diagnostics", "Jobs", "Notifications", "Tutorials", "Guidance",
        "Shortcuts", "Preferences", "Activity", "About", "Project Metadata"
    ];

    // Activity roots are intentionally much smaller than the legacy 39-screen directory.
    // Legacy page ids remain stable for migration, automation and command aliases.
    private property <int> activity:
        (root.page == 0 || root.page == 1 || root.page == 2 || root.page == 4 || root.page == 39) ? 0 :
        (root.page == 3 || root.page == 5 || root.page == 6 || root.page == 7 || root.page == 8 ||
         root.page == 9 || root.page == 10 || root.page == 11 || root.page == 20) ? 1 :
        (root.page >= 12 && root.page <= 18) ? 2 :
        (root.page == 19 || root.page == 21 || root.page == 22 || root.page == 27) ? 3 :
        (root.page == 23 || root.page == 31 || root.page == 32) ? 4 : 5;
    private property <string> activity-name:
        root.activity == 0 ? "Home" :
        root.activity == 1 ? "Sources" :
        root.activity == 2 ? "Analyze" :
        root.activity == 3 ? "Synthesize" :
        root.activity == 4 ? "Automate" : "Manage";
    // Keep responsive state imperative so child layout metrics never feed back
    // into the width expression that decides whether those children collapse.
    // Do not replace these changed callbacks with a direct width-dependent
    // visibility binding: doing so creates a cyclic Slint layout dependency.
    private property <bool> show-context-sidebar: true;
    private property <bool> show-inspector: true;
    private property <bool> show-extra-destinations: false;
    private property <length> responsive-width: root.width;
    private property <int> responsive-scale: Theme.ui-scale;
    changed responsive-width => {
        root.show-context-sidebar = Theme.ui-scale < 160 && root.responsive-width >= 980px * Theme.ui-scale / 100;
        root.show-inspector = root.responsive-width >= 1180px * Theme.ui-scale / 100;
    }
    changed responsive-scale => {
        root.show-context-sidebar = Theme.ui-scale < 160 && root.responsive-width >= 980px * Theme.ui-scale / 100;
        root.show-inspector = root.responsive-width >= 1180px * Theme.ui-scale / 100;
    }
    private property <string> object-kind:
        (root.page == 0 || root.page == 1 || root.page == 2 || root.page == 4 || root.page == 39) ? "Project" :
        (root.page >= 3 && root.page <= 11) || root.page == 20 ? "Source" :
        (root.page == 12 || root.page == 13) ? "Dataset" :
        (root.page >= 14 && root.page <= 18) ? "Analysis" :
        (root.page == 19 || root.page == 21 || root.page == 22 || root.page == 27) ? "Document" :
        (root.page == 23 || root.page == 31 || root.page == 32) ? "Automation" : "Workspace";
    private property <int> focus-region: 0;
    private property <int> statistics-mode: 0;

    FocusScope {
        KeyBinding {
            keys: @keys(F6);
            activated => {
                if (root.focus-region == 0) {
                    if (root.show-context-sidebar) {
                        context-start.focus();
                        root.focus-region = 1;
                    } else {
                        command-field.focus();
                        root.focus-region = 2;
                    }
                } else if (root.focus-region == 1) {
                    command-field.focus();
                    root.focus-region = 2;
                } else if (root.focus-region == 2) {
                    tray-focus.focus();
                    root.focus-region = 3;
                } else {
                    home-activity.focus();
                    root.focus-region = 0;
                }
            }
        }
        KeyBinding {
            keys: @keys(Shift + F6);
            activated => {
                if (root.focus-region == 0) {
                    tray-focus.focus();
                    root.focus-region = 3;
                } else if (root.focus-region == 3) {
                    command-field.focus();
                    root.focus-region = 2;
                } else if (root.focus-region == 2) {
                    if (root.show-context-sidebar) {
                        context-start.focus();
                        root.focus-region = 1;
                    } else {
                        home-activity.focus();
                        root.focus-region = 0;
                    }
                } else {
                    home-activity.focus();
                    root.focus-region = 0;
                }
            }
        }
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "k" || event.text == "K")) {
                command-field.focus();
                accept
            } else if (event.text == Key.Escape) {
                command-field.text = "";
                root.command-results = "Search views, resources, settings and help";
                home-activity.focus();
                root.focus-region = 0;
                accept
            } else if (event.modifiers.control && event.text == "1") {
                root.page = 0;
                accept
            } else if (event.modifiers.control && event.text == "2") {
                root.page = 1;
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            spacing: 0px;

            HorizontalLayout {
                spacing: 0px;

                // Activity rail: stable roots instead of 39 equal-weight destinations.
                Rectangle {
                    min-width: Theme.ui-scale > 150 ? 176px : (Theme.ui-scale > 120 ? 132px : 104px);
                    preferred-width: Theme.ui-scale > 150 ? 176px : (Theme.ui-scale > 120 ? 132px : 104px);
                    max-width: Theme.ui-scale > 150 ? 176px : (Theme.ui-scale > 120 ? 132px : 104px);
                    horizontal-stretch: 0;
                    background: Theme.rail-background;
                    accessible-role: navigation;
                    accessible-label: "Activity rail";
                    ScrollView {
                      VerticalLayout {
                        padding: 10px;
                        spacing: 5px;
                        alignment: start;
                        Image {
                            source: @image-url("../../../assets/branding/researchweave-mark.svg");
                            min-height: 34px;
                            preferred-height: 34px;
                            max-height: 34px;
                            image-fit: contain;
                        }
                        Text {
                            text: "WORKBENCH";
                            color: Theme.rail-muted;
                            font-size: Theme.ui-scale > 150 ? 12px : 9px;
                            horizontal-alignment: center;
                        }
                        Rectangle { height: 2px; }
                        home-activity := ActivityNavButton {
                            label: "Home";
                            icon: @image-url("../../../assets/icons/home.svg");
                            selected: root.activity == 0;
                            clicked => { root.page = 1; }
                        }
                        ActivityNavButton {
                            label: "Sources";
                            icon: @image-url("../../../assets/icons/sources.svg");
                            selected: root.activity == 1;
                            clicked => { root.page = 5; }
                        }
                        ActivityNavButton {
                            label: "Analyze";
                            icon: @image-url("../../../assets/icons/analyze.svg");
                            selected: root.activity == 2;
                            clicked => { root.page = 12; }
                        }
                        ActivityNavButton {
                            label: "Synthesize";
                            icon: @image-url("../../../assets/icons/synthesize.svg");
                            selected: root.activity == 3;
                            clicked => { root.page = 21; }
                        }
                        ActivityNavButton {
                            label: "Automate";
                            icon: @image-url("../../../assets/icons/automate.svg");
                            selected: root.activity == 4;
                            clicked => { root.page = 23; }
                        }
                        ActivityNavButton {
                            label: "Manage";
                            icon: @image-url("../../../assets/icons/manage.svg");
                            selected: root.activity == 5;
                            clicked => { root.page = 36; }
                        }
                      }
                    }
                }

                // Context sidebar changes with the active research activity.
                Rectangle {
                    visible: root.show-context-sidebar && !root.context-ai-open &&
                        !(root.page == 19 && root.writing-focus-mode);
                    min-width: self.visible ? 180px * Theme.ui-scale / 100 : 0px;
                    preferred-width: self.visible ? 245px * Theme.ui-scale / 100 : 0px;
                    max-width: self.visible ? 255px * Theme.ui-scale / 100 : 0px;
                    horizontal-stretch: 0;
                    clip: true;
                    background: Theme.surface;
                    border-color: Theme.divider;
                    border-width: 1px;
                    accessible-role: navigation;
                    accessible-label: root.activity-name + " navigation";
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: root.activity-name;
                            color: Theme.ink;
                            font-size: 18px * Theme.ui-scale / 100;
                            font-weight: 650;
                        }
                        context-start := Button {
                            text: "Current activity";
                            min-height: 32px;
                            preferred-height: 34px;
                            max-height: 32px;
                            accessible-label: root.activity-name + " navigation start";
                            accessible-description: "Keyboard focus entry point for the current activity sidebar";
                            clicked => {
                                root.page =
                                    root.activity == 0 ? 1 :
                                    root.activity == 1 ? 5 :
                                    root.activity == 2 ? 12 :
                                    root.activity == 3 ? 21 :
                                    root.activity == 4 ? 23 : 36;
                            }
                        }
                        Text {
                            text: root.project-title;
                            color: Theme.muted-ink;
                            font-size: 12px * Theme.ui-scale / 100;
                        }
                        Rectangle { height: 6px; }

                        if root.activity == 0: VerticalLayout {
                            spacing: 5px;
                            alignment: start;
                            SidebarItem { text: root.page == 0 ? "› Start Center" : "Start Center"; accessible-label: "Welcome workspace screen"; clicked => { root.page = 0; } }
                            SidebarItem { text: root.page == 1 ? "› Project Home" : "Project Home"; accessible-label: "Dashboard workspace screen"; clicked => { root.page = 1; } }
                            SidebarItem { text: root.page == 2 ? "› Research Question" : "Research Question"; accessible-label: "Question workspace screen"; clicked => { root.page = 2; } }
                            SidebarItem { text: root.page == 4 ? "› Protocol" : "Protocol"; accessible-label: "Protocol workspace screen"; clicked => { root.page = 4; } }
                        }
                        if root.activity == 1: VerticalLayout {
                            spacing: 5px;
                            alignment: start;
                            SidebarItem { text: root.page == 5 ? "› Library" : "Library"; accessible-label: "Library workspace screen"; clicked => { root.page = 5; } }
                            if root.show-extra-destinations: SidebarItem { text: root.page == 3 ? "› Search" : "Search"; accessible-label: "Search workspace screen"; clicked => { root.page = 3; } }
                            if root.show-extra-destinations: SidebarItem { text: root.page == 6 ? "› Reader" : "Reader"; accessible-label: "Reader workspace screen"; clicked => { root.page = 6; } }
                            SidebarItem { text: root.page == 7 ? "› PDF Reader" : "PDF Reader"; accessible-label: "PDF Reader workspace screen"; clicked => { root.page = 7; } }
                            if root.show-extra-destinations: SidebarItem { text: root.page == 8 ? "› Evidence" : "Evidence"; accessible-label: "Evidence workspace screen"; clicked => { root.page = 8; } }
                            SidebarItem { text: root.page == 20 ? "› References" : "References"; accessible-label: "References workspace screen"; clicked => { root.page = 20; } }
                            Text { text: "SYSTEMATIC REVIEW"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                            SidebarItem { text: root.page == 9 ? "› Review" : "Review"; accessible-label: "Review workspace screen"; clicked => { root.page = 9; } }
                            SidebarItem { text: root.page == 10 ? "› PRISMA" : "PRISMA"; accessible-label: "PRISMA workspace screen"; clicked => { root.page = 10; } }
                            SidebarItem { text: root.page == 11 ? "› Extraction" : "Extraction"; accessible-label: "Extraction workspace screen"; clicked => { root.page = 11; } }
                        }
                        if root.activity == 2: VerticalLayout {
                            spacing: 5px;
                            alignment: start;
                            Text { text: "DATA"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                            SidebarItem { text: root.page == 12 ? "› Data" : "Data"; accessible-label: "Data View workspace screen"; clicked => { root.page = 12; } }
                            SidebarItem { text: root.page == 13 ? "› Variables" : "Variables"; accessible-label: "Variable View workspace screen"; clicked => { root.page = 13; } }
                            Text { text: "ANALYSIS"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                            SidebarItem { text: root.page == 14 ? "› Statistics" : "Statistics"; accessible-label: "Statistics workspace screen"; clicked => { root.page = 14; } }
                            SidebarItem { text: root.page == 15 ? "› Results" : "Results"; accessible-label: "Analysis Results workspace screen"; clicked => { root.page = 15; } }
                            SidebarItem { text: root.page == 16 ? "› Qualitative" : "Qualitative"; accessible-label: "Qualitative workspace screen"; clicked => { root.page = 16; } }
                            SidebarItem { text: root.page == 17 ? "› Codebook" : "Codebook"; accessible-label: "Codebook workspace screen"; clicked => { root.page = 17; } }
                            SidebarItem { text: root.page == 18 ? "› Mixed Methods" : "Mixed Methods"; accessible-label: "Mixed Methods workspace screen"; clicked => { root.page = 18; } }
                        }
                        if root.activity == 3: VerticalLayout {
                            spacing: 5px;
                            alignment: start;
                            SidebarItem { text: root.page == 21 ? "› Notebook" : "Notebook"; accessible-label: "Notebook workspace screen"; clicked => { root.page = 21; } }
                            SidebarItem { text: root.page == 19 ? "› Manuscript" : "Manuscript"; accessible-label: "Manuscript workspace screen"; clicked => { root.page = 19; } }
                            SidebarItem { text: root.page == 22 ? "› Publishing" : "Publishing"; accessible-label: "Publishing workspace screen"; clicked => { root.page = 22; } }
                            SidebarItem { text: root.page == 27 ? "› Exports" : "Exports"; accessible-label: "Exports workspace screen"; clicked => { root.page = 27; } }
                        }
                        if root.activity == 4: VerticalLayout {
                            spacing: 5px;
                            alignment: start;
                            SidebarItem { text: root.page == 23 ? "› Assistant" : "Assistant"; accessible-label: "Agent workspace screen"; clicked => { root.page = 23; } }
                            SidebarItem { text: root.page == 31 ? "› Jobs" : "Jobs"; accessible-label: "Jobs workspace screen"; clicked => { root.page = 31; } }
                            SidebarItem { text: root.page == 32 ? "› Notifications" : "Notifications"; accessible-label: "Notifications workspace screen"; clicked => { root.page = 32; } }
                        }
                        if root.activity == 5: VerticalLayout {
                            spacing: 4px;
                            alignment: start;
                            SidebarItem { text: root.page == 24 ? "› Providers" : "Providers"; accessible-label: "Providers workspace screen"; clicked => { root.page = 24; } }
                            if root.show-extra-destinations: SidebarItem { text: root.page == 25 ? "› Privacy & approvals" : "Privacy & approvals"; accessible-label: "Privacy workspace screen"; clicked => { root.page = 25; } }
                            if root.show-extra-destinations: SidebarItem { text: root.page == 26 ? "› Integrations" : "Integrations"; accessible-label: "Integrations workspace screen"; clicked => { root.page = 26; } }
                            SidebarItem { text: root.page == 28 ? "› Backups" : "Backups"; accessible-label: "Backups workspace screen"; clicked => { root.page = 28; } }
                            SidebarItem { text: root.page == 29 ? "› Recovery" : "Recovery"; accessible-label: "Recovery workspace screen"; clicked => { root.page = 29; } }
                            SidebarItem { text: root.page == 30 ? "› Diagnostics" : "Diagnostics"; accessible-label: "Diagnostics workspace screen"; clicked => { root.page = 30; } }
                            SidebarItem { text: root.page == 36 ? "› Preferences" : "Preferences"; accessible-label: "Preferences workspace screen"; clicked => { root.page = 36; } }
                            if root.show-extra-destinations: SidebarItem { text: root.page == 35 ? "› Shortcuts" : "Shortcuts"; accessible-label: "Shortcuts workspace screen"; clicked => { root.page = 35; } }
                            if root.show-extra-destinations: SidebarItem { text: root.page == 33 ? "› Tutorials" : "Tutorials"; accessible-label: "Tutorials workspace screen"; clicked => { root.page = 33; } }
                            if root.show-extra-destinations: SidebarItem { text: root.page == 34 ? "› Guidance" : "Guidance"; accessible-label: "Guidance workspace screen"; clicked => { root.page = 34; } }
                            SidebarItem { text: root.page == 37 ? "› Activity" : "Activity"; accessible-label: "Activity workspace screen"; clicked => { root.page = 37; } }
                            if root.show-extra-destinations: SidebarItem { text: root.page == 38 ? "› About" : "About"; accessible-label: "About workspace screen"; clicked => { root.page = 38; } }
                        }
                        SidebarItem {
                            text: root.show-extra-destinations ? "Show fewer sections" : "More sections";
                            accessible-label: root.show-extra-destinations ? "Collapse optional destinations" : "Reveal all destinations including planned features";
                            clicked => { root.show-extra-destinations = !root.show-extra-destinations; }
                        }
                    }
                }

                // Primary work area.
                VerticalLayout {
                    spacing: 0px;
                    accessible-role: main;
                    accessible-label: root.pages[root.page] + " work area";
                    Rectangle {
                        height: 84px * Theme.ui-scale / 100;
                        background: Theme.surface;
                        border-color: Theme.divider;
                        border-width: 1px;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: root.activity-name + "  /  " + root.pages[root.page];
                                    color: Theme.muted-ink;
                                    font-size: 11px * Theme.ui-scale / 100;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.pages[root.page];
                                    color: Theme.ink;
                                    font-size: 22px * Theme.ui-scale / 100;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle { width: root.context-ai-open ? 0px : 16px; }
                            command-field := LineEdit {
                                placeholder-text: "Find workbench views…  Ctrl+K";
                                min-width: 80px;
                                horizontal-stretch: 1;
                                accessible-id: "command-palette";
                                accessible-label: "Command palette";
                                accessible-description: "Press Control K, type a workbench activity or destination, and press Enter";
                                edited(text) => { root.command-results = root.query-command(text); }
                                accepted(text) => {
                                    root.run-command(text);
                                    command-field.text = "";
                                    root.command-results = "Search views, resources, settings and help";
                                }
                            }
                            Button {
                                text: root.context-ai-open ? "Close AI help" : "AI help";
                                accessible-label: root.context-ai-open ? "Close contextual AI panel" : "Open contextual AI assistance for this screen";
                                clicked => {
                                    root.context-ai-open = !root.context-ai-open;
                                    root.context-ai-ready = false;
                                }
                            }
                            Text {
                                text: "Ctrl+K";
                                visible: Theme.ui-scale <= 150 && !root.context-ai-open;
                                color: Theme.muted-ink;
                                font-size: 11px * Theme.ui-scale / 100;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.project-title + " · r" + root.project-revision;
                                visible: Theme.ui-scale <= 150 && root.width >= 1100px && !root.context-ai-open;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: Theme.muted-ink;
                                font-size: 12px * Theme.ui-scale / 100;
                                    wrap: word-wrap;
                            }
                        }
                    }

                    if command-field.text != "": Rectangle {
                        height: 38px * Theme.ui-scale / 100;
                        background: Theme.accent-subtle;
                        border-color: Theme.divider;
                        border-width: 1px;
                        Text {
                            x: 14px;
                            width: parent.width - 28px;
                            vertical-alignment: center;
                            text: root.command-results;
                            color: Theme.ink;
                            font-size: 11px * Theme.ui-scale / 100;
                            accessible-label: "Command center results: " + root.command-results;
                        }
                    }

                    if root.page == 0: Rectangle {
                        background: Theme.raised;
                        HorizontalLayout {
                            padding: 24px;
                            spacing: 20px;
                            Rectangle {
                                background: Theme.surface;
                                border-radius: Theme.panel-radius;
                                border-color: Theme.divider;
                                border-width: 1px;
                                VerticalLayout {
                                    padding: 22px;
                                    spacing: 12px;
                                    Text { text: "Start a research project"; font-size: 24px * Theme.ui-scale / 100; font-weight: 700; color: Theme.ink; }
                                    Text { text: "Private by default. Projects and portable backups stay on your device."; color: Theme.muted-ink; font-size: 13px * Theme.ui-scale / 100; }
                                    Button {
                                        text: "Quick create in managed local storage";
                                        primary: true;
                                        accessible-label: "Create default project";
                                        accessible-description: "Create a private local project without choosing a filesystem path";
                                        clicked => { root.create-default-project(project-name.text); }
                                    }
                                    Text { text: "CUSTOM LOCATION"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: "PROJECT LOCATION"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    project-path := LineEdit {
                                        placeholder-text: "Absolute project folder path";
                                        accessible-id: "project-path";
                                        accessible-label: "Project path";
                                        accessible-description: "Absolute directory path for creating or opening a local project";
                                    }
                                    Text { text: "PROJECT TITLE"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    project-name := LineEdit {
                                        placeholder-text: "New project title";
                                        text: "My Research";
                                        accessible-id: "project-title";
                                        accessible-label: "Project title";
                                        accessible-description: "Title used when creating a new local project";
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button {
                                            text: "Create at custom path";
                                            accessible-label: "Create project";
                                            accessible-description: "Create a project in the specified directory";
                                            clicked => { root.create-project(project-path.text, project-name.text); }
                                        }
                                        Button {
                                            text: "Open existing";
                                            accessible-label: "Open project";
                                            accessible-description: "Open the existing project in the specified directory";
                                            clicked => { root.open-project(project-path.text); }
                                        }
                                    }
                                    Text { text: "Research note"; color: Theme.ink; font-weight: 600; }
                                    TextEdit {
                                        text: "Try multiline text, selection and international input.";
                                        accessible-id: "research-note";
                                        accessible-label: "Research note";
                                        accessible-description: "Multiline editable research note";
                                    }
                                }
                            }
                            Rectangle {
                                visible: root.show-inspector;
                                min-width: 0px;
                                preferred-width: root.show-inspector ? 280px : 0px;
                                max-width: root.show-inspector ? 280px : 0px;
                                horizontal-stretch: 0;
                                background: Theme.accent-subtle;
                                border-radius: Theme.panel-radius;
                                border-color: Theme.divider;
                                border-width: 1px;
                                accessible-role: complementary;
                                accessible-label: "Start Center guidance";
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 10px;
                                    Text { text: "ResearchWeave"; color: Theme.ink; font-size: 18px * Theme.ui-scale / 100; font-weight: 700; }
                                    Text { text: "A traceable research workbench"; color: Theme.accent; font-size: 12px * Theme.ui-scale / 100; }
                                    Rectangle { height: 6px; }
                                    Text { text: "• Question and protocol"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "• Sources and evidence"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "• Data and analysis"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "• Synthesis and publishing"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "• Approval-bound automation"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Rectangle { height: 8px; }
                                    Text { text: "No project selected yet."; color: Theme.muted-ink; font-size: 12px * Theme.ui-scale / 100; }
                                }
                            }
                        }
                    }

                    if root.page == 1: Rectangle {
                        background: Theme.raised;
                        HorizontalLayout {
                            padding: 22px;
                            spacing: 18px;
                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Project home"; font-size: 22px * Theme.ui-scale / 100; font-weight: 700; color: Theme.ink; }
                                Text { text: "Current project"; color: Theme.muted-ink; font-size: 11px * Theme.ui-scale / 100; }
                                Text { text: root.project-title; color: Theme.ink; font-size: 18px * Theme.ui-scale / 100; font-weight: 600; }
                                Text { text: "Revision " + root.project-revision + " · local workspace"; color: Theme.muted-ink; }
                                Button {
                                    text: "Edit project metadata";
                                    accessible-label: "Open project metadata editor";
                                    clicked => { root.page = 39; root.inspect-project-metadata(); }
                                }
                                Text { text: "Continue research"; color: Theme.muted-ink; font-size: 11px * Theme.ui-scale / 100; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Question"; icon: @image-url("../../../assets/icons/question.svg"); icon-size: 18px; colorize-icon: true; accessible-label: "Open research question"; clicked => { root.page = 2; } }
                                    Button { text: "Protocol"; icon: @image-url("../../../assets/icons/protocol.svg"); icon-size: 18px; colorize-icon: true; accessible-label: "Open protocol"; clicked => { root.page = 4; } }
                                    Button { text: "Library"; icon: @image-url("../../../assets/icons/sources.svg"); icon-size: 18px; colorize-icon: true; accessible-label: "Open library"; clicked => { root.page = 5; } }
                                    Button { text: "Data"; icon: @image-url("../../../assets/icons/data.svg"); icon-size: 18px; colorize-icon: true; accessible-label: "Open data view"; clicked => { root.page = 12; } }
                                }
                                Rectangle {
                                    height: 76px;
                                    background: Theme.accent-subtle;
                                    border-radius: Theme.panel-radius;
                                    border-color: Theme.divider;
                                    border-width: 1px;
                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 18px;
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text { text: "REVISION"; color: Theme.muted-ink; font-size: 9px * Theme.ui-scale / 100; }
                                            Text { text: root.project-revision; color: Theme.ink; font-size: 18px * Theme.ui-scale / 100; font-weight: 700; }
                                            Text { text: "immutable project state"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                        }
                                        Rectangle { width: 1px; background: Theme.divider; }
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text { text: "STORAGE"; color: Theme.muted-ink; font-size: 9px * Theme.ui-scale / 100; }
                                            Text { text: "Local first"; color: Theme.success; font-size: 14px * Theme.ui-scale / 100; font-weight: 650; }
                                            Text { text: "project-scoped data"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                        }
                                        Rectangle { width: 1px; background: Theme.divider; }
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text { text: "WRITES"; color: Theme.muted-ink; font-size: 9px * Theme.ui-scale / 100; }
                                            Text { text: "Approval bound"; color: Theme.accent; font-size: 14px * Theme.ui-scale / 100; font-weight: 650; }
                                            Text { text: "preview before mutation"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                        }
                                    }
                                }
                                Text { text: "Responsiveness"; color: Theme.ink; font-weight: 600; }
                                Button {
                                    text: "Run local responsiveness check";
                                    accessible-label: "Run local responsiveness check";
                                    clicked => { root.start-job(); }
                                }
                                SemanticProgress {
                                    progress: root.progress;
                                    label: "Background operation progress";
                                }
                                Text {
                                    text: "No sample research data is fabricated in the production workspace. Open or import real project data from Analyze.";
                                    color: Theme.muted-ink;
                                    font-size: 11px * Theme.ui-scale / 100;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle {
                                visible: root.show-inspector;
                                min-width: 0px;
                                preferred-width: root.show-inspector ? 250px : 0px;
                                max-width: root.show-inspector ? 250px : 0px;
                                horizontal-stretch: 0;
                                background: Theme.surface;
                                border-radius: Theme.panel-radius;
                                border-color: Theme.divider;
                                border-width: 1px;
                                accessible-role: complementary;
                                accessible-label: "Project context inspector";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text { text: "Context"; color: Theme.ink; font-size: 15px * Theme.ui-scale / 100; font-weight: 600; }
                                    Text { text: "Project revision"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: root.project-revision; color: Theme.ink; }
                                    Text { text: "Storage"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: "Local first"; color: Theme.success; }
                                    Text { text: "Network"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: "Explicit approval required"; color: Theme.ink; font-size: 11px * Theme.ui-scale / 100; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    if root.page == 3: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: Theme.space5;
                            spacing: Theme.space3;
                            Text { text: "Search local sources"; font-size: 22px * Theme.ui-scale / 100; font-weight: 700; color: Theme.ink; }
                            Text {
                                text: "Search text imported into this project. Literal case-folded substring search scans up to 10,000 sources; results are not ranked, and excerpts begin at the start of each source.";
                                color: Theme.muted-ink;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.space2;
                                source-query := LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Text to find in local sources";
                                    accessible-label: "Local source search query";
                                    enabled: !root.source-search-busy;
                                    accessible-enabled: !root.source-search-busy;
                                    accepted => { root.search-project-sources(self.text); }
                                }
                                Button {
                                    text: root.source-search-busy ? "Searching…" : "Search";
                                    enabled: !root.source-search-busy;
                                    accessible-enabled: !root.source-search-busy;
                                    accessible-label: "Run local project source search";
                                    clicked => { root.search-project-sources(source-query.text); }
                                }
                                Button {
                                    text: "Source library";
                                    accessible-label: "Open local source library to import text";
                                    clicked => { root.page = 5; }
                                }
                            }
                            Text {
                                text: root.source-search-status;
                                accessible-label: "Local source search status " + root.source-search-status;
                                color: Theme.muted-ink;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                background: Theme.surface;
                                border-color: Theme.divider;
                                border-width: 1px;
                                border-radius: Theme.panel-radius;
                                vertical-stretch: 1;
                                accessible-role: list;
                                accessible-label: "Real local source search results";
                                ScrollView {
                                    VerticalLayout {
                                        padding: Theme.space3;
                                        spacing: Theme.space3;
                                        if root.source-search-results.length == 0: Text {
                                            text: "No results loaded. Enter a search term to find locally stored sources.";
                                            wrap: word-wrap;
                                            color: Theme.muted-ink;
                                        }
                                        for hit in root.source-search-results: Rectangle {
                                            background: Theme.raised;
                                            border-radius: Theme.panel-radius;
                                            border-color: Theme.divider;
                                            border-width: 1px;
                                            min-height: 94px;
                                            VerticalLayout {
                                                padding: Theme.space3;
                                                spacing: Theme.space2;
                                                Button {
                                                    text: hit.title;
                                                    accessible-label: "Read local source " + hit.title;
                                                    clicked => { root.open-reader-source(hit.source-id); }
                                                }
                                                Text {
                                                    text: hit.snippet;
                                                    wrap: word-wrap;
                                                    color: Theme.muted-ink;
                                                    font-size: 12px * Theme.ui-scale / 100;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.page == 6: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: Theme.space5;
                            spacing: Theme.space3;
                            Text { text: "Source reader"; font-size: 22px * Theme.ui-scale / 100; font-weight: 700; color: Theme.ink; }
                            Text {
                                text: "Read checksum-verified text stored in this project, 8,000 Unicode characters per page. PDF rendering and page-specific PDF search are in PDF Reader.";
                                color: Theme.muted-ink;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.space2;
                                reader-source-input := LineEdit {
                                    horizontal-stretch: 1;
                                    text: root.reader-source-id;
                                    placeholder-text: "Source ID from library or search";
                                    accessible-label: "Reader source ID";
                                    edited(value) => { root.reader-source-id = value; }
                                }
                                Button {
                                    text: "Open source";
                                    enabled: !root.reader-busy;
                                    accessible-enabled: !root.reader-busy;
                                    accessible-label: "Read source by exact ID";
                                    clicked => { root.open-reader-source(reader-source-input.text); }
                                }
                                Button {
                                    text: "Refresh source list";
                                    enabled: !root.reader-busy;
                                    accessible-enabled: !root.reader-busy;
                                    accessible-label: "Load local project sources for reader";
                                    clicked => { root.load-reader-source-list(0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space3;
                                Rectangle {
                                    min-width: 180px;
                                    preferred-width: 235px;
                                    max-width: 260px;
                                    horizontal-stretch: 0;
                                    background: Theme.surface;
                                    border-color: Theme.divider;
                                    border-width: 1px;
                                    border-radius: Theme.panel-radius;
                                    VerticalLayout {
                                        padding: Theme.space2;
                                        spacing: Theme.space2;
                                        Text { text: "Available sources"; color: Theme.ink; font-weight: 600; }
                                        Text { text: root.reader-list-status; color: Theme.muted-ink; font-size: 11px * Theme.ui-scale / 100; wrap: word-wrap; }
                                        Rectangle {
                                            vertical-stretch: 1;
                                            ScrollView {
                                                VerticalLayout {
                                                    spacing: Theme.space2;
                                                    if root.reader-source-list.length == 0: Text {
                                                        text: "Refresh to load sources.";
                                                        color: Theme.muted-ink;
                                                        wrap: word-wrap;
                                                    }
                                                    for source in root.reader-source-list: Button {
                                                        text: source.title;
                                                        accessible-label: "Open source " + source.title;
                                                        clicked => { root.open-reader-source(source.source-id); }
                                                    }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: Theme.space2;
                                            Button {
                                                text: "Previous";
                                                enabled: root.reader-list-offset > 0 && !root.reader-busy;
                                                accessible-enabled: root.reader-list-offset > 0 && !root.reader-busy;
                                                accessible-label: "Previous 50 sources";
                                                clicked => { root.load-reader-source-list(max(0, root.reader-list-offset - 50)); }
                                            }
                                            Button {
                                                text: "Next";
                                                enabled: root.reader-list-more && !root.reader-busy;
                                                accessible-enabled: root.reader-list-more && !root.reader-busy;
                                                accessible-label: "Next 50 sources";
                                                clicked => { root.load-reader-source-list(root.reader-list-offset + 50); }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    background: Theme.surface;
                                    border-color: Theme.divider;
                                    border-width: 1px;
                                    border-radius: Theme.panel-radius;
                                    horizontal-stretch: 1;
                                    VerticalLayout {
                                        padding: Theme.space3;
                                        spacing: Theme.space2;
                                        Text { text: root.reader-source-title == "" ? "No source selected" : root.reader-source-title; color: Theme.ink; font-weight: 600; wrap: word-wrap; }
                                        Text {
                                            text: root.reader-status;
                                            accessible-label: "Reader operation status " + root.reader-status;
                                            color: Theme.muted-ink;
                                            wrap: word-wrap;
                                        }
                                        TextEdit {
                                            text: root.reader-text;
                                            read-only: true;
                                            vertical-stretch: 1;
                                            min-height: 160px;
                                            accessible-label: "Checksum-verified local source text; selectable and read-only";
                                        }
                                        HorizontalLayout {
                                            spacing: Theme.space2;
                                            Button {
                                                text: "Previous page";
                                                enabled: root.reader-offset > 0 && !root.reader-busy;
                                                accessible-enabled: root.reader-offset > 0 && !root.reader-busy;
                                                accessible-label: "Read previous source text page";
                                                clicked => { root.load-reader-page(root.reader-source-id, max(0, root.reader-offset - 8000)); }
                                            }
                                            Button {
                                                text: "Next page";
                                                enabled: root.reader-more && !root.reader-busy;
                                                accessible-enabled: root.reader-more && !root.reader-busy;
                                                accessible-label: "Read next source text page";
                                                clicked => { root.load-reader-page(root.reader-source-id, root.reader-offset + root.reader-returned); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Button {
                                                text: "Search sources";
                                                accessible-label: "Open local source search";
                                                clicked => { root.page = 3; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.page == 7: Rectangle {
                        background: Theme.raised;
                        HorizontalLayout {
                            padding: 16px;
                            spacing: 14px;
                            // Keep the inspector separate from the scrollable
                            // Reader column. Scrolling the outer HorizontalLayout
                            // makes its children adopt a very large content
                            // height at 200% and pushes even Open PDF out of view.
                            ScrollView {
                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: "PDF source"; font-size: 18px * Theme.ui-scale / 100; font-weight: 700; color: Theme.ink; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    pdf-path := LineEdit {
                                        text <=> root.pdf-local-path;
                                        horizontal-stretch: 1;
                                        min-width: 80px;
                                        max-width: root.show-inspector ? 450px : 410px;
                                        placeholder-text: "Absolute path to a local PDF";
                                        accessible-label: "PDF file path";
                                        accessible-description: "Absolute path to the PDF file to display";
                                        edited(value) => {
                                            root.pdf-job += 1;
                                            root.context-ai-ready = false;
                                            root.pdf-passage-status = "PDF path changed. Open the file and verify a passage again.";
                                            root.pdf-highlight-visible = false;
                                            root.pdf-page-extracted-text = "";
                                            root.pdf-page-extraction-status = "PDF path changed. Open the file to inspect its current page text.";
                                            root.pdf-page-count = 0;
                                            root.pdf-page-number = 1;
                                            root.pdf-matches = 0;
                                            root.pdf-render-width = 0;
                                            root.pdf-render-height = 0;
                                            root.pdf-status = "PDF path changed; open the selected file.";
                                        }
                                    }
                                    Button {
                                        text: "Browse PDF…";
                                        horizontal-stretch: 0;
                                        min-width: 0px;
                                        preferred-width: 155px;
                                        max-width: 170px;
                                        accessible-label: "Choose local PDF with native file picker";
                                        enabled: !root.local-file-dialog-busy;
                                        accessible-enabled: !root.local-file-dialog-busy;
                                        clicked => { root.choose-local-file("pdf"); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    pdf-query := LineEdit {
                                        text: "PDFium";
                                        min-width: 80px;
                                        preferred-width: root.show-inspector ? 220px : 140px;
                                        max-width: root.show-inspector ? 260px : 150px;
                                        horizontal-stretch: 0;
                                        placeholder-text: "Search current page";
                                        accessible-label: "PDF search query";
                                    }
                                    Button {
                                        text: "Open";
                                        primary: true;
                                        horizontal-stretch: 0;
                                        accessible-label: "Open PDF";
                                        clicked => {
                                            root.pdf-job += 1;
                                            root.context-ai-ready = false;
                                            root.pdf-passage-status = "PDF render requested. Copy and verify a passage from the new page.";
                                            root.pdf-status = "Rendering PDF…";
                                            root.pdf-page-number = 1;
                                            root.pdf-page-count = 0;
                                            root.pdf-highlight-visible = false;
                                            root.pdf-page-extracted-text = "";
                                            root.pdf-page-extraction-status = "Extracting text from the requested PDF page…";
                                            root.load-pdf(pdf-path.text, pdf-query.text, 1);
                                        }
                                    }
                                }
                                // Keep these two frequent actions fully reachable at
                                // 200% UI scale in the minimum-size workbench. A single
                                // row with query, Open, Search, and Find next overflows
                                // the Reader column and silently clips Find next.
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Search";
                                        horizontal-stretch: 0;
                                        min-width: 0px;
                                        preferred-width: 100px;
                                        max-width: 120px;
                                        accessible-label: "Search PDF";
                                        clicked => {
                                            root.pdf-job += 1;
                                            root.context-ai-ready = false;
                                            root.pdf-passage-status = "PDF search requested. Reverify a passage when text loads.";
                                            root.pdf-status = "Searching PDF…";
                                            root.pdf-highlight-visible = false;
                                            root.pdf-page-extracted-text = "";
                                            root.pdf-page-extraction-status = "Extracting text from the requested PDF page…";
                                            root.load-pdf(pdf-path.text, pdf-query.text, root.pdf-page-number);
                                        }
                                    }
                                    Button {
                                        text: "Next match";
                                        horizontal-stretch: 0;
                                        min-width: 0px;
                                        preferred-width: 165px;
                                        max-width: 190px;
                                        accessible-label: "Find next PDF matching page";
                                        enabled: root.pdf-page-count > 0 && pdf-query.text != "";
                                        accessible-enabled: root.pdf-page-count > 0 && pdf-query.text != "";
                                        clicked => {
                                            root.pdf-job += 1;
                                            root.context-ai-ready = false;
                                            root.pdf-passage-status = "Finding next PDF page. Verify a passage after rendering.";
                                            root.pdf-status = "Finding next matching PDF page…";
                                            root.pdf-highlight-visible = false;
                                            root.pdf-page-extracted-text = "";
                                            root.pdf-page-extraction-status = "Finding and extracting text from the next matching PDF page…";
                                            root.find-next-pdf(pdf-path.text, pdf-query.text, root.pdf-page-number);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Previous";
                                        horizontal-stretch: 0;
                                        accessible-label: "Previous PDF page";
                                        enabled: root.pdf-page-number > 1;
                                        accessible-enabled: root.pdf-page-number > 1;
                                        clicked => {
                                            root.pdf-job += 1;
                                            root.context-ai-ready = false;
                                            root.pdf-passage-status = "PDF page changed. Copy and verify a passage on the new page.";
                                            root.pdf-status = "Rendering previous PDF page…";
                                            root.pdf-highlight-visible = false;
                                            root.pdf-page-extracted-text = "";
                                            root.pdf-page-extraction-status = "Extracting text from the requested PDF page…";
                                            root.load-pdf(pdf-path.text, pdf-query.text, root.pdf-page-number - 1);
                                        }
                                    }
                                    Text {
                                        text: root.pdf-page-count > 0 ? "Page " + root.pdf-page-number + " of " + root.pdf-page-count : "No page loaded";
                                        accessible-label: root.pdf-page-count > 0 ? "PDF page " + root.pdf-page-number + " of " + root.pdf-page-count : "No PDF page loaded";
                                        color: Theme.ink;
                                    }
                                    Button {
                                        text: "Next";
                                        horizontal-stretch: 0;
                                        accessible-label: "Next PDF page";
                                        enabled: root.pdf-page-count > 0 && root.pdf-page-number < root.pdf-page-count;
                                        accessible-enabled: root.pdf-page-count > 0 && root.pdf-page-number < root.pdf-page-count;
                                        clicked => {
                                            root.pdf-job += 1;
                                            root.context-ai-ready = false;
                                            root.pdf-passage-status = "PDF page changed. Copy and verify a passage on the new page.";
                                            root.pdf-status = "Rendering next PDF page…";
                                            root.pdf-highlight-visible = false;
                                            root.pdf-page-extracted-text = "";
                                            root.pdf-page-extraction-status = "Extracting text from the requested PDF page…";
                                            root.load-pdf(pdf-path.text, pdf-query.text, root.pdf-page-number + 1);
                                        }
                                    }
                                }
                                Text {
                                    text: root.pdf-status + " · matches: " + root.pdf-matches;
                                    color: Theme.muted-ink;
                                    accessible-label: "PDF search status: " + root.pdf-status + " matches: " + root.pdf-matches;
                                }
                                // At compact widths show the extracted text
                                // immediately after the page controls; the
                                // passage action and canvas follow so the
                                // reader does not bury copyable text at 200%.
                                if !root.show-inspector: Rectangle {
                                    background: Theme.surface;
                                    border-radius: Theme.panel-radius;
                                    border-color: Theme.divider;
                                    border-width: 1px;
                                    min-height: 160px;
                                    preferred-height: 185px;
                                    max-height: 260px;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 4px;
                                        Text {
                                            text: "Extracted current-page text (read-only)";
                                            color: Theme.ink;
                                            font-size: 12px * Theme.ui-scale / 100;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: root.pdf-page-extraction-status;
                                            color: Theme.muted-ink;
                                            font-size: 10px * Theme.ui-scale / 100;
                                            wrap: word-wrap;
                                        }
                                        TextEdit {
                                            text: root.pdf-page-extracted-text;
                                            read-only: true;
                                            enabled: root.pdf-page-extracted-text != "";
                                            accessible-enabled: root.pdf-page-extracted-text != "";
                                            accessible-label: "Read-only actual extracted PDF page text; selectable and copyable, not yet a verified evidence anchor";
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 5px;
                                    Text {
                                        text: "Ask about a PDF passage";
                                        color: Theme.ink;
                                        font-weight: 600;
                                        font-size: 13px * Theme.ui-scale / 100;
                                    }
                                    Text {
                                        text: "Select text in the read-only extracted text area, copy it, then paste the exact passage here. Only one unique occurrence on the displayed page can be verified.";
                                        color: Theme.muted-ink;
                                        wrap: word-wrap;
                                    }
                                    TextEdit {
                                        text: root.pdf-selected-passage;
                                        edited(value) => {
                                            root.pdf-selected-passage = value;
                                            root.context-ai-ready = false;
                                            root.pdf-passage-status = "Passage changed. Verify it again before running a local model.";
                                        }
                                        placeholder-text: "Paste an exact selected PDF passage (up to 4,096 bytes)";
                                        accessible-label: "Selected PDF passage";
                                        accessible-description: "Paste text copied from the displayed extracted PDF page. This field does not read your clipboard automatically.";
                                        min-height: 64px;
                                        preferred-height: 94px;
                                        max-height: 128px;
                                    }
                                    Button {
                                        text: "Ask about this PDF passage";
                                        accessible-label: "Verify selected PDF passage and prepare local AI preview";
                                        enabled: root.pdf-page-count > 0 && root.pdf-page-extracted-text != "" && !root.context-ai-busy;
                                        accessible-enabled: root.pdf-page-count > 0 && root.pdf-page-extracted-text != "" && !root.context-ai-busy;
                                        clicked => { root.ask-about-pdf-passage(); }
                                    }
                                    Text {
                                        text: root.pdf-passage-status;
                                        color: Theme.muted-ink;
                                        wrap: word-wrap;
                                        accessible-label: "PDF passage verification status: " + root.pdf-passage-status;
                                    }
                                }
                                Rectangle {
                                    background: Theme.reader-canvas;
                                    clip: true;
                                    height: root.show-inspector ? 360px : 220px;
                                    pdf-fit := Rectangle {
                                        width: root.pdf-render-width > 0 && root.pdf-render-height > 0
                                            ? min(parent.width, parent.height * root.pdf-render-width / root.pdf-render-height)
                                            : parent.width;
                                        height: root.pdf-render-width > 0 && root.pdf-render-height > 0
                                            ? min(parent.height, parent.width * root.pdf-render-height / root.pdf-render-width)
                                            : parent.height;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        pdf-view := Image {
                                            source: root.pdf-image;
                                            visible: root.pdf-page-count > 0;
                                            width: parent.width;
                                            height: parent.height;
                                            image-fit: contain;
                                            accessible-label: "Rendered PDF page";
                                        }
                                        if root.pdf-highlight-visible: Rectangle {
                                            x: root.pdf-highlight-x * parent.width;
                                            y: root.pdf-highlight-y * parent.height;
                                            width: root.pdf-highlight-w * parent.width;
                                            height: root.pdf-highlight-h * parent.height;
                                            background: Theme.accent-subtle;
                                            border-color: Theme.warning;
                                            border-width: 2px;
                                        }
                                    }
                                }
                            }
                            }
                            Rectangle {
                                visible: root.show-inspector;
                                min-width: 0px;
                                preferred-width: root.show-inspector ? 250px : 0px;
                                max-width: root.show-inspector ? 250px : 0px;
                                horizontal-stretch: 0;
                                background: Theme.surface;
                                border-radius: Theme.panel-radius;
                                border-color: Theme.divider;
                                border-width: 1px;
                                accessible-role: complementary;
                                accessible-label: "PDF reader context inspector";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text { text: "Reader context"; color: Theme.ink; font-size: 15px * Theme.ui-scale / 100; font-weight: 600; }
                                    Text { text: "Current native scope"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: "Native rendering, per-page search and bounded Find next page (wraps once)."; color: Theme.ink; font-size: 11px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "Copy a unique passage from the extracted text and paste it into Ask about a PDF passage. Annotations remain pending."; color: Theme.muted-ink; font-size: 11px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "Extracted current-page text"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; font-weight: 600; }
                                    Text {
                                        text: root.pdf-page-extraction-status;
                                        color: Theme.muted-ink;
                                        wrap: word-wrap;
                                        font-size: 10px * Theme.ui-scale / 100;
                                        accessible-label: "PDF extracted text provenance: " + root.pdf-page-extraction-status;
                                    }
                                    TextEdit {
                                        text: root.pdf-page-extracted-text;
                                        read-only: true;
                                        enabled: root.pdf-page-extracted-text != "";
                                        accessible-enabled: root.pdf-page-extracted-text != "";
                                        accessible-label: "Read-only actual extracted PDF page text; selectable and copyable, not yet a verified evidence anchor";
                                        horizontal-stretch: 1;
                                        vertical-stretch: 1;
                                        min-height: 120px;
                                    }
                                    Text { text: "Evidence"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Button { text: "Open evidence"; clicked => { root.page = 8; } }
                                }
                            }
                        }
                    }

                    if root.page == 5: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 10px;
                            Text { text: "Local source library"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; }
                            source-title := LineEdit { placeholder-text: "Source title"; accessible-label: "Source title"; }
                            source-body := TextEdit { accessible-label: "Source text"; text: ""; }
                            HorizontalLayout {
                                spacing: 10px;
                                Button { text: "Add source"; accessible-label: "Add source"; clicked => { root.library-action("add", source-title.text, source-body.text); } }
                                Button { text: "Refresh sources"; accessible-label: "Refresh sources"; clicked => { root.library-action("list", "", ""); } }
                            }
                            Text { text: root.library-results; color: Theme.ink; wrap: word-wrap; accessible-label: "Library results"; }
                        }
                    }

                    if root.page == 36: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                          VerticalLayout {
                            padding: 24px;
                            spacing: 14px;
                            Text { text: "Display preferences"; color: Theme.ink; font-size: 24px * Theme.ui-scale / 100; font-weight: 700; }
                            Text { text: "Saved locally and restored when you reopen ResearchWeave."; color: Theme.muted-ink; wrap: word-wrap; }
                            Button {
                                text: Theme.dark-mode ? "Dark theme: on" : "Dark theme: off";
                                accessible-label: "Toggle dark theme";
                                clicked => { root.update-preference("dark-mode", !Theme.dark-mode); }
                            }
                            Text { text: Theme.dark-mode ? "Dark theme: on" : "Dark theme: off"; accessible-label: Theme.dark-mode ? "Dark theme: on" : "Dark theme: off"; color: Theme.ink; }
                            Button {
                                text: Theme.high-contrast ? "High contrast: on" : "High contrast: off";
                                accessible-label: "Toggle high contrast";
                                clicked => { root.update-preference("high-contrast", !Theme.high-contrast); }
                            }
                            Text { text: Theme.high-contrast ? "High contrast: on" : "High contrast: off"; accessible-label: Theme.high-contrast ? "High contrast: on" : "High contrast: off"; color: Theme.ink; }
                            Button {
                                text: Theme.compact-density ? "Compact density: on" : "Compact density: off";
                                accessible-label: Theme.compact-density ? "Compact density: on" : "Compact density: off";
                                clicked => { root.update-preference("compact-density", !Theme.compact-density); }
                            }
                            Text { text: "Interface text scale: " + Theme.ui-scale + "%"; accessible-label: "Interface text scale: " + Theme.ui-scale + "%"; color: Theme.ink; }
                            HorizontalLayout {
                                spacing: Theme.space3;
                                Button { text: "Smaller"; accessible-label: "Decrease interface scale"; enabled: Theme.ui-scale > 80; accessible-enabled: Theme.ui-scale > 80; clicked => { root.update-ui-scale(Theme.ui-scale - 10); } }
                                Button { text: "Larger"; accessible-label: "Increase interface scale"; enabled: Theme.ui-scale < 200; accessible-enabled: Theme.ui-scale < 200; clicked => { root.update-ui-scale(Theme.ui-scale + 10); } }
                                Button { text: "Reset scale"; accessible-label: "Reset interface scale"; clicked => { root.update-ui-scale(100); } }
                            }
                            Button {
                                text: Theme.reduced-motion ? "Reduced motion: on" : "Reduced motion: off";
                                accessible-label: "Toggle reduced motion";
                                clicked => { root.update-preference("reduced-motion", !Theme.reduced-motion); }
                            }
                            Rectangle { vertical-stretch: 1; }
                          }
                        }
                    }

                    if root.page == 28: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Text { text: "Project backups"; color: Theme.ink; font-size: 24px * Theme.ui-scale / 100; font-weight: 700; }
                            Text {
                                text: "Portable archives are verified before completion. Encrypted archives use scrypt + AES-256-GCM and never save the password.";
                                color: Theme.muted-ink;
                                wrap: word-wrap;
                            }
                            backup-path := LineEdit {
                                placeholder-text: "Absolute path ending in .rwproj or .rwproj.enc";
                                accessible-label: "Backup archive path";
                            }
                            backup-password := LineEdit {
                                placeholder-text: "Encryption password";
                                input-type: password;
                                accessible-label: "Backup encryption password";
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Button {
                                    text: "Export portable";
                                    accessible-label: "Export portable project archive";
                                    enabled: !root.backup-busy && !root.recovery-busy;
                                    accessible-enabled: !root.backup-busy && !root.recovery-busy;
                                    clicked => { root.backup-action("export", backup-path.text, ""); }
                                }
                                Button {
                                    text: "Export encrypted";
                                    accessible-label: "Export encrypted project archive";
                                    enabled: !root.backup-busy && !root.recovery-busy;
                                    accessible-enabled: !root.backup-busy && !root.recovery-busy;
                                    clicked => { root.backup-action("export-encrypted", backup-path.text, backup-password.text); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Button {
                                    text: "Verify portable";
                                    accessible-label: "Verify portable project archive";
                                    enabled: !root.backup-busy && !root.recovery-busy;
                                    accessible-enabled: !root.backup-busy && !root.recovery-busy;
                                    clicked => { root.backup-action("verify", backup-path.text, ""); }
                                }
                                Button {
                                    text: "Verify encrypted";
                                    accessible-label: "Verify encrypted project archive";
                                    enabled: !root.backup-busy && !root.recovery-busy;
                                    accessible-enabled: !root.backup-busy && !root.recovery-busy;
                                    clicked => { root.backup-action("verify-encrypted", backup-path.text, backup-password.text); }
                                }
                            }
                            Text { text: root.backup-results; color: Theme.ink; wrap: word-wrap; accessible-label: "Backup result"; accessible-live-region: polite; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }

                    if root.page == 29: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Text { text: "Recovery"; color: Theme.ink; font-size: 24px * Theme.ui-scale / 100; font-weight: 700; }
                            Text {
                                text: "Recovery validates the archive first and restores only into a new absolute directory.";
                                color: Theme.muted-ink;
                                wrap: word-wrap;
                            }
                            recovery-archive := LineEdit {
                                placeholder-text: "Absolute .rwproj or .rwproj.enc archive path";
                                accessible-label: "Recovery archive path";
                            }
                            recovery-destination := LineEdit {
                                placeholder-text: "New absolute project directory";
                                accessible-label: "Recovery destination path";
                            }
                            recovery-password := LineEdit {
                                placeholder-text: "Encryption password for encrypted archives";
                                input-type: password;
                                accessible-label: "Recovery encryption password";
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Button {
                                    text: "Restore portable";
                                    accessible-label: "Restore portable project archive";
                                    enabled: !root.backup-busy && !root.recovery-busy;
                                    accessible-enabled: !root.backup-busy && !root.recovery-busy;
                                    clicked => { root.restore-backup(false, recovery-archive.text, recovery-destination.text, ""); }
                                }
                                Button {
                                    text: "Restore encrypted";
                                    accessible-label: "Restore encrypted project archive";
                                    enabled: !root.backup-busy && !root.recovery-busy;
                                    accessible-enabled: !root.backup-busy && !root.recovery-busy;
                                    clicked => { root.restore-backup(true, recovery-archive.text, recovery-destination.text, recovery-password.text); }
                                }
                            }
                            Text { text: root.recovery-results; color: Theme.ink; wrap: word-wrap; accessible-label: "Recovery result"; accessible-live-region: polite; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }

                    if root.page == 2: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 10px;
                            Text { text: "Research question"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                            Text { text: root.research-summary; wrap: word-wrap; color: Theme.ink; accessible-label: "Recorded research metadata"; }
                            Button { text: "Refresh from project"; accessible-label: "Refresh project research metadata"; clicked => { root.refresh-research(); } }
                            Text { text: "Structured question document · EXPLORATORY framework"; color: Theme.muted-ink; font-size: 11px * Theme.ui-scale / 100; }
                            question-text := TextEdit { accessible-label: "Structured research question"; text: ""; }
                            HorizontalLayout {
                                spacing: 8px;
                                question-topic := LineEdit { placeholder-text: "Topic"; accessible-label: "Question topic"; }
                                question-population := LineEdit { placeholder-text: "Population"; accessible-label: "Question population"; }
                                question-author := LineEdit { placeholder-text: "Author"; accessible-label: "Question author"; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Preview";
                                    accessible-label: "Preview structured question";
                                    clicked => { root.preview-question(question-text.text, question-topic.text, question-population.text, question-author.text); }
                                }
                                Button {
                                    text: "Record previewed question";
                                    accessible-label: "Record previewed structured question";
                                    clicked => { root.apply-evidence-preview(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                question-id := LineEdit { placeholder-text: "Question ID for history"; accessible-label: "Question history ID"; }
                                Button { text: "Load history"; accessible-label: "Load question history"; clicked => { root.load-question-history(question-id.text); } }
                            }
                            Text { text: root.question-results; color: Theme.ink; wrap: word-wrap; accessible-label: "Question operation result"; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.page == 4: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                          VerticalLayout {
                            padding: 24px;
                            spacing: 10px;
                            Text { text: "Research protocol"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                            Text { text: "Create or amend a versioned protocol through the shared approval and audit path. Preview the persisted Markdown before explicitly saving to disk without overwrite."; color: Theme.muted-ink; wrap: word-wrap; }
                            protocol-title := LineEdit { placeholder-text: "Protocol title"; accessible-label: "Protocol title"; }
                            HorizontalLayout {
                                spacing: 8px;
                                protocol-design := LineEdit { placeholder-text: "Design: observational, experimental, qualitative, mixed…"; accessible-label: "Protocol design"; }
                                protocol-author := LineEdit { placeholder-text: "Author"; accessible-label: "Protocol author"; }
                            }
                            protocol-objective := TextEdit { accessible-label: "Protocol objective"; text: ""; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Preview";
                                    accessible-label: "Preview protocol";
                                    clicked => { root.preview-protocol(protocol-title.text, protocol-design.text, protocol-objective.text, protocol-author.text); }
                                }
                                Button {
                                    text: "Record previewed protocol";
                                    accessible-label: "Record previewed protocol";
                                    clicked => { root.apply-evidence-preview(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                protocol-id := LineEdit {
                                    text: root.protocol-export-id;
                                    edited => { root.protocol-export-id = self.text; }
                                    placeholder-text: "Existing protocol ID for history/amendment/export";
                                    accessible-label: "Protocol history ID";
                                }
                                Button { text: "Load history"; accessible-label: "Load protocol history"; clicked => { root.load-protocol-history(protocol-id.text); } }
                                Button { text: "View Markdown export"; accessible-label: "View protocol Markdown export"; clicked => { root.load-protocol-export(protocol-id.text); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                protocol-save-path := LineEdit {
                                    horizontal-stretch: 1;
                                    accessible-label: "Protocol Markdown destination path";
                                    placeholder-text: "Absolute path including .md extension";
                                }
                                Button {
                                    text: "Save protocol Markdown";
                                    accessible-label: "Save prepared protocol Markdown without overwrite";
                                    clicked => { root.save-prepared-export(protocol-save-path.text, "protocol.export"); }
                                }
                            }
                            Text { text: "The explicit save is approval-audited, checks the source revision and SHA-256, never overwrites an existing file, and does not upload anything."; color: Theme.muted-ink; wrap: word-wrap; }
                            Text {
                                text: root.protocol-export-receipt;
                                visible: root.protocol-export-receipt != "";
                                color: Theme.ink;
                                wrap: word-wrap;
                                accessible-label: root.protocol-export-receipt;
                            }
                            protocol-rationale := LineEdit { placeholder-text: "Amendment rationale (required for amendments)"; accessible-label: "Protocol amendment rationale"; }
                            Button {
                                text: "Preview amendment";
                                accessible-label: "Preview protocol amendment";
                                clicked => { root.preview-protocol-amend(protocol-id.text, protocol-design.text, protocol-objective.text, protocol-author.text, protocol-rationale.text); }
                            }
                            Text { text: "Amendments preserve all existing protocol-body fields, changing only nonempty design/objective inputs. A blank input keeps its previous value. Preview before recording; all earlier versions remain available."; color: Theme.muted-ink; wrap: word-wrap; }
                            Text { text: root.protocol-results; color: Theme.ink; wrap: word-wrap; accessible-label: "Protocol operation result"; }
                            Rectangle { vertical-stretch: 1; }
                          }
                        }
                    }
                    if root.page == 20: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 9px;
                            Text { text: "References"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                            Text { text: "Register a lossless bibliography record through the project-scoped command path."; color: Theme.muted-ink; wrap: word-wrap; }
                            reference-title := LineEdit { placeholder-text: "Reference title"; accessible-label: "Reference title"; }
                            reference-authors := LineEdit { placeholder-text: "Authors separated by commas"; accessible-label: "Reference authors"; }
                            HorizontalLayout {
                                spacing: 8px;
                                reference-year := LineEdit { placeholder-text: "Year (optional)"; accessible-label: "Reference year"; }
                                reference-doi := LineEdit { placeholder-text: "DOI (optional)"; accessible-label: "Reference DOI"; }
                                reference-kind := LineEdit { placeholder-text: "Kind, e.g. article"; accessible-label: "Reference kind"; }
                                reference-format := LineEdit { placeholder-text: "Format: bibtex, ris, csl-json"; accessible-label: "Reference format"; }
                            }
                            reference-raw := TextEdit { accessible-label: "Raw reference record"; text: ""; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Preview registration";
                                    accessible-label: "Preview reference registration";
                                    clicked => { root.preview-reference(reference-title.text, reference-authors.text, reference-year.text, reference-doi.text, reference-kind.text, reference-format.text, reference-raw.text); }
                                }
                                Button {
                                    text: "Register previewed reference";
                                    accessible-label: "Register previewed reference";
                                    clicked => { root.apply-library-preview(); }
                                }
                                Button { text: "Refresh references"; accessible-label: "Refresh project references"; clicked => { root.refresh-references(); } }
                            }
                            Text { text: root.reference-results; accessible-label: "Reference operation result " + root.reference-results; wrap: word-wrap; color: Theme.ink; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.page == 21: Rectangle {
                        background: Theme.canvas;
                        VerticalLayout {
                            padding: Theme.space5;
                            spacing: Theme.space3;
                            HorizontalLayout {
                                spacing: Theme.space3;
                                Text {
                                    text: root.show-research-notebook ? "Research notebook" : "Notes";
                                    font-size: 24px * Theme.ui-scale / 100;
                                    color: Theme.ink;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: root.show-research-notebook ? "Back to notes" : "Research notebook";
                                    accessible-label: "Switch between quick notes and revisioned research notebook";
                                    clicked => { root.navigate-quick-notes("toggle-notebook"); }
                                }
                            }
                            if !root.show-research-notebook: VerticalLayout {
                                spacing: Theme.space3;
                                if root.quick-note-recovery-count > 0: Rectangle {
                                    background: Theme.surface;
                                    border-color: Theme.warning;
                                    border-width: 1px;
                                    border-radius: Theme.panel-radius;
                                    min-height: 172px;
                                    preferred-height: 236px;
                                    max-height: 300px;
                                    VerticalLayout {
                                        padding: Theme.space3;
                                        spacing: Theme.space2;
                                        HorizontalLayout {
                                            spacing: Theme.space2;
                                            Text {
                                                text: "Unsaved note conflict · " + root.quick-note-recovery-count + " recoverable draft(s)";
                                                color: Theme.ink;
                                                font-weight: 700;
                                                wrap: word-wrap;
                                                horizontal-stretch: 1;
                                                accessible-label: "Recoverable conflicting Quick Note drafts " + root.quick-note-recovery-count;
                                            }
                                            Button {
                                                text: "Refresh";
                                                accessible-label: "Recheck Quick Note recovery drafts";
                                                clicked => { root.refresh-quick-note-recovery(); }
                                            }
                                        }
                                        Text {
                                            text: "A newer saved version exists. Inspect this older draft, then choose whether to make a separate copy. The newer note will stay unchanged.";
                                            color: Theme.muted-ink;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Theme.space2;
                                            Button {
                                                text: "Previous";
                                                enabled: root.quick-note-recovery-index > 1;
                                                accessible-enabled: root.quick-note-recovery-index > 1;
                                                accessible-label: "Inspect previous conflicting note draft";
                                                clicked => { root.navigate-quick-note-recovery("previous"); }
                                            }
                                            Text {
                                                text: "Draft " + root.quick-note-recovery-index + " of " + root.quick-note-recovery-count;
                                                color: Theme.ink;
                                                vertical-alignment: center;
                                                accessible-label: "Selected recovery draft " + root.quick-note-recovery-index + " of " + root.quick-note-recovery-count;
                                            }
                                            Button {
                                                text: "Next";
                                                enabled: root.quick-note-recovery-index < root.quick-note-recovery-count;
                                                accessible-enabled: root.quick-note-recovery-index < root.quick-note-recovery-count;
                                                accessible-label: "Inspect next conflicting note draft";
                                                clicked => { root.navigate-quick-note-recovery("next"); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Button {
                                                text: "Recover as new note copy";
                                                primary: true;
                                                accessible-label: "Recover inspected draft as a separate new Quick Note without changing the newer saved original";
                                                clicked => { root.recover-quick-note-as-copy(); }
                                            }
                                        }
                                        Text {
                                            text: "Draft title: " + root.quick-note-recovery-title;
                                            color: Theme.ink;
                                            wrap: word-wrap;
                                            accessible-label: "Staged recovery title " + root.quick-note-recovery-title;
                                        }
                                        Text {
                                            text: "Draft labels: " + root.quick-note-recovery-labels + " · " + root.quick-note-recovery-source;
                                            color: Theme.muted-ink;
                                            wrap: word-wrap;
                                            accessible-label: "Staged recovery labels and revision " + root.quick-note-recovery-labels + " " + root.quick-note-recovery-source;
                                        }
                                        TextEdit {
                                            text: root.quick-note-recovery-body;
                                            read-only: true;
                                            accessible-label: "Exact recovered Quick Note draft body, selectable and read-only";
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;
                                            min-height: 40px;
                                        }
                                        Text {
                                            text: root.quick-note-recovery-status;
                                            color: Theme.muted-ink;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Theme.space2;
                                    Button {
                                        text: "+ New note";
                                        accessible-label: "Create a new quick note in the open project";
                                        clicked => { root.create-quick-note(); }
                                    }
                                    quick-note-search-field := LineEdit {
                                        placeholder-text: "Search notes and labels";
                                        horizontal-stretch: 1;
                                        text: root.quick-note-search;
                                        accessible-label: "Search quick notes";
                                        edited(value) => {
                                            root.quick-note-search = value;
                                            root.refresh-quick-notes(value, root.quick-note-view);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Theme.space2;
                                    Button {
                                        text: "Notes";
                                        accessible-label: "Show active quick notes";
                                        enabled: root.quick-note-view != 0;
                                        accessible-enabled: root.quick-note-view != 0;
                                        clicked => { root.navigate-quick-notes("active"); }
                                    }
                                    Button {
                                        text: "Archive";
                                        accessible-label: "Show archived quick notes";
                                        enabled: root.quick-note-view != 1;
                                        accessible-enabled: root.quick-note-view != 1;
                                        clicked => { root.navigate-quick-notes("archived"); }
                                    }
                                    Button {
                                        text: "Trash";
                                        accessible-label: "Show recoverable trashed quick notes";
                                        enabled: root.quick-note-view != 2;
                                        accessible-enabled: root.quick-note-view != 2;
                                        clicked => { root.navigate-quick-notes("trash"); }
                                    }
                                    Button {
                                        text: root.quick-note-grid ? "Open list view" : "Card view";
                                        accessible-label: root.quick-note-grid ? "Switch to list and expanded editor" : "Switch to multi-column note cards";
                                        clicked => { root.navigate-quick-notes("toggle-grid"); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.quick-note-status;
                                        color: Theme.muted-ink;
                                        font-size: 11px * Theme.ui-scale / 100;
                                        vertical-alignment: center;
                                        horizontal-stretch: 2;
                                        wrap: word-wrap;
                                    }
                                }
                                if root.quick-note-grid: Rectangle {
                                    background: Theme.surface;
                                    border-radius: Theme.panel-radius;
                                    vertical-stretch: 1;
                                    ScrollView {
                                        FlexboxLayout {
                                            padding: Theme.space3;
                                            spacing: Theme.space3;
                                            flex-direction: row;
                                            flex-wrap: wrap;
                                            alignment: start;
                                            if root.quick-notes.length == 0: Text {
                                                text: "No notes here yet. Create a quick note to begin.";
                                                color: Theme.muted-ink;
                                            }
                                            for note in root.quick-notes: Rectangle {
                                                min-width: 210px;
                                                preferred-width: 250px;
                                                max-width: 265px;
                                                min-height: 135px;
                                                preferred-height: 152px;
                                                max-height: 170px;
                                                background: Theme.raised;
                                                border-radius: Theme.panel-radius;
                                                border-width: 1px;
                                                border-color: note.pinned ? Theme.accent : Theme.divider;
                                                VerticalLayout {
                                                    padding: Theme.space3;
                                                    spacing: Theme.space2;
                                                    Button {
                                                        text: (note.pinned ? "● " : "") + (note.title == "" ? "Untitled" : note.title);
                                                        accessible-label: "Open quick note " + note.title + " for expanded editing";
                                                        max-height: 36px;
                                                        clicked => { root.select-quick-note(note.id); }
                                                    }
                                                    Text {
                                                        text: note.preview;
                                                        color: Theme.ink;
                                                        wrap: word-wrap;
                                                        overflow: elide;
                                                        min-height: 32px;
                                                        preferred-height: 48px;
                                                        max-height: 56px;
                                                        font-size: 12px * Theme.ui-scale / 100;
                                                    }
                                                    Text {
                                                        text: note.labels;
                                                        color: Theme.muted-ink;
                                                        font-size: 11px * Theme.ui-scale / 100;
                                                        overflow: elide;
                                                        max-height: 20px;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if !root.quick-note-grid: HorizontalLayout {
                                    spacing: Theme.space3;
                                    Rectangle {
                                        min-width: 190px;
                                        preferred-width: 255px;
                                        max-width: 320px;
                                        background: Theme.surface;
                                        border-radius: Theme.panel-radius;
                                        vertical-stretch: 1;
                                        accessible-role: list;
                                        accessible-label: "Quick notes in this project";
                                        ScrollView {
                                            VerticalLayout {
                                                padding: Theme.space2;
                                                spacing: Theme.space2;
                                                if root.quick-notes.length == 0: Text {
                                                    text: root.quick-note-view == 0 ? "No notes yet. Create your first note." : "No notes in this view.";
                                                    color: Theme.muted-ink;
                                                    wrap: word-wrap;
                                                }
                                                for note in root.quick-notes: Rectangle {
                                                    min-height: 132px;
                                                    preferred-height: 148px;
                                                    max-height: 148px;
                                                    vertical-stretch: 0;
                                                    background: root.quick-note-id == note.id ? Theme.accent-subtle : Theme.raised;
                                                    border-radius: Theme.panel-radius;
                                                    border-width: root.quick-note-id == note.id ? 2px : 1px;
                                                    border-color: root.quick-note-id == note.id ? Theme.accent : Theme.divider;
                                                    VerticalLayout {
                                                        padding: Theme.space2;
                                                        spacing: Theme.space1;
                                                        Button {
                                                            text: (note.pinned ? "● " : "") + (note.title == "" ? "Untitled" : note.title);
                                                            accessible-label: "Open note " + note.title;
                                                            min-height: 30px;
                                                            preferred-height: 30px;
                                                            max-height: 30px;
                                                            clicked => { root.select-quick-note(note.id); }
                                                        }
                                                        Text {
                                                            text: note.preview;
                                                            color: Theme.muted-ink;
                                                            max-height: 40px;
                                                            min-height: 26px;
                                                            preferred-height: 26px;
                                                            wrap: word-wrap;
                                                            overflow: elide;
                                                            font-size: 12px * Theme.ui-scale / 100;
                                                        }
                                                        Text {
                                                            text: note.labels;
                                                            color: Theme.muted-ink;
                                                            font-size: 11px * Theme.ui-scale / 100;
                                                            overflow: elide;
                                                            max-height: 18px;
                                                        }
                                                        HorizontalLayout {
                                                            spacing: Theme.space1;
                                                            min-height: 30px;
                                                            preferred-height: 30px;
                                                            max-height: 30px;
                                                            if root.quick-note-view != 2: Button {
                                                                text: note.pinned ? "Unpin" : "Pin";
                                                                accessible-label: note.pinned ? "Unpin note" : "Pin note";
                                                                max-height: 30px;
                                                                clicked => { root.quick-note-action("pin", note.id, note.revision); }
                                                            }
                                                            Button {
                                                                text: root.quick-note-view == 2 ? "Restore" : (root.quick-note-view == 1 ? "Unarchive" : "Archive");
                                                                accessible-label: (root.quick-note-view == 2 ? "Restore note " : (root.quick-note-view == 1 ? "Unarchive note " : "Archive note ")) + note.title;
                                                                max-height: 30px;
                                                                clicked => {
                                                                    root.quick-note-action(root.quick-note-view == 2 ? "restore" : (root.quick-note-view == 1 ? "unarchive" : "archive"), note.id, note.revision);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        background: Theme.surface;
                                        border-radius: Theme.panel-radius;
                                        horizontal-stretch: 1;
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            padding: Theme.space4;
                                            spacing: Theme.space3;
                                            if root.quick-note-id == "": Text {
                                                text: "Choose a note or create one to start writing.";
                                                color: Theme.muted-ink;
                                                wrap: word-wrap;
                                            }
                                            if root.quick-note-id != "": VerticalLayout {
                                                spacing: Theme.space3;
                                                LineEdit {
                                                    text: root.quick-note-title;
                                                    placeholder-text: "Title";
                                                    accessible-label: "Quick note title";
                                                    edited(value) => { root.quick-note-title = value; root.quick-note-draft-edited(root.quick-note-title, root.quick-note-body, root.quick-note-labels); }
                                                }
                                                LineEdit {
                                                    text: root.quick-note-labels;
                                                    placeholder-text: "Labels, separated by commas (optional)";
                                                    accessible-label: "Quick note labels";
                                                    edited(value) => { root.quick-note-labels = value; root.quick-note-draft-edited(root.quick-note-title, root.quick-note-body, root.quick-note-labels); }
                                                }
                                                TextEdit {
                                                    text: root.quick-note-body;
                                                    accessible-label: "Expanded quick note editor";
                                                    horizontal-stretch: 1;
                                                    vertical-stretch: 1;
                                                    min-height: 220px;
                                                    edited(value) => { root.quick-note-body = value; root.quick-note-draft-edited(root.quick-note-title, root.quick-note-body, root.quick-note-labels); }
                                                }
                                                HorizontalLayout {
                                                    spacing: Theme.space2;
                                                    Button { text: "Save now"; accessible-label: "Save note now"; clicked => { root.save-quick-note(); } }
                                                    Button {
                                                        text: "Move to trash";
                                                        accessible-label: "Move selected note to recoverable trash";
                                                        clicked => {
                                                            root.quick-note-action("delete", root.quick-note-id, root.quick-note-revision);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.show-research-notebook: VerticalLayout {
                                spacing: Theme.space3;
                                if root.writing-recovery-blocked: Text {
                                    text: "A writing recovery journal needs attention. Confirm the older draft belongs to this project's folder before adopting it.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                if root.writing-recovery-blocked: Button {
                                    text: "Adopt legacy writing draft into this project";
                                    accessible-label: "Confirm and adopt older writing recovery draft into the current project";
                                    clicked => { root.adopt-legacy-writing-draft(); }
                                }
                                if root.writing-recovery-blocked: Button {
                                    text: "Start fresh writing · preserve older draft";
                                    accessible-label: "Start an independent blank writing journal and preserve the older ambiguous draft";
                                    clicked => { root.start-fresh-writing-draft(); }
                                }
                                Text {
                                    text: "One versioned, source-aware notebook for your project. Edits are autosaved and recoverable.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                notebook-body := TextEdit {
                                    enabled: !root.writing-recovery-blocked;
                                    accessible-enabled: !root.writing-recovery-blocked;
                                    min-height: 270px;
                                    vertical-stretch: 1;
                                    accessible-label: "Revisioned research notebook text";
                                    text: root.notebook-draft;
                                    edited(text) => { root.notebook-draft = text; root.notebook-draft-edited(text); }
                                }
                                HorizontalLayout {
                                    spacing: Theme.space2;
                                    Button { text: "Preview revision"; accessible-label: "Preview notebook save"; clicked => { root.preview-notebook-save(notebook-body.text); } }
                                    Button { text: "Record revision"; accessible-label: "Record previewed notebook save"; clicked => { root.apply-evidence-preview(); } }
                                    Button { text: "History"; accessible-label: "Load notebook history"; clicked => { root.load-notebook-history(); } }
                                    Button { text: "Export Markdown"; accessible-label: "Export notebook Markdown"; clicked => { root.export-notebook(); } }
                                }
                                Text { text: root.notebook-results; accessible-label: "Notebook result"; wrap: word-wrap; color: Theme.muted-ink; }
                            }
                        }
                    }
                    if root.page == 9: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 9px;
                            Text { text: "Systematic review"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                            Text { text: "Register persisted references into a review, then record independent screening votes. Writes require Preview → Record."; color: Theme.muted-ink; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                review-id := LineEdit { placeholder-text: "Review ID"; accessible-label: "Review ID"; }
                                review-reference-id := LineEdit { placeholder-text: "Reference ID"; accessible-label: "Review reference ID"; }
                                Button { text: "Preview add record"; accessible-label: "Preview add review record"; clicked => { root.preview-review-record(review-id.text, review-reference-id.text); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                review-record-id := LineEdit { placeholder-text: "Review record ID"; accessible-label: "Review record ID"; }
                                review-reviewer := LineEdit { placeholder-text: "Reviewer"; accessible-label: "Review reviewer"; }
                                review-stage := LineEdit { placeholder-text: "Stage: title_abstract or full_text"; accessible-label: "Review stage"; }
                                review-decision := LineEdit { placeholder-text: "Decision: include, exclude, unsure"; accessible-label: "Review decision"; }
                            }
                            review-reason := LineEdit { placeholder-text: "Reason (required for exclusion)"; accessible-label: "Review decision reason"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "Preview vote";
                                    accessible-label: "Preview screening vote";
                                    clicked => { root.preview-review-screen(review-id.text, review-record-id.text, review-reviewer.text, review-stage.text, review-decision.text, review-reason.text); }
                                }
                                Button { text: "Record previewed action"; accessible-label: "Record previewed review action"; clicked => { root.apply-evidence-preview(); } }
                                Button { text: "Refresh review + PRISMA"; accessible-label: "Refresh review and PRISMA"; clicked => { root.refresh-review(review-id.text); } }
                                Button { text: "Load screening status"; accessible-label: "Load screening status"; clicked => { root.load-review-status(review-id.text, review-record-id.text, review-stage.text); } }
                            }
                            Text { text: root.review-results; accessible-label: "Review operation result " + root.review-results; wrap: word-wrap; color: Theme.ink; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.page == 10: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 10px;
                            Text { text: "PRISMA"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                            Text { text: "Counts are derived from persisted review/search/retrieval state. Incomplete accounting remains explicit."; color: Theme.muted-ink; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                prisma-review-id := LineEdit { placeholder-text: "Review ID"; accessible-label: "PRISMA review ID"; }
                                Button { text: "Refresh derived counts"; accessible-label: "Refresh PRISMA counts"; clicked => { root.refresh-review(prisma-review-id.text); } }
                            }
                            Text { text: root.review-results; accessible-label: "PRISMA result " + root.review-results; wrap: word-wrap; color: Theme.ink; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.page == 11: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 8px;
                            Text { text: "Extraction"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                            Text { text: "Schemas and values use the native typed JSON contract. Preview validates the complete payload without mutating the project."; color: Theme.muted-ink; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                extraction-form-name := LineEdit { placeholder-text: "Form name"; accessible-label: "Extraction form name"; }
                                extraction-author := LineEdit { placeholder-text: "Author"; accessible-label: "Extraction form author"; }
                                Button { text: "Preview new form"; accessible-label: "Preview extraction form creation"; clicked => { root.preview-extraction-form(extraction-form-name.text, extraction-author.text, extraction-fields.text); } }
                                Button { text: "Record previewed action"; accessible-label: "Record previewed extraction action"; clicked => { root.apply-evidence-preview(); } }
                            }
                            extraction-fields := TextEdit { accessible-label: "Extraction fields JSON"; text: ""; }
                            HorizontalLayout {
                                spacing: 8px;
                                extraction-form-id := LineEdit { placeholder-text: "Form ID"; accessible-label: "Extraction form ID"; }
                                extraction-rationale := LineEdit { placeholder-text: "Revision rationale"; accessible-label: "Extraction revision rationale"; }
                                Button { text: "History"; accessible-label: "Load extraction form history"; clicked => { root.load-extraction-history(extraction-form-id.text); } }
                                Button { text: "Values"; accessible-label: "Load extraction form values"; clicked => { root.load-extraction-values(extraction-form-id.text); } }
                            }
                            extraction-migration := LineEdit { placeholder-text: "Migration JSON object for revision, e.g. {\"old\":\"new\"}"; accessible-label: "Extraction migration JSON"; }
                            Button { text: "Preview form revision"; accessible-label: "Preview extraction form revision"; clicked => { root.preview-extraction-form-revision(extraction-form-id.text, extraction-author.text, extraction-rationale.text, extraction-fields.text, extraction-migration.text); } }
                            HorizontalLayout {
                                spacing: 8px;
                                extraction-record-id := LineEdit { placeholder-text: "Review record ID"; accessible-label: "Extraction review record ID"; }
                                extraction-reviewer := LineEdit { placeholder-text: "Reviewer"; accessible-label: "Extraction reviewer"; }
                            }
                            extraction-values := TextEdit { accessible-label: "Extraction values JSON"; text: ""; }
                            Button { text: "Preview values"; accessible-label: "Preview extraction values"; clicked => { root.preview-extraction-values(extraction-form-id.text, extraction-record-id.text, extraction-reviewer.text, extraction-values.text); } }
                            Text { text: root.extraction-results; accessible-label: "Extraction operation result " + root.extraction-results; wrap: word-wrap; color: Theme.ink; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.page == 12: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 12px;
                                Text { text: "Data view"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                                Text {
                                    text: "Import an immutable dataset, then inspect a specific revision. A preview does not change the project; Import records the file and source hash.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                Text { text: "1 · Choose a local data file"; color: Theme.ink; font-weight: 700; }
                                Text {
                                    text: "Supported: CSV, TSV, XLSX, ODS, Parquet, SPSS SAV/ZSAV and Stata DTA. Check file type and data privacy before importing.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    analysis-import-path := LineEdit {
                                        text <=> root.data-local-path;
                                        horizontal-stretch: 1;
                                        placeholder-text: "Absolute data file path";
                                        accessible-label: "Local dataset path to preview";
                                    }
                                    Button {
                                        text: "Browse data…";
                                        accessible-label: "Choose scientific dataset with native file picker";
                                        enabled: !root.local-file-dialog-busy;
                                        accessible-enabled: !root.local-file-dialog-busy;
                                        clicked => { root.choose-local-file("data"); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Preview import"; accessible-label: "Preview analysis import without modifying project"; clicked => { root.preview-analysis-import(analysis-import-path.text); } }
                                    Button { text: "Import previewed data"; accessible-label: "Record previewed immutable analysis dataset"; clicked => { root.apply-analysis-preview(); } }
                                }
                                Rectangle { height: 1px; background: Theme.divider; }
                                Text { text: "2 · Inspect an immutable dataset revision"; color: Theme.ink; font-weight: 700; }
                                Text {
                                    text: "Use the dataset ID and revision returned by Import. Inspection is read-only; it does not alter values or metadata.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    analysis-dataset-id := LineEdit {
                                        text <=> root.dataset-selected-id;
                                        placeholder-text: "Dataset ID";
                                        accessible-label: "Analysis dataset ID";
                                        edited(value) => { root.dataset-grid-ready = false; root.dataset-grid-status = "Inspect the selected dataset revision to see verified rows."; }
                                    }
                                    analysis-revision := LineEdit {
                                        text <=> root.dataset-selected-revision;
                                        placeholder-text: "Dataset revision";
                                        accessible-label: "Analysis dataset revision";
                                        edited(value) => { root.dataset-grid-ready = false; root.dataset-grid-status = "Inspect the selected dataset revision to see verified rows."; }
                                    }
                                    Button {
                                        text: "Inspect dataset";
                                        accessible-label: "Inspect dataset revision and request preview";
                                        clicked => { root.inspect-dataset(analysis-dataset-id.text, analysis-revision.text); }
                                    }
                                }
                                // Table and exact values share the first visible row. The
                                // earlier vertically stacked layout concealed one of them
                                // behind the native ScrollView viewport on some OSes.
                                HorizontalLayout {
                                    spacing: 12px;
                                Rectangle {
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.divider;
                                    border-radius: Theme.panel-radius;
                                    height: root.dataset-grid-ready ? 395px : 125px;
                                    horizontal-stretch: 2;
                                    min-width: 0px;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "Dataset row preview"; color: Theme.ink; font-weight: 700; }
                                        Text {
                                            text: root.dataset-grid-status;
                                            color: Theme.muted-ink;
                                            wrap: word-wrap;
                                            accessible-label: "Dataset grid status: " + root.dataset-grid-status;
                                            accessible-live-region: polite;
                                        }
                                        if root.dataset-grid-ready && root.dataset-grid-columns.length > 0: VerticalLayout {
                                            spacing: 8px;
                                            // Native Slint StandardTableView supplies header labels,
                                            // row keyboard navigation and a platform table role.
                                            StandardTableView {
                                                height: 260px;
                                                columns: root.dataset-grid-columns;
                                                rows: root.dataset-grid-rows;
                                                enabled: !root.dataset-grid-busy;
                                                accessible-enabled: !root.dataset-grid-busy;
                                                accessible-label: "Read-only dataset revision rows; inspect header names and row values";
                                                sort-ascending(column) => {
                                                    root.dataset-grid-status = "Sorting is not available in this preview. Row order is unchanged.";
                                                }
                                                sort-descending(column) => {
                                                    root.dataset-grid-status = "Sorting is not available in this preview. Row order is unchanged.";
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Button {
                                                    text: "Previous 25";
                                                    accessible-label: "Load previous verified dataset page";
                                                    enabled: !root.dataset-grid-busy && root.dataset-grid-page > 0;
                                                    accessible-enabled: !root.dataset-grid-busy && root.dataset-grid-page > 0;
                                                    clicked => {
                                                        root.request-dataset-page(analysis-dataset-id.text, analysis-revision.text, root.dataset-grid-page - 1, root.dataset-grid-page-size);
                                                    }
                                                }
                                                Text {
                                                    text: "Page " + (root.dataset-grid-page + 1) + " · " + root.dataset-grid-rows.length + " rows shown"
                                                        + (root.dataset-grid-total-rows >= 0 ? " of " + root.dataset-grid-total-rows : "");
                                                    color: Theme.ink;
                                                    horizontal-stretch: 1;
                                                    vertical-alignment: center;
                                                    accessible-label: "Dataset page " + (root.dataset-grid-page + 1) + " with " + root.dataset-grid-rows.length + " visible rows";
                                                }
                                                Button {
                                                    text: "Next 25";
                                                    accessible-label: "Load next verified dataset page";
                                                    enabled: !root.dataset-grid-busy &&
                                                        (root.dataset-grid-total-rows >= 0 ?
                                                        (root.dataset-grid-page + 1) * root.dataset-grid-page-size < root.dataset-grid-total-rows :
                                                        root.dataset-grid-rows.length == root.dataset-grid-page-size);
                                                    accessible-enabled: !root.dataset-grid-busy &&
                                                        (root.dataset-grid-total-rows >= 0 ?
                                                        (root.dataset-grid-page + 1) * root.dataset-grid-page-size < root.dataset-grid-total-rows :
                                                        root.dataset-grid-rows.length == root.dataset-grid-page-size);
                                                    clicked => {
                                                        root.request-dataset-page(analysis-dataset-id.text, analysis-revision.text, root.dataset-grid-page + 1, root.dataset-grid-page-size);
                                                    }
                                                }
                                            }
                                        }
                                        if !root.dataset-grid-ready || root.dataset-grid-columns.length == 0: Text {
                                            text: "No structured rows loaded. Inspect the dataset above. This table remains empty until the Rust host supplies verified column labels and rows; no demonstration values are substituted.";
                                            color: Theme.muted-ink;
                                            wrap: word-wrap;
                                            accessible-label: "Dataset preview empty; load a verified revision";
                                        }
                                    }
                                }
                                Rectangle {
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.divider;
                                    border-radius: Theme.panel-radius;
                                    height: root.dataset-grid-ready ? 395px : 125px;
                                    horizontal-stretch: 1;
                                    min-width: 200px;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        Text {
                                            text: "Complete current-page values · select and copy";
                                            color: Theme.ink;
                                            font-weight: 700;
                                            wrap: word-wrap;
                                        }
                                        TextEdit {
                                            text: root.analysis-results;
                                            read-only: true;
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;
                                            min-height: 85px;
                                            accessible-label: "Verified current dataset page JSON; select and copy complete values including shortened table cells";
                                        }
                                    }
                                }
                                }
                                Text {
                                    text: "To change variable labels or declare missing values, open Variable View. That action creates a new immutable revision rather than editing these rows in place.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    if root.page == 13: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 10px;
                                Text { text: "Variable view"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                                Text {
                                    text: "Inspect the immutable variable dictionary, missingness and quality checks. Metadata edits create a new dataset revision; the original revision remains unchanged.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    variable-dataset-id := LineEdit { placeholder-text: "Dataset ID"; accessible-label: "Variable View dataset ID"; }
                                    variable-revision := LineEdit { placeholder-text: "Dataset revision"; accessible-label: "Variable View dataset revision"; }
                                    Button { text: "Inspect variables"; accessible-label: "Inspect variable metadata and quality"; clicked => { root.inspect-variable-view(variable-dataset-id.text, variable-revision.text); } }
                                }
                                Rectangle {
                                    min-height: 64px;
                                    preferred-height: 72px;
                                    background: Theme.surface;
                                    border-color: Theme.divider;
                                    border-width: 1px;
                                    border-radius: Theme.panel-radius;
                                    ScrollView {
                                        VerticalLayout {
                                            padding: 8px;
                                            Text { text: root.variable-results; accessible-label: "Variable View operation result " + root.variable-results; wrap: word-wrap; color: Theme.ink; }
                                        }
                                    }
                                }
                                Text { text: "Create metadata revision"; color: Theme.ink; font-size: 14px * Theme.ui-scale / 100; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    variable-column := LineEdit { placeholder-text: "Column name"; accessible-label: "Variable View column name"; }
                                    variable-updates := LineEdit {
                                        accessible-label: "Variable View metadata updates JSON";
                                        text: "{\"label\":\"\",\"scale\":\"unknown\",\"privacy_class\":\"internal\"}";
                                    }
                                    Button { text: "Preview metadata revision"; accessible-label: "Preview variable metadata revision"; clicked => { root.preview-variable-update(variable-dataset-id.text, variable-revision.text, variable-column.text, variable-updates.text); } }
                                    Button { text: "Record previewed revision"; accessible-label: "Record previewed variable metadata revision"; clicked => { root.apply-analysis-command-preview(); } }
                                }
                                Text {
                                    text: "Allowed metadata keys: label, units, scale, value_labels, missing_values, category_order, allowed_min, allowed_max, privacy_class, private, dtype.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                    if root.page == 14: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 12px;
                                Text { text: "Statistics"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                                Text {
                                    text: "Choose one method, provide a dataset identity and columns, then review the estimate, sample coverage and uncertainty. A statistical result does not establish a causal explanation or validate a study design.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                Text { text: "1 · Dataset and revision (required for every method)"; color: Theme.ink; font-weight: 700; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    stats-dataset-id := LineEdit { min-width: 0px; preferred-width: root.width < 950px ? 295px : 380px; max-width: root.width < 950px ? 305px : 760px; horizontal-stretch: 1; placeholder-text: "Dataset ID"; accessible-label: "Statistics dataset ID"; }
                                    stats-revision := LineEdit { min-width: 0px; preferred-width: root.width < 950px ? 295px : 380px; max-width: root.width < 950px ? 305px : 760px; horizontal-stretch: 1; placeholder-text: "Dataset revision"; accessible-label: "Statistics dataset revision"; }
                                }
                                Text {
                                    text: "Use the immutable dataset ID and exact revision returned by Data View. Results never overwrite source values. To understand missing data and variable units, inspect Variable View first.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }

                                Rectangle { height: 1px; background: Theme.divider; }
                                Text { text: "2 · Choose a method"; color: Theme.ink; font-weight: 700; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { min-width: 0px; preferred-width: root.width < 950px ? 205px : 250px; max-width: root.width < 950px ? 205px : 400px; horizontal-stretch: 1; text: root.statistics-mode == 0 ? "› Descriptives" : "Descriptives"; accessible-label: "Show descriptive statistics form"; clicked => { root.statistics-mode = 0; } }
                                    Button { min-width: 0px; preferred-width: root.width < 950px ? 205px : 250px; max-width: root.width < 950px ? 205px : 400px; horizontal-stretch: 1; text: root.statistics-mode == 1 ? "› Frequency" : "Frequency"; accessible-label: "Show frequency table form"; clicked => { root.statistics-mode = 1; } }
                                    Button { min-width: 0px; preferred-width: root.width < 950px ? 205px : 250px; max-width: root.width < 950px ? 205px : 400px; horizontal-stretch: 1; text: root.statistics-mode == 2 ? "› Correlation" : "Correlation"; accessible-label: "Show correlation form"; clicked => { root.statistics-mode = 2; } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { min-width: 0px; preferred-width: root.width < 950px ? 300px : 360px; max-width: root.width < 950px ? 300px : 500px; horizontal-stretch: 1; text: root.statistics-mode == 3 ? "› Welch t" : "Welch t"; accessible-label: "Show Welch t test form"; clicked => { root.statistics-mode = 3; } }
                                    Button { min-width: 0px; preferred-width: root.width < 950px ? 300px : 360px; max-width: root.width < 950px ? 300px : 500px; horizontal-stretch: 1; text: root.statistics-mode == 4 ? "› Linear model" : "Linear model"; accessible-label: "Show linear model form"; clicked => { root.statistics-mode = 4; } }
                                }

                                if root.statistics-mode == 0: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Descriptive statistics"; color: Theme.ink; font-weight: 700; }
                                    Text { text: "Summarize one numeric column. Mean measures average; median is the middle value; sample SD describes spread. Inspect valid n, missing n and observed range before interpreting the average."; color: Theme.muted-ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-column := LineEdit { min-width: 0px; horizontal-stretch: 1; placeholder-text: "Numeric column"; accessible-label: "Statistics numeric column"; }
                                        Button { min-width: 0px; horizontal-stretch: 0; text: "Run descriptives"; accessible-label: "Run descriptive statistics"; clicked => { root.run-descriptives(stats-dataset-id.text, stats-revision.text, stats-column.text); } }
                                    }
                                }
                                if root.statistics-mode == 1: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Frequency table"; color: Theme.ink; font-weight: 700; }
                                    Text { text: "Count observed category levels. A valid percentage excludes missing responses from its denominator; inspect missing counts and sample selection before comparing groups."; color: Theme.muted-ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-frequency-column := LineEdit { min-width: 0px; horizontal-stretch: 1; placeholder-text: "Categorical column"; accessible-label: "Statistics frequency column"; }
                                        Button { min-width: 0px; horizontal-stretch: 0; text: "Run frequency"; accessible-label: "Run frequency table"; clicked => { root.run-frequency(stats-dataset-id.text, stats-revision.text, stats-frequency-column.text); } }
                                    }
                                }
                                if root.statistics-mode == 2: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Pearson correlation"; color: Theme.ink; font-weight: 700; }
                                    Text { text: "Estimate linear association between two numeric columns using complete pairs. r describes direction/strength, not causation. Review n, unusual points, independence and p-value assumptions."; color: Theme.muted-ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-correlation-x := LineEdit { min-width: 0px; horizontal-stretch: 1; placeholder-text: "X column"; accessible-label: "Statistics correlation X column"; }
                                        stats-correlation-y := LineEdit { min-width: 0px; horizontal-stretch: 1; placeholder-text: "Y column"; accessible-label: "Statistics correlation Y column"; }
                                        Button { min-width: 0px; horizontal-stretch: 0; text: "Run Pearson r"; accessible-label: "Run Pearson correlation"; clicked => { root.run-correlation(stats-dataset-id.text, stats-revision.text, stats-correlation-x.text, stats-correlation-y.text); } }
                                    }
                                }
                                if root.statistics-mode == 3: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Welch two-group t test"; color: Theme.ink; font-weight: 700; }
                                    Text { text: "Compare means of two explicitly named groups; unequal group variances are allowed. Other levels are excluded with a warning. Read the mean difference, degrees of freedom and interval, if present, with sample sizes and design assumptions."; color: Theme.muted-ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-test-outcome := LineEdit { min-width: 0px; horizontal-stretch: 1; placeholder-text: "Outcome"; accessible-label: "Statistics t test outcome column"; }
                                        stats-test-group := LineEdit { min-width: 0px; horizontal-stretch: 1; placeholder-text: "Group column"; accessible-label: "Statistics t test group column"; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-test-first := LineEdit { min-width: 0px; horizontal-stretch: 1; placeholder-text: "First group"; accessible-label: "Statistics t test first group"; }
                                        stats-test-second := LineEdit { min-width: 0px; horizontal-stretch: 1; placeholder-text: "Second group"; accessible-label: "Statistics t test second group"; }
                                        Button { min-width: 0px; horizontal-stretch: 0; text: "Run Welch t"; accessible-label: "Run Welch t test"; clicked => { root.run-t-test(stats-dataset-id.text, stats-revision.text, stats-test-outcome.text, stats-test-group.text, stats-test-first.text, stats-test-second.text); } }
                                    }
                                }
                                if root.statistics-mode == 4: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Linear model"; color: Theme.ink; font-weight: 700; }
                                    Text { text: "Ordinary least squares (OLS) with HC3 robust standard errors. Enter predictors separated by commas. R² is model fit, not predictive validity; check residuals, sample size, assumptions and coefficient uncertainty in the payload."; color: Theme.muted-ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-model-outcome := LineEdit { min-width: 0px; horizontal-stretch: 1; placeholder-text: "Outcome"; accessible-label: "Statistics linear model outcome"; }
                                        stats-model-predictors := LineEdit { min-width: 0px; horizontal-stretch: 1; placeholder-text: "Predictors, comma-separated"; accessible-label: "Statistics linear model predictors"; }
                                        Button { min-width: 0px; horizontal-stretch: 0; text: "Fit OLS"; accessible-label: "Run linear model with HC3 covariance"; clicked => { root.run-linear-model(stats-dataset-id.text, stats-revision.text, stats-model-outcome.text, stats-model-predictors.text); } }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.divider; }
                                Text { text: "3 · Review the latest statistics attempt"; color: Theme.ink; font-weight: 700; }
                                Text {
                                    text: "The summary below belongs to the latest statistics attempt, including errors. Switching method tabs does not recalculate or replace it.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                Rectangle {
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.divider;
                                    border-radius: Theme.panel-radius;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 9px;
                                        Text {
                                            text: root.statistics-result-title;
                                            accessible-label: "Latest statistics result title: " + root.statistics-result-title;
                                            color: Theme.ink;
                                            font-size: 18px * Theme.ui-scale / 100;
                                            font-weight: 700;
                                        }
                                        Text { text: "Estimate or main summary"; color: Theme.muted-ink; font-weight: 600; }
                                        Text {
                                            text: root.statistics-result-primary;
                                            accessible-label: "Latest statistics estimate: " + root.statistics-result-primary;
                                            color: Theme.ink;
                                            font-size: 16px * Theme.ui-scale / 100;
                                            font-weight: 700;
                                            wrap: word-wrap;
                                            accessible-live-region: polite;
                                        }
                                        if root.statistics-result-secondary != "": Text {
                                            text: "Sample coverage, details and cautions";
                                            color: Theme.muted-ink;
                                            font-weight: 600;
                                        }
                                        if root.statistics-result-secondary != "": Text {
                                            text: root.statistics-result-secondary;
                                            accessible-label: "Latest statistics sample and details: " + root.statistics-result-secondary;
                                            color: Theme.ink;
                                            wrap: word-wrap;
                                        }
                                        if root.statistics-result-provenance != "": Text {
                                            text: "Source and revision";
                                            color: Theme.muted-ink;
                                            font-weight: 600;
                                        }
                                        if root.statistics-result-provenance != "": Text {
                                            text: root.statistics-result-provenance;
                                            accessible-label: "Latest statistics provenance: " + root.statistics-result-provenance;
                                            color: Theme.ink;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                Rectangle {
                                    background: Theme.accent-subtle;
                                    border-radius: Theme.panel-radius;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 6px;
                                        Text { text: "How much uncertainty?"; color: Theme.ink; font-weight: 700; }
                                        Text {
                                            text: "An estimate summarizes this sample; it does not establish certainty. Check valid/complete n and missingness; for inferential methods, inspect intervals, p-values, effect size, diagnostic warnings and assumptions in the verified payload. If an interval is not reported, do not assume one.";
                                            color: Theme.ink;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "A small p-value alone cannot prove importance, causation or replicability. Do not invent confidence intervals or substitute the displayed summary for a scientific review.";
                                            color: Theme.ink;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                Text { text: "Analysis operation details · read-only"; color: Theme.ink; font-weight: 700; }
                                Rectangle {
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.divider;
                                    border-radius: Theme.panel-radius;
                                    min-height: 100px;
                                    preferred-height: 190px;
                                    ScrollView {
                                        VerticalLayout {
                                            padding: 10px;
                                            Text {
                                                text: root.analysis-results;
                                                accessible-label: "Latest analysis operation details, which may include dataset inspection or statistics: " + root.analysis-results;
                                                wrap: word-wrap;
                                                color: Theme.ink;
                                                font-size: 12px * Theme.ui-scale / 100;
                                            }
                                        }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                    if root.page == 15: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 10px;
                                Text { text: "Analysis results"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                                Text {
                                    text: "Persist a recomputed statistical result against an immutable dataset revision, reload it by SHA-256 result ID, export a deterministic replay script, or compose verified results into a deterministic Markdown report.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        min-height: 150px;
                                        background: Theme.surface;
                                        border-color: Theme.divider;
                                        border-width: 1px;
                                        border-radius: Theme.panel-radius;
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 6px;
                                            Text { text: "Persist result"; color: Theme.ink; font-size: 14px * Theme.ui-scale / 100; font-weight: 600; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                result-dataset-id := LineEdit { placeholder-text: "Dataset ID"; accessible-label: "Analysis Results dataset ID"; }
                                                result-revision := LineEdit { placeholder-text: "Dataset revision"; accessible-label: "Analysis Results dataset revision"; }
                                            }
                                            result-column := LineEdit { placeholder-text: "Numeric column"; accessible-label: "Analysis Results numeric column"; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Button { text: "Preview"; accessible-label: "Preview immutable analysis result"; clicked => { root.preview-analysis-result-save(result-dataset-id.text, result-revision.text, result-column.text); } }
                                                Button { text: "Record"; accessible-label: "Record previewed immutable analysis result"; clicked => { root.apply-analysis-command-preview(); } }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        min-height: 150px;
                                        background: Theme.surface;
                                        border-color: Theme.divider;
                                        border-width: 1px;
                                        border-radius: Theme.panel-radius;
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 6px;
                                            Text { text: "Inspect, replay & report"; color: Theme.ink; font-size: 14px * Theme.ui-scale / 100; font-weight: 600; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                result-id := LineEdit { placeholder-text: "Result ID"; accessible-label: "Analysis Results result ID"; }
                                                Button { text: "Load"; accessible-label: "Load verified analysis result"; clicked => { root.load-analysis-result(result-id.text); } }
                                                Button { text: "Replay"; accessible-label: "Export analysis replay script"; clicked => { root.export-analysis-script(result-id.text); } }
                                            }
                                            report-title := LineEdit { text: "Analysis report"; placeholder-text: "Report title"; accessible-label: "Analysis report title"; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                report-result-ids := LineEdit { placeholder-text: "Comma-separated result IDs"; accessible-label: "Analysis report result IDs"; }
                                                Button { text: "Render report"; accessible-label: "Render verified analysis report"; clicked => { root.render-analysis-report(report-title.text, report-result-ids.text); } }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    min-height: 90px;
                                    preferred-height: 110px;
                                    background: Theme.surface;
                                    border-color: Theme.divider;
                                    border-width: 1px;
                                    border-radius: Theme.panel-radius;
                                    ScrollView {
                                        VerticalLayout {
                                            padding: 8px;
                                            Text { text: root.analysis-report-results; accessible-label: "Analysis Results operation result " + root.analysis-report-results; wrap: word-wrap; color: Theme.ink; }
                                        }
                                    }
                                }
                                Text {
                                    text: "Reports reproduce stored outputs and provenance only. ResearchWeave does not generate causal or scientific interpretation here.";
                                    color: Theme.warning;
                                    wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                    if root.page == 16: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 8px;
                                Text { text: "Qualitative coding"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                                Text { text: "Annotations are character-offset anchored to verified project source text. Use Inspect first and copy its current content_hash into any write."; color: Theme.muted-ink; wrap: word-wrap; }
                                Button { text: "Inspect coding state"; accessible-label: "Inspect qualitative state"; clicked => { root.inspect-qualitative(); } }
                                qualitative-hash := LineEdit { placeholder-text: "Current content hash"; accessible-label: "Qualitative content hash"; }
                                Text { text: "Transcript → case mapping"; color: Theme.ink; font-size: 14px * Theme.ui-scale / 100; font-weight: 600; }
                                Text { text: "Map a persisted source to the case ID used by your quantitative dataset. Mappings are treated as confidential; the host re-verifies source/body hashes before mixed-method analysis."; color: Theme.muted-ink; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    qualitative-transcript-source := LineEdit { placeholder-text: "Transcript source ID"; accessible-label: "Qualitative transcript source ID"; }
                                    qualitative-transcript-case := LineEdit { placeholder-text: "Dataset case ID"; accessible-label: "Qualitative transcript case ID"; }
                                }
                                qualitative-transcript-body-hash := LineEdit { placeholder-text: "Expected source body SHA-256"; accessible-label: "Qualitative transcript expected body hash"; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Preview case mapping"; accessible-label: "Preview qualitative transcript case mapping"; clicked => { root.preview-qualitative-transcript(qualitative-hash.text, qualitative-transcript-source.text, qualitative-transcript-case.text, qualitative-transcript-body-hash.text, false); } }
                                    Button { text: "Preview mapping update"; accessible-label: "Preview qualitative transcript case mapping update"; clicked => { root.preview-qualitative-transcript(qualitative-hash.text, qualitative-transcript-source.text, qualitative-transcript-case.text, qualitative-transcript-body-hash.text, true); } }
                                    Button { text: "Record previewed action"; accessible-label: "Record previewed qualitative action"; clicked => { root.apply-evidence-preview(); } }
                                }
                                Text { text: "Source annotation"; color: Theme.ink; font-size: 14px * Theme.ui-scale / 100; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    qualitative-source-id := LineEdit { placeholder-text: "Source ID"; accessible-label: "Qualitative source ID"; }
                                    qualitative-code-id := LineEdit { placeholder-text: "Code ID"; accessible-label: "Qualitative annotation code ID"; }
                                    qualitative-coder := LineEdit { placeholder-text: "Coder"; accessible-label: "Qualitative coder"; }
                                    qualitative-unit-id := LineEdit { placeholder-text: "Unique unit ID"; accessible-label: "Qualitative unit ID"; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    qualitative-start := LineEdit { placeholder-text: "Start character offset"; accessible-label: "Qualitative annotation start"; }
                                    qualitative-end := LineEdit { placeholder-text: "End character offset"; accessible-label: "Qualitative annotation end"; }
                                    Button { text: "Preview annotation"; accessible-label: "Preview qualitative annotation"; clicked => { root.preview-qualitative-annotation(qualitative-hash.text, qualitative-source-id.text, qualitative-code-id.text, qualitative-coder.text, qualitative-unit-id.text, qualitative-start.text, qualitative-end.text); } }
                                    Button { text: "Record previewed action"; accessible-label: "Record previewed qualitative action"; clicked => { root.apply-evidence-preview(); } }
                                }
                                Text { text: "Fixed-unit nominal agreement"; color: Theme.ink; font-size: 14px * Theme.ui-scale / 100; font-weight: 600; }
                                qualitative-first := LineEdit { placeholder-text: "Coder A JSON mapping unit IDs to labels"; accessible-label: "Qualitative first coder JSON"; }
                                qualitative-second := LineEdit { placeholder-text: "Coder B JSON with identical unit IDs"; accessible-label: "Qualitative second coder JSON"; }
                                Button { text: "Compute Cohen kappa"; accessible-label: "Compute qualitative kappa"; clicked => { root.compute-qualitative-kappa(qualitative-first.text, qualitative-second.text); } }
                                Text { text: root.qualitative-results; accessible-label: "Qualitative operation result " + root.qualitative-results; wrap: word-wrap; color: Theme.ink; }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                    if root.page == 17: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 9px;
                            Text { text: "Codebook"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                            Text { text: "Codebook edits are optimistic-concurrency guarded by the qualitative content hash."; color: Theme.muted-ink; wrap: word-wrap; }
                            Button { text: "Inspect current codebook"; accessible-label: "Inspect qualitative codebook"; clicked => { root.inspect-qualitative(); } }
                            codebook-hash := LineEdit { placeholder-text: "Current content hash from Inspect"; accessible-label: "Codebook content hash"; }
                            HorizontalLayout {
                                spacing: 8px;
                                codebook-id := LineEdit { placeholder-text: "Code ID"; accessible-label: "Codebook code ID"; }
                                codebook-name := LineEdit { placeholder-text: "Code name"; accessible-label: "Codebook code name"; }
                                codebook-actor := LineEdit { placeholder-text: "Actor"; accessible-label: "Codebook actor"; }
                            }
                            codebook-description := LineEdit { placeholder-text: "Description"; accessible-label: "Codebook code description"; }
                            codebook-parent := LineEdit { placeholder-text: "Parent code ID (optional)"; accessible-label: "Codebook parent ID"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: "Preview add code"; accessible-label: "Preview qualitative code addition"; clicked => { root.preview-qualitative-code(codebook-hash.text, codebook-id.text, codebook-name.text, codebook-description.text, codebook-parent.text, codebook-actor.text); } }
                                Button { text: "Record previewed action"; accessible-label: "Record previewed codebook action"; clicked => { root.apply-evidence-preview(); } }
                            }
                            Text { text: root.qualitative-results; accessible-label: "Codebook operation result " + root.qualitative-results; wrap: word-wrap; color: Theme.ink; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.page == 18: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 10px;
                                Text { text: "Mixed methods joint display"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                                Text {
                                    text: "Join an immutable quantitative dataset revision to explicit transcript-to-case mappings stored in this project. ResearchWeave reloads and verifies the qualitative coding hash and case map itself; this screen never accepts caller-supplied provenance.";
