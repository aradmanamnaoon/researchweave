                                analysis-revision := LineEdit { placeholder-text: "Dataset revision"; accessible-label: "Analysis dataset revision"; }
                                Button { text: "Inspect dataset"; accessible-label: "Inspect analysis dataset"; clicked => { root.inspect-dataset(analysis-dataset-id.text, analysis-revision.text); } }
                            }
                            Text { text: root.analysis-results; accessible-label: "Analysis operation result " + root.analysis-results; wrap: word-wrap; color: Theme.ink; }
                            Rectangle { vertical-stretch: 1; }
                        }
