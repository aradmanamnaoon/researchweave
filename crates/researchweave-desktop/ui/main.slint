                                    Text { text: "Activity"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: root.activity-name; color: Theme.ink; }
                                    Text { text: "Project revision"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: root.project-revision; color: Theme.ink; }
                                    Text { text: "Implementation state"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: "Native workflow integration pending"; color: Theme.warning; font-size: 11px * Theme.ui-scale / 100; }
                                }
                            }
                        }
                    }
                }
                // The assistant stays optional and off until the user asks for
                // a preview. Opening this panel never contacts an AI provider.
                if root.context-ai-open: Rectangle {
                    min-width: 260px;
                    preferred-width: 315px;
                    max-width: 365px;
                    horizontal-stretch: 0;
                    background: Theme.surface;
                    border-color: Theme.divider;
                    border-width: 1px;
                    accessible-role: complementary;
                    accessible-label: "Contextual AI help panel";
                    ScrollView {
                        VerticalLayout {
                            padding: Theme.space4;
                            spacing: Theme.space3;
                            Text {
                                text: "AI help";
                                font-size: 20px * Theme.ui-scale / 100;
                                font-weight: 700;
                                color: Theme.ink;
                            }
                            Text {
                                text: "Uses this workspace's permitted context. Nothing is sent until you preview and explicitly run a local model.";
                                color: Theme.muted-ink;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.context-ai-source;
                                color: Theme.ink;
                                font-weight: 600;
                                wrap: word-wrap;
                                max-width: 280px;
                            }
                            LineEdit {
                                text: root.context-ai-task;
                                min-width: 0px;
                                max-width: 275px;
                                placeholder-text: "What would you like AI to help with?";
                                accessible-label: "Contextual AI request";
                                edited(value) => { root.context-ai-task = value; root.context-ai-ready = false; }
                            }
                            LineEdit {
                                text: root.context-ai-profile;
                                min-width: 0px;
                                max-width: 275px;
                                placeholder-text: "Local model profile (optional)";
                                accessible-label: "Local AI provider profile ID";
                                edited(value) => { root.context-ai-profile = value; root.context-ai-ready = false; }
                            }
                            VerticalLayout {
                                spacing: Theme.space2;
                                Button {
                                    text: "Preview context";
                                    min-width: 0px;
                                    max-width: 275px;
                                    accessible-label: "Preview the exact AI request without sending data";
                                    enabled: !root.context-ai-busy;
                                    accessible-enabled: !root.context-ai-busy;
                                    clicked => { root.preview-context-ai(); }
                                }
                                Button {
                                    text: "Run locally";
                                    min-width: 0px;
                                    max-width: 275px;
                                    accessible-label: "Send the approved context to the selected local model";
                                    enabled: root.context-ai-ready && !root.context-ai-busy;
                                    accessible-enabled: root.context-ai-ready && !root.context-ai-busy;
                                    clicked => { root.run-context-ai(); }
                                }
                            }
                            if root.context-ai-busy: Button {
                                text: "Cancel request";
                                accessible-label: "Cancel pending local AI inference";
                                clicked => { root.cancel-context-ai(); }
                            }
                            Text {
                                text: "Request preview";
                                color: Theme.ink;
                                font-weight: 600;
                            }
                            TextEdit {
                                text: root.context-ai-preview-summary;
                                read-only: true;
                                min-width: 0px;
                                max-width: 275px;
                                wrap: word-wrap;
                                min-height: 135px;
                                preferred-height: 190px;
                                accessible-label: "Previewed contextual AI request; scroll to inspect the exact source content and privacy notice";
                            }
                            Text {
                                text: "Model response · Review before using";
                                color: Theme.ink;
                                font-weight: 600;
                                wrap: word-wrap;
                                max-width: 275px;
                            }
                            TextEdit {
                                text: root.context-ai-output;
                                read-only: true;
                                min-width: 0px;
                                max-width: 275px;
                                wrap: word-wrap;
                                min-height: 200px;
                                preferred-height: 320px;
                                accessible-label: "Reviewable AI response; no user documents are changed automatically";
                            }
                            Button {
                                text: "Open full assistant";
                                accessible-label: "Switch to the dedicated assistant screen";
                                clicked => { root.page = 23; root.context-ai-open = false; }
                            }
                        }
                    }
                }
            }

            // Global bottom tray: stable keyboard target for jobs/notifications.
            Rectangle {
                height: Theme.compact-density ? 36px : 42px;
                background: Theme.surface;
                border-color: Theme.divider;
                border-width: 1px;
                accessible-role: complementary;
                accessible-label: "Bottom job tray";
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    tray-focus := Button {
                        text: "Jobs";
                        icon: @image-url("../../../assets/icons/jobs.svg");
                        icon-size: 16px;
                        colorize-icon: true;
                        accessible-label: "Open jobs";
                        clicked => { root.page = 31; }
                    }
                    Text {
                        text: root.progress > 0 && root.progress < 1 ? "Local job running" :
                              root.progress >= 1 ? "Last local job completed" : "No active local jobs";
                        color: Theme.muted-ink;
                        vertical-alignment: center;
                        font-size: 11px * Theme.ui-scale / 100;
                    }
                    if root.progress > 0 && root.progress < 1: SemanticProgress {
                        progress: root.progress;
                        label: "Current local job progress";
                    }
                    Button {
                        text: "Notifications";
                        icon: @image-url("../../../assets/icons/notifications.svg");
                        icon-size: 16px;
                        colorize-icon: true;
                        accessible-label: "Open notifications";
                        clicked => { root.page = 32; }
                    }
                }
            }

            // Global status bar: concise state only; progress ticks are intentionally not announced here.
            Rectangle {
                height: 30px;
                background: Theme.ink;
                accessible-role: content-info;
                accessible-label: "Workbench status";
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 14px;
                    Text {
                        text: root.status;
                        color: Theme.surface;
                        font-size: 11px * Theme.ui-scale / 100;
                        vertical-alignment: center;
                        accessible-label: "Status: " + root.status;
                        accessible-live-region: polite;
                    }
                    Text {
                        text: "LOCAL FIRST";
                        color: #9fd0cc;
                        font-size: 10px * Theme.ui-scale / 100;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.activity-name + " · " + root.pages[root.page];
                        color: Theme.rail-muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        font-size: 10px * Theme.ui-scale / 100;
                    }
                }
            }
        }
    }
}
