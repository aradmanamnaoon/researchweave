                    if root.page == 29: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Text { text: "Recovery"; color: Theme.ink; font-size: 24px * Theme.ui-scale / 100; font-weight: 700; }
                            Text {
                                text: "Recovery validates the archive first and restores only into a new absolute directory.";
                                color: Theme.muted-ink;
                                wrap: word-wrap;
                            }
                            recovery-archive := LineEdit {
                                placeholder-text: "Absolute .rwproj or .rwproj.enc archive path";
                                accessible-label: "Recovery archive path";
                            }
                            recovery-destination := LineEdit {
                                placeholder-text: "New absolute project directory";
                                accessible-label: "Recovery destination path";
                            }
