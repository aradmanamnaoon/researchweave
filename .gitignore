# Rust build output. Keep Cargo.lock, source fixtures and packaging scripts tracked.
/target/
crates/*/target/
crates/*/*.cdx.json
*.rs.bk
*.pdb
*.dSYM/

# Native installer / release staging output.
/dist/
/build/
/artifacts/
/release/
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm

# Local Python tooling used by development and verification scripts.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage*
htmlcov/

# Editor, operating-system and temporary files.
.idea/
.vscode/
.fleet/
.history/
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.orig
*.rej
*.tmp
*.temp
*.log

# Secrets and local provider configuration.
.env
.env.*
!.env.example
.envrc
*.key
*.pem
*.p12
*.pfx
*.kdbx
*credentials*.local.json
*.secret.json
*.local.json

# User research data, database sidecars, backups and private workspaces.
# Deliberately preserve explicitly committed synthetic fixtures below.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.rwproj
*.rwproj.enc
*.rwenc
!/crates/*/tests/fixtures/*.rwproj
!/crates/*/tests/fixtures/*.rwproj.enc
!/crates/*/tests/fixtures/*.rwenc
/projects/
/workspace-data/
/private/
/downloads/
/output/
/backups/
/tmp/
/temp/
/.cache/
/.local-audit/
/.tmp-external-audit/

# Heavy local models; explicitly allow synthetic binary test fixtures.
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.onnx
*.bin
!/crates/*/tests/fixtures/*.bin
/models/
/model-cache/
/weights/

# Private local planning/recovery artifacts that are absent from the public tree.
/prompts/
/*.bundle
/legacy-tracked-files.pre-v2.txt
