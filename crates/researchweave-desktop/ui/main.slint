                            HorizontalLayout {
                                spacing: 8px;
                                manuscript-id := LineEdit { accessible-label: "Manuscript ID"; placeholder-text: "Manuscript ID"; text: root.manuscript-draft-id; edited(text) => { root.manuscript-draft-id = text; root.manuscript-draft-edited(manuscript-id.text, manuscript-section.text, manuscript-citations.text, manuscript-body.text); } }
                                manuscript-section := LineEdit { accessible-label: "Manuscript section"; placeholder-text: "Section, e.g. Results"; text: root.manuscript-draft-section; edited(text) => { root.manuscript-draft-section = text; root.manuscript-draft-edited(manuscript-id.text, manuscript-section.text, manuscript-citations.text, manuscript-body.text); } }
                                manuscript-citations := LineEdit { accessible-label: "Manuscript citations"; placeholder-text: "Citation IDs separated by commas"; text: root.manuscript-draft-citations; edited(text) => { root.manuscript-draft-citations = text; root.manuscript-draft-edited(manuscript-id.text, manuscript-section.text, manuscript-citations.text, manuscript-body.text); } }
                            }
                            manuscript-body := TextEdit {
                                min-height: 140px;
                                preferred-height: 220px;
                                accessible-label: "Manuscript section body";
                                text: root.manuscript-draft-body;
                                edited(text) => { root.manuscript-draft-body = text; root.manuscript-draft-edited(manuscript-id.text, manuscript-section.text, manuscript-citations.text, text); }
                            }
                            HorizontalLayout {
                                min-height: 36px;
                                preferred-height: 36px;
                                max-height: 40px;
                                spacing: 8px;
                                Button { text: "Preview section"; accessible-label: "Preview manuscript section"; clicked => { root.preview-writing-section(manuscript-id.text, manuscript-section.text, manuscript-citations.text, manuscript-body.text); } }
                                Button { text: "Record previewed section"; accessible-label: "Record previewed manuscript section"; clicked => { root.apply-evidence-preview(); } }
                                Button { text: "Inspect manuscript"; accessible-label: "Inspect manuscript"; clicked => { root.inspect-manuscript(manuscript-id.text); } }
                            }
                            HorizontalLayout {
                                min-height: 36px;
                                preferred-height: 36px;
                                max-height: 40px;
                                spacing: 8px;
                                Text {
                                    min-width: 48px;
                                    preferred-width: 48px;
                                    max-width: 48px;
                                    horizontal-stretch: 0;
                                    text: "Export";
                                    color: Theme.muted-ink;
                                    vertical-alignment: center;
                                }
                                Button { text: "Markdown"; accessible-label: "Export manuscript Markdown"; clicked => { root.export-manuscript(manuscript-id.text, "markdown"); } }
                                Button { text: "DOCX"; accessible-label: "Export manuscript DOCX"; clicked => { root.export-manuscript(manuscript-id.text, "docx"); } }
                                Button { text: "HTML"; accessible-label: "Export manuscript HTML"; clicked => { root.export-manuscript(manuscript-id.text, "html"); } }
                                Button { text: "PDF"; accessible-label: "Export manuscript PDF"; clicked => { root.export-manuscript(manuscript-id.text, "pdf"); } }
                            }
                            Rectangle {
                                min-height: 110px;
                                preferred-height: 160px;
                                max-height: 180px;
                                background: Theme.surface;
                                border-color: Theme.divider;
                                border-width: 1px;
                                border-radius: Theme.panel-radius;
                                ScrollView {
                                    VerticalLayout {
                                        padding: 10px;
                                        Text {
                                            text: root.writing-results == "" ? "Manuscript results and export receipts appear here." : root.writing-results;
                                            accessible-label: "Writing operation result " + root.writing-results;
                                            wrap: word-wrap;
                                            color: Theme.ink;
                                        }
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.page == 22: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Text { text: "Publishing"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                            Text {
                                text: "Validate the persisted manuscript, render its bibliography, or build a local draft submission packet. ResearchWeave never submits files or asserts journal readiness.";
                                color: Theme.muted-ink;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                publishing-manuscript-id := LineEdit {
                                    accessible-label: "Publishing manuscript ID";
                                    placeholder-text: "Manuscript ID";
                                    text: root.manuscript-draft-id;
                                }
                                publishing-journal := LineEdit {
                                    accessible-label: "Target journal";
                                    placeholder-text: "Target journal or venue";
                                }
                            }
                            HorizontalLayout {
                                min-height: 38px;
                                preferred-height: 38px;
                                max-height: 42px;
                                spacing: 8px;
                                Button {
                                    text: "Check readiness";
                                    accessible-label: "Check manuscript publishing readiness";
                                    clicked => { root.publishing-action("check", publishing-manuscript-id.text, publishing-journal.text); }
                                }
                                Button {
                                    text: "Generate bibliography";
                                    accessible-label: "Generate manuscript bibliography";
                                    clicked => { root.publishing-action("bibliography", publishing-manuscript-id.text, publishing-journal.text); }
                                }
                                Button {
                                    text: "Build draft ZIP";
                                    accessible-label: "Build incomplete draft submission ZIP";
                                    accessible-description: "Creates a local review packet even when readiness checks report missing sections. No submission occurs.";
                                    clicked => { root.publishing-action("draft-packet", publishing-manuscript-id.text, publishing-journal.text); }
                                }
                            }
                            Rectangle {
                                min-height: 64px;
                                preferred-height: 64px;
                                max-height: 80px;
                                background: Theme.accent-subtle;
                                border-color: Theme.divider;
                                border-width: 1px;
                                border-radius: Theme.panel-radius;
                                Text {
                                    x: 12px;
                                    y: 10px;
                                    width: parent.width - 24px;
                                    text: "Draft packets may contain incomplete work. Confirm journal instructions, authorship, ethics declarations, privacy, references, figures/tables and reporting checklists before any external submission.";
                                    wrap: word-wrap;
                                    color: Theme.ink;
                                }
                            }
                            Rectangle {
                                min-height: 180px;
                                vertical-stretch: 1;
                                background: Theme.surface;
                                border-color: Theme.divider;
                                border-width: 1px;
                                border-radius: Theme.panel-radius;
                                ScrollView {
                                    VerticalLayout {
                                        padding: 10px;
                                        Text {
                                            text: root.writing-results == "" ? "Publishing checks and packet receipts appear here." : root.writing-results;
                                            accessible-label: "Publishing operation result " + root.writing-results;
                                            wrap: word-wrap;
                                            color: Theme.ink;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.page == 23: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                          VerticalLayout {
                            padding: 24px;
                            spacing: 9px;
                            Text { text: "Agent"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                            Text { text: "Local durable conversation, prompt-template and human-reviewed tool state. No model tool executes until its exact stored fingerprint is approved and Execute approved action is invoked."; color: Theme.muted-ink; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                agent-conversation-id := LineEdit { placeholder-text: "Conversation ID (ASCII letters/numbers/-/_)"; accessible-label: "Assistant conversation ID"; }
                                agent-conversation-title := LineEdit { placeholder-text: "Conversation title"; accessible-label: "Assistant conversation title"; }
                                Button { text: "Preview conversation"; accessible-label: "Preview assistant conversation creation"; clicked => { root.preview-conversation-create(agent-conversation-id.text, agent-conversation-title.text); } }
                                Button { text: "Record previewed action"; accessible-label: "Record previewed assistant action"; clicked => { root.apply-ai-preview(); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                agent-role := LineEdit { placeholder-text: "Manual role: user, system, assistant"; accessible-label: "Assistant message role"; }
                                agent-message := LineEdit { placeholder-text: "Manual conversation message"; accessible-label: "Assistant message content"; }
                                Button { text: "Preview message"; accessible-label: "Preview assistant message append"; clicked => { root.preview-assistant-message(agent-conversation-id.text, agent-role.text, agent-message.text); } }
                                Button { text: "History"; accessible-label: "Load assistant conversation history"; clicked => { root.load-assistant-history(agent-conversation-id.text); } }
                                Button { text: "List"; accessible-label: "List assistant conversations"; clicked => { root.list-assistant-conversations(); } }
                            }
                            Text { text: "Versioned prompt template"; color: Theme.ink; font-size: 14px * Theme.ui-scale / 100; font-weight: 600; }
                            agent-prompt-name := LineEdit { placeholder-text: "Prompt name"; accessible-label: "Assistant prompt name"; }
                            agent-system-text := LineEdit { placeholder-text: "Trusted system instructions"; accessible-label: "Assistant prompt system text"; }
                            agent-user-template := LineEdit { placeholder-text: "User template containing {{project_text}}"; accessible-label: "Assistant prompt user template"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: "Preview template"; accessible-label: "Preview assistant prompt template"; clicked => { root.preview-prompt-template(agent-prompt-name.text, agent-system-text.text, agent-user-template.text); } }
                                agent-project-text := LineEdit { placeholder-text: "Project text to render as user content"; accessible-label: "Assistant project text"; }
                                Button { text: "Render template"; accessible-label: "Render assistant prompt template"; clicked => { root.render-prompt-template(agent-prompt-name.text, agent-project-text.text); } }
                            }
                            Text { text: root.agent-results; accessible-label: "Agent operation result " + root.agent-results; wrap: word-wrap; color: Theme.ink; }
                            Rectangle { min-height: 1px; background: Theme.divider; }
                            Text { text: "Human-reviewed tool proposal"; color: Theme.ink; font-size: 14px * Theme.ui-scale / 100; font-weight: 600; }
                            Text { text: "This desktop slice permits only assistant.retrieval.index and assistant.retrieval.revoke_source. Raw arguments stay in the local action store and are hidden from the review summary."; color: Theme.muted-ink; wrap: word-wrap; }
                            agent-tool-goal := LineEdit { placeholder-text: "Goal for inert proposal plan"; accessible-label: "Agent proposal goal"; }
                            agent-tool-operation := LineEdit { placeholder-text: "assistant.retrieval.index or assistant.retrieval.revoke_source"; accessible-label: "Agent proposed operation"; }
                            agent-tool-arguments := LineEdit { placeholder-text: "JSON object arguments"; accessible-label: "Agent proposed arguments JSON"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: "Preview plan"; accessible-label: "Preview inert agent plan"; clicked => { root.preview-agent-plan(agent-tool-goal.text, agent-tool-operation.text, agent-tool-arguments.text); } }
                                Button { text: "Stage proposal"; accessible-label: "Stage agent tool proposal"; clicked => { root.stage-agent-action(agent-tool-operation.text, agent-tool-arguments.text); } }
                                Button { text: "Timeline"; accessible-label: "Load agent action timeline"; clicked => { root.load-agent-action-timeline(); } }
                            }
                            agent-denial-reason := LineEdit { placeholder-text: "Reason required when denying"; accessible-label: "Agent denial reason"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: "Approve exact proposal"; accessible-label: "Approve exact agent proposal"; clicked => { root.approve-agent-action(); } }
                                Button { text: "Deny exact proposal"; accessible-label: "Deny exact agent proposal"; clicked => { root.deny-agent-action(agent-denial-reason.text); } }
                                Button { text: "Execute approved action"; accessible-label: "Execute approved agent action"; clicked => { root.execute-agent-action(); } }
                            }
                            Text { text: root.agent-action-results; accessible-label: "Agent action review " + root.agent-action-results; wrap: word-wrap; color: Theme.ink; }
                            Rectangle { min-height: 16px; }
                          }
                        }
                    }
                    if root.page == 24: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                         VerticalLayout {
                            padding: 24px;
                            spacing: 10px;
                            Text { text: "Providers"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                            Text { text: "Validate provider configuration without resolving credentials or contacting the network. Remote chat remains disabled in this desktop slice."; color: Theme.muted-ink; wrap: word-wrap; }
                            provider-id := LineEdit { placeholder-text: "Provider ID"; accessible-label: "Provider ID"; }
                            provider-kind := LineEdit { placeholder-text: "Kind: open_ai_compatible, ollama, anthropic, gemini"; accessible-label: "Provider kind"; }
                            provider-model := LineEdit { placeholder-text: "Model"; accessible-label: "Provider model"; }
                            provider-endpoint := LineEdit { placeholder-text: "HTTPS endpoint or loopback HTTP"; accessible-label: "Provider endpoint"; }
                            provider-local := LineEdit { placeholder-text: "Local: true or false"; accessible-label: "Provider local flag"; }
                            Button { text: "Validate offline"; accessible-label: "Validate provider profile offline"; clicked => { root.validate-provider(provider-id.text, provider-kind.text, provider-model.text, provider-endpoint.text, provider-local.text); } }
                            VerticalLayout {
                                spacing: 8px;
                                Button { text: "Preview configure"; accessible-label: "Preview configure provider profile"; clicked => { root.profile-action("configure", provider-id.text, provider-kind.text, provider-model.text, provider-endpoint.text, provider-local.text); } }
                                Button { text: "Preview update"; accessible-label: "Preview update provider profile"; clicked => { root.profile-action("update", provider-id.text, provider-kind.text, provider-model.text, provider-endpoint.text, provider-local.text); } }
                                Button { text: "Preview disconnect"; accessible-label: "Preview disconnect provider profile"; clicked => { root.profile-action("disconnect", provider-id.text, provider-kind.text, provider-model.text, provider-endpoint.text, provider-local.text); } }
                            }
                            VerticalLayout {
                                Button { text: "Record profile change"; accessible-label: "Record approved provider profile change"; clicked => { root.apply-ai-preview(); } }
                                Button { text: "List profiles"; accessible-label: "List stored provider profiles"; clicked => { root.list-provider-profiles(); } }
                            }
                            Text { text: root.provider-results; accessible-label: "Provider validation result " + root.provider-results; wrap: word-wrap; color: Theme.ink; }
                         }
                        }
                    }
                    if root.page == 31: Rectangle {
                        background: Theme.surface;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 14px;
                            Text { text: "Recent PDF operations"; font-size: 20px * Theme.ui-scale / 100; color: Theme.ink; }
                            Text { text: root.durable-jobs; wrap: word-wrap; color: Theme.ink; accessible-label: "Persisted job history"; }
                            Button { text: "Clear job history"; accessible-label: "Clear job history"; clicked => { root.clear-job-history(); } }
                        }
                    }
                    if root.page == 32: Rectangle {
                        background: Theme.surface;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 14px;
                            Text { text: "Recent notifications"; font-size: 20px * Theme.ui-scale / 100; color: Theme.ink; }
                            Text { text: root.durable-notifications; wrap: word-wrap; color: Theme.ink; accessible-label: "Persisted notifications"; }
                            Button { text: "Dismiss notifications"; accessible-label: "Dismiss notifications"; clicked => { root.dismiss-notifications(); } }
                        }
                    }
                    if root.page == 30: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                         VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Text { text: "Project diagnostics"; color: Theme.ink; font-size: 22px * Theme.ui-scale / 100; }
                            Text { text: "Structural checks only. No scientific or external-source certification."; color: Theme.muted-ink; wrap: word-wrap; }
                            Button { text: "Run diagnostics"; accessible-label: "Run project diagnostics"; clicked => { root.run-diagnostics(); } }
                            Text { text: root.diagnostics-results; accessible-label: "Project diagnostics summary " + root.diagnostics-results; color: Theme.ink; wrap: word-wrap; }
                         }
                        }
                    }
                    if root.page == 37: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                         VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Text { text: "Project activity history"; color: Theme.ink; font-size: 22px * Theme.ui-scale / 100; }
                            Text { text: "Local project event chain. actor_authenticated=false; source=project_event_chain. No private payloads."; color: Theme.muted-ink; wrap: word-wrap; }
                            activity-filter := LineEdit { placeholder-text: "Exact operation filter (optional)"; accessible-label: "Activity exact operation filter"; }
                            activity-offset := LineEdit { text: "0"; accessible-label: "Activity offset"; }
                            activity-limit := LineEdit { text: "25"; accessible-label: "Activity limit"; }
                            HorizontalLayout {
                                Button { text: "Load activity"; accessible-label: "Load project activity"; clicked => { root.load-project-activity(activity-filter.text, activity-offset.text, activity-limit.text); } }
                                Button { text: "Clear view"; accessible-label: "Clear project activity view"; clicked => { root.clear-project-activity-view(); } }
                            }
                            Text { text: root.project-activity-results; accessible-label: "Verified project activity " + root.project-activity-results; color: Theme.ink; wrap: word-wrap; }
                         }
                        }
                    }
                    if root.page > 1 && root.page != 2 && root.page != 4 && root.page != 5 && root.page != 7 && root.page != 9 && root.page != 10 && root.page != 11 && root.page != 12 && root.page != 14 && root.page != 16 && root.page != 17 && root.page != 19 && root.page != 20 && root.page != 21 && root.page != 22 && root.page != 23 && root.page != 24 && root.page != 28 && root.page != 29 && root.page != 30 && root.page != 31 && root.page != 32 && root.page != 36 && root.page != 37: Rectangle {
                        background: Theme.raised;
                        HorizontalLayout {
                            padding: 24px;
                            spacing: 18px;
                            Rectangle {
                                background: Theme.surface;
                                border-radius: Theme.panel-radius;
                                border-color: Theme.divider;
                                border-width: 1px;
                                VerticalLayout {
                                    padding: 24px;
                                    spacing: 12px;
                                    Text { text: root.pages[root.page]; font-size: 22px * Theme.ui-scale / 100; font-weight: 700; color: Theme.ink; }
                                    Text { text: "This capability remains reachable while its native Rust workflow is integrated."; color: Theme.muted-ink; }
                                    Text { text: "The workbench shell is now organized by research activity rather than a flat screen directory."; color: Theme.muted-ink; font-size: 12px * Theme.ui-scale / 100; }
                                    Rectangle { height: 8px; }
                                    Text { text: "No mock workflow is shown here."; color: Theme.warning; font-size: 12px * Theme.ui-scale / 100; }
                                }
                            }
                            Rectangle {
                                visible: root.show-inspector;
                                min-width: 0px;
                                preferred-width: root.show-inspector ? 250px : 0px;
                                max-width: root.show-inspector ? 250px : 0px;
                                horizontal-stretch: 0;
                                background: Theme.surface;
                                border-radius: Theme.panel-radius;
                                border-color: Theme.divider;
                                border-width: 1px;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text { text: "Inspector"; color: Theme.ink; font-size: 15px * Theme.ui-scale / 100; font-weight: 600; }
                                    Text { text: "Activity"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: root.activity-name; color: Theme.ink; }
                                    Text { text: "Project revision"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: root.project-revision; color: Theme.ink; }
                                    Text { text: "Implementation state"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: "Native workflow integration pending"; color: Theme.warning; font-size: 11px * Theme.ui-scale / 100; }
                                }
                            }
                        }
                    }
                }
            }

            // Global bottom tray: stable keyboard target for jobs/notifications.
            Rectangle {
                height: Theme.compact-density ? 36px : 42px;
                background: Theme.surface;
                border-color: Theme.divider;
                border-width: 1px;
                accessible-role: complementary;
                accessible-label: "Bottom job tray";
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    tray-focus := Button {
                        text: "Jobs";
                        icon: @image-url("../../../assets/icons/jobs.svg");
                        icon-size: 16px;
                        colorize-icon: true;
                        accessible-label: "Open jobs";
                        clicked => { root.page = 31; }
                    }
                    Text {
                        text: root.progress > 0 && root.progress < 1 ? "Local job running" :
                              root.progress >= 1 ? "Last local job completed" : "No active local jobs";
                        color: Theme.muted-ink;
                        vertical-alignment: center;
                        font-size: 11px * Theme.ui-scale / 100;
                    }
                    if root.progress > 0 && root.progress < 1: SemanticProgress {
                        progress: root.progress;
                        label: "Current local job progress";
                    }
                    Button {
                        text: "Notifications";
                        icon: @image-url("../../../assets/icons/notifications.svg");
                        icon-size: 16px;
                        colorize-icon: true;
                        accessible-label: "Open notifications";
                        clicked => { root.page = 32; }
                    }
                }
            }

            // Global status bar: concise state only; progress ticks are intentionally not announced here.
            Rectangle {
                height: 30px;
                background: Theme.ink;
                accessible-role: content-info;
                accessible-label: "Workbench status";
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 14px;
                    Text {
                        text: root.status;
                        color: Theme.surface;
                        font-size: 11px * Theme.ui-scale / 100;
                        vertical-alignment: center;
                        accessible-label: "Status: " + root.status;
                        accessible-live-region: polite;
                    }
                    Text {
                        text: "LOCAL FIRST";
                        color: #9fd0cc;
                        font-size: 10px * Theme.ui-scale / 100;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.activity-name + " · " + root.pages[root.page];
                        color: Theme.rail-muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        font-size: 10px * Theme.ui-scale / 100;
                    }
                }
            }
        }
    }
}
