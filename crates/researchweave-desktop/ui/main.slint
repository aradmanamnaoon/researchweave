                                    Button { text: "Preview mapping update"; accessible-label: "Preview qualitative transcript case mapping update"; clicked => { root.preview-qualitative-transcript(qualitative-hash.text, qualitative-transcript-source.text, qualitative-transcript-case.text, qualitative-transcript-body-hash.text, true); } }
                                    Button { text: "Record previewed action"; accessible-label: "Record previewed qualitative action"; clicked => { root.apply-evidence-preview(); } }
