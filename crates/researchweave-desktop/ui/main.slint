                                    Button { text: "Preview annotation"; accessible-label: "Preview qualitative annotation"; clicked => { root.preview-qualitative-annotation(qualitative-hash.text, qualitative-source-id.text, qualitative-code-id.text, qualitative-coder.text, qualitative-unit-id.text, qualitative-start.text, qualitative-end.text); } }
                                    Button { text: "Record previewed action"; accessible-label: "Record previewed qualitative action"; clicked => { root.apply-evidence-preview(); } }
                                }
                                Text { text: "Fixed-unit nominal agreement"; color: Theme.ink; font-size: 14px * Theme.ui-scale / 100; font-weight: 600; }
                                qualitative-first := LineEdit { placeholder-text: "Coder A JSON mapping unit IDs to labels"; accessible-label: "Qualitative first coder JSON"; }
                                qualitative-second := LineEdit { placeholder-text: "Coder B JSON with identical unit IDs"; accessible-label: "Qualitative second coder JSON"; }
                                Button { text: "Compute Cohen kappa"; accessible-label: "Compute qualitative kappa"; clicked => { root.compute-qualitative-kappa(qualitative-first.text, qualitative-second.text); } }
                                Text { text: root.qualitative-results; accessible-label: "Qualitative operation result " + root.qualitative-results; wrap: word-wrap; color: Theme.ink; }
