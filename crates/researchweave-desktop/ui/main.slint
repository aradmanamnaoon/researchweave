                                    wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                    if root.page == 14: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 12px;
                                Text { text: "Statistics"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; font-weight: 700; }
                                Text {
                                    text: "Run tested native analyses against an immutable dataset revision. Results disclose complete-case counts, assumptions and warnings; ResearchWeave does not infer design validity from a selected test.";
                                    color: Theme.muted-ink;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    stats-dataset-id := LineEdit { placeholder-text: "Dataset ID"; accessible-label: "Statistics dataset ID"; }
                                    stats-revision := LineEdit { placeholder-text: "Dataset revision"; accessible-label: "Statistics dataset revision"; }
                                }

                                Rectangle { height: 1px; background: Theme.divider; }
                                Text { text: "Choose analysis"; color: Theme.ink; font-weight: 700; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: root.statistics-mode == 0 ? "› Descriptives" : "Descriptives"; accessible-label: "Show descriptive statistics form"; clicked => { root.statistics-mode = 0; } }
                                    Button { text: root.statistics-mode == 1 ? "› Frequency" : "Frequency"; accessible-label: "Show frequency table form"; clicked => { root.statistics-mode = 1; } }
                                    Button { text: root.statistics-mode == 2 ? "› Correlation" : "Correlation"; accessible-label: "Show correlation form"; clicked => { root.statistics-mode = 2; } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: root.statistics-mode == 3 ? "› Welch t" : "Welch t"; accessible-label: "Show Welch t test form"; clicked => { root.statistics-mode = 3; } }
                                    Button { text: root.statistics-mode == 4 ? "› Linear model" : "Linear model"; accessible-label: "Show linear model form"; clicked => { root.statistics-mode = 4; } }
                                }

                                if root.statistics-mode == 0: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Descriptive statistics"; color: Theme.ink; font-weight: 700; }
                                    Text { text: "Numeric summaries preserve immutable revision provenance and explicit missing-value accounting."; color: Theme.muted-ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-column := LineEdit { placeholder-text: "Numeric column"; accessible-label: "Statistics numeric column"; }
                                        Button { text: "Run descriptives"; accessible-label: "Run descriptive statistics"; clicked => { root.run-descriptives(stats-dataset-id.text, stats-revision.text, stats-column.text); } }
                                    }
                                }
                                if root.statistics-mode == 1: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Frequency table"; color: Theme.ink; font-weight: 700; }
                                    Text { text: "Count observed category levels and report valid/total percentages plus missing observations."; color: Theme.muted-ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-frequency-column := LineEdit { placeholder-text: "Categorical column"; accessible-label: "Statistics frequency column"; }
                                        Button { text: "Run frequency"; accessible-label: "Run frequency table"; clicked => { root.run-frequency(stats-dataset-id.text, stats-revision.text, stats-frequency-column.text); } }
                                    }
                                }
                                if root.statistics-mode == 2: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Pearson correlation"; color: Theme.ink; font-weight: 700; }
                                    Text { text: "Uses pairwise complete numeric observations and reports the sampling assumptions with the result."; color: Theme.muted-ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-correlation-x := LineEdit { placeholder-text: "X column"; accessible-label: "Statistics correlation X column"; }
                                        stats-correlation-y := LineEdit { placeholder-text: "Y column"; accessible-label: "Statistics correlation Y column"; }
                                        Button { text: "Run Pearson r"; accessible-label: "Run Pearson correlation"; clicked => { root.run-correlation(stats-dataset-id.text, stats-revision.text, stats-correlation-x.text, stats-correlation-y.text); } }
                                    }
                                }
                                if root.statistics-mode == 3: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Welch two-group t test"; color: Theme.ink; font-weight: 700; }
                                    Text { text: "Requires two explicitly named groups; other levels are excluded with a warning rather than silently pooled."; color: Theme.muted-ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-test-outcome := LineEdit { placeholder-text: "Outcome"; accessible-label: "Statistics t test outcome column"; }
                                        stats-test-group := LineEdit { placeholder-text: "Group column"; accessible-label: "Statistics t test group column"; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-test-first := LineEdit { placeholder-text: "First group"; accessible-label: "Statistics t test first group"; }
                                        stats-test-second := LineEdit { placeholder-text: "Second group"; accessible-label: "Statistics t test second group"; }
                                        Button { text: "Run Welch t"; accessible-label: "Run Welch t test"; clicked => { root.run-t-test(stats-dataset-id.text, stats-revision.text, stats-test-outcome.text, stats-test-group.text, stats-test-first.text, stats-test-second.text); } }
                                    }
                                }
                                if root.statistics-mode == 4: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Linear model"; color: Theme.ink; font-weight: 700; }
                                    Text { text: "OLS with HC3 robust covariance. Predictors are comma-separated and complete-case rows are reported in the result."; color: Theme.muted-ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        stats-model-outcome := LineEdit { placeholder-text: "Outcome"; accessible-label: "Statistics linear model outcome"; }
                                        stats-model-predictors := LineEdit { placeholder-text: "Predictors, comma-separated"; accessible-label: "Statistics linear model predictors"; }
                                        Button { text: "Fit OLS"; accessible-label: "Run linear model with HC3 covariance"; clicked => { root.run-linear-model(stats-dataset-id.text, stats-revision.text, stats-model-outcome.text, stats-model-predictors.text); } }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.divider; }
                                Text { text: "Result"; color: Theme.ink; font-weight: 700; }
                                Text { text: root.statistics-result-title; accessible-label: "Statistics result title " + root.statistics-result-title; color: Theme.ink; font-size: 18px * Theme.ui-scale / 100; font-weight: 700; }
                                Text { text: root.statistics-result-primary; accessible-label: "Statistics result primary " + root.statistics-result-primary; color: Theme.accent; font-size: 16px * Theme.ui-scale / 100; font-weight: 700; wrap: word-wrap; }
                                if root.statistics-result-secondary != "": Text { text: root.statistics-result-secondary; accessible-label: "Statistics result secondary " + root.statistics-result-secondary; color: Theme.ink; wrap: word-wrap; }
                                if root.statistics-result-provenance != "": Text { text: root.statistics-result-provenance; accessible-label: "Statistics result provenance " + root.statistics-result-provenance; color: Theme.muted-ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                Text { text: "Verified payload"; color: Theme.muted-ink; font-size: 12px * Theme.ui-scale / 100; font-weight: 700; }
                                Text {
                                    text: root.analysis-results;
                                    accessible-label: "Statistics operation result " + root.analysis-results;
                                    wrap: word-wrap;
                                    color: Theme.muted-ink;
                                    font-size: 11px * Theme.ui-scale / 100;
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
