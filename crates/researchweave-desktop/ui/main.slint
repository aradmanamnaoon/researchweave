import { Button, LineEdit, TextEdit, ListView, ScrollView, Palette } from "std-widgets.slint";
export { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark-mode: false;
    in-out property <bool> high-contrast: false;
    in-out property <bool> compact-density: false;
    in-out property <int> ui-scale: 100;
    in-out property <bool> reduced-motion: false;
    in-out property <color> canvas: high-contrast ? #000000 : (dark-mode ? #101923 : #f6f5f1);
    in-out property <color> surface: high-contrast ? #111111 : (dark-mode ? #172438 : #ffffff);
    in-out property <color> raised: high-contrast ? #1b1b1b : (dark-mode ? #1d2e3a : #edf1f0);
    in-out property <color> ink: high-contrast ? #ffffff : (dark-mode ? #f4f6f8 : #172438);
    in-out property <color> muted-ink: high-contrast ? #ffffff : (dark-mode ? #b9c5d3 : #5b677a);
    in-out property <color> divider: high-contrast ? #ffffff : (dark-mode ? #81919f : #87989a);
    // Brand accent deliberately uses a darker teal in light mode so white
    // primary-button text remains WCAG-AA readable.
    in-out property <color> accent: high-contrast ? #ffff00 : (dark-mode ? #55c7bd : #147a75);
    in-out property <color> accent-subtle: high-contrast ? #262600 : (dark-mode ? #173d3b : #ddeDEA);
    in-out property <color> accent-ink: high-contrast ? #000000 : (dark-mode ? #101923 : #ffffff);
    in-out property <color> focus: high-contrast ? #00ffff : (dark-mode ? #a997e8 : #7564b5);
    in-out property <color> success: high-contrast ? #7cffb2 : (dark-mode ? #7fd4af : #237a57);
    in-out property <color> warning: high-contrast ? #ffd166 : (dark-mode ? #e0a17b : #8a5a00);
    in-out property <color> danger: high-contrast ? #ff8899 : (dark-mode ? #ff9fad : #a9243e);
    in-out property <color> conflict: high-contrast ? #ffffff : (dark-mode ? #a997e8 : #7564b5);
    in-out property <color> evidence-violet: high-contrast ? #ffffff : (dark-mode ? #a997e8 : #7564b5);
    in-out property <color> discovery-copper: high-contrast ? #ffd166 : (dark-mode ? #e0a17b : #9a5b3a);
    in-out property <color> rail-muted: high-contrast ? #ffffff : (dark-mode ? #b9c5d3 : #b8c4d4);
    in-out property <color> rail-background: high-contrast ? #000000 : (dark-mode ? #101923 : #172438);
    in-out property <color> reader-canvas: high-contrast ? #000000 : (dark-mode ? #0c141d : #efede7);
    in-out property <color> tab-strip: high-contrast ? #1b1b1b : (dark-mode ? #13202c : #edf1f0);
    // Scientific-visualization roles. Charts must still expose numeric labels,
    // uncertainty and machine-readable data rather than encoding meaning by color.
    in-out property <color> data-1: high-contrast ? #00ffff : (dark-mode ? #55c7bd : #147a75);
    in-out property <color> data-2: high-contrast ? #ff99ff : (dark-mode ? #a997e8 : #7564b5);
    in-out property <color> data-3: high-contrast ? #ffd166 : (dark-mode ? #e0a17b : #9a5b3a);
    in-out property <color> data-4: high-contrast ? #ffffff : (dark-mode ? #8fb9e8 : #315f8f);
    in-out property <length> panel-radius: 8px;
    in-out property <length> control-radius: 5px;
    in-out property <length> space1: 4px;
    in-out property <length> space2: 8px;
    in-out property <length> space3: compact-density ? 8px : 12px;
    in-out property <length> space4: compact-density ? 12px : 16px;
    in-out property <length> space5: compact-density ? 16px : 20px;
    in-out property <length> space6: compact-density ? 18px : 24px;
    in-out property <length> space8: 32px;
}

component SemanticProgress inherits Rectangle {
    in property <float> progress;
    in property <string> label;
    min-height: 6px;
    preferred-height: 6px;
    max-height: 6px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: Theme.divider;
    border-radius: 3px;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    accessible-value: root.progress;
    accessible-value-minimum: 0.0;
    accessible-value-maximum: 1.0;
    Rectangle {
        width: parent.width * min(1, max(0, root.progress));
        height: parent.height;
        background: Theme.accent;
        border-radius: parent.border-radius;
    }
}

component ActivityNavButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;

    min-height: Theme.ui-scale > 150 ? 62px : 50px;
    preferred-height: Theme.ui-scale > 150 ? 62px : 50px;
    max-height: Theme.ui-scale > 150 ? 62px : 50px;
    horizontal-stretch: 1;
    background: root.selected
        ? Theme.accent-subtle
        : (touch.has-hover ? (Theme.dark-mode ? #213244 : #26384f) : transparent);
    border-radius: 9px;
    border-width: root.selected ? 1px : 0px;
    border-color: root.selected ? Theme.accent : transparent;
    clip: true;

    accessible-role: button;
    accessible-label: root.label + " activity";
    accessible-description: root.selected
        ? "Current ResearchWeave activity"
        : "Switch to the " + root.label + " research activity";
    accessible-action-default => { root.clicked(); }
    forward-focus: focus-scope;

    Rectangle {
        x: 7px;
        y: 10px;
        width: 3px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: root.selected ? Theme.accent : transparent;
        accessible-role: none;
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 3px;
        alignment: center;

        Image {
            source: root.icon;
            min-width: Theme.ui-scale > 150 ? 24px : 18px;
            preferred-width: Theme.ui-scale > 150 ? 24px : 18px;
            max-width: Theme.ui-scale > 150 ? 24px : 18px;
            min-height: Theme.ui-scale > 150 ? 24px : 18px;
            preferred-height: Theme.ui-scale > 150 ? 24px : 18px;
            max-height: Theme.ui-scale > 150 ? 24px : 18px;
            image-fit: contain;
            colorize: root.selected ? Theme.accent : Theme.rail-muted;
            accessible-role: none;
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.ink : Theme.rail-muted;
            font-size: Theme.ui-scale > 150 ? 14px : 10px;
            font-weight: root.selected ? 700 : 550;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            focus-scope.focus();
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if focus-scope.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.focus;
        accessible-role: none;
    }
}

export component MainWindow inherits Window {
    title: "ResearchWeave · Research workbench";
    icon: @image-url("../../../assets/branding/researchweave-icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 760px;
    min-height: 560px;
    background: Theme.canvas;
    default-font-size: 14px * Theme.ui-scale / 100;

    in-out property <int> page: 0;
    in-out property <float> progress: 0;
    in-out property <string> project-title: "No project selected";
    in-out property <int> project-revision: 0;
    in-out property <string> status: "Offline ready";
    in-out property <string> durable-jobs: "No completed PDF operations";
    in-out property <string> durable-notifications: "No notifications";
    callback clear-job-history();
    callback dismiss-notifications();
    in-out property <image> pdf-image;
    in-out property <string> pdf-status: "Choose a local PDF file";
    in-out property <int> pdf-matches: 0;
    in-out property <float> pdf-highlight-x: 0;
    in-out property <float> pdf-highlight-y: 0;
    in-out property <float> pdf-highlight-w: 0;
    in-out property <float> pdf-highlight-h: 0;
    in-out property <bool> pdf-highlight-visible: false;
    in-out property <int> pdf-job: 0;
    in-out property <string> library-results: "Open a project, then refresh its sources.";
    in-out property <string> research-summary: "Open a project to inspect its recorded research question and design.";
    in-out property <string> question-results: "Preview a structured question before recording it.";
    in-out property <string> protocol-results: "Preview a protocol before recording it.";
    in-out property <string> reference-results: "Register or inspect project references.";
    in-out property <string> review-results: "Use persisted references to build and screen a review.";
    in-out property <string> extraction-results: "Create a versioned extraction schema, then record validated values for a review record.";
    in-out property <string> analysis-results: "Import an immutable dataset revision or inspect saved analysis data.";
    in-out property <string> statistics-result-title: "No analysis run yet";
    in-out property <string> statistics-result-primary: "Choose a method and run it against an immutable dataset revision.";
    in-out property <string> statistics-result-secondary: "";
    in-out property <string> statistics-result-provenance: "";
    in-out property <string> variable-results: "Inspect variable metadata, missingness and quality before creating a revised immutable dataset.";
    in-out property <string> analysis-report-results: "Persist verified statistical outputs, reload them by digest, and compose deterministic provenance reports.";
    in-out property <string> mixed-methods-results: "Combine an immutable dataset revision with persisted qualitative case mappings. Caller-supplied coding provenance is not accepted.";
    in-out property <string> writing-results: "Preview and save a versioned manuscript section.";
    in-out property <string> agent-results: "Durable project-scoped assistant conversations and prompt templates are available offline.";
    in-out property <string> agent-action-results: "Stage an offline retrieval tool proposal to review its exact operation, effect and fingerprint before approval.";
    in-out property <string> provider-results: "Provider validation is offline-only; remote egress is disabled until explicitly configured.";
    in-out property <string> diagnostics-results: "Run structural diagnostics for the open project.";
    in-out property <string> project-activity-results: "Local project event provenance is not authenticated identity evidence.";
    in-out property <string> notebook-results: "Save a revisioned project notebook, inspect history, or export Markdown.";
    in-out property <string> notebook-draft: "";
    in-out property <string> manuscript-draft-id: "";
    in-out property <string> manuscript-draft-section: "";
    in-out property <string> manuscript-draft-citations: "";
    in-out property <string> manuscript-draft-body: "";
    callback notebook-draft-edited(string);
    callback manuscript-draft-edited(string, string, string, string);
    in-out property <string> qualitative-results: "Inspect the codebook before editing; writes require the current content hash.";
    in-out property <string> backup-results: "Open a project, then choose an absolute archive path.";
    in-out property <string> recovery-results: "Restore always creates a new project directory.";
    in-out property <string> cloud-results: "Cloud sync is opt-in. Save a profile and credentials before any network request.";
    in-out property <string> cloud-connectivity: "Not checked";
    in-out property <string> cloud-remote-revision: "None";
    in-out property <string> cloud-last-sync: "Never";
    in-out property <int> cloud-conflict-count: 0;
    in-out property <bool> cloud-auto-sync: false;
    in-out property <bool> cloud-busy: false;
    in-out property <string> command-results: "Search views, resources, settings and help";

    callback load-pdf(string, string);
    callback create-project(string, string);
    callback create-default-project(string);
    callback open-project(string);
    callback start-job();
    callback run-command(string);
    callback query-command(string) -> string;
    callback sync-widget-theme(bool);
    callback update-preference(string, bool);
    callback update-ui-scale(int);
    callback library-action(string, string, string);
    callback refresh-research();
    callback preview-question(string, string, string, string);
    callback preview-protocol(string, string, string, string);
    callback apply-evidence-preview();
    callback load-question-history(string);
    callback load-protocol-history(string);
    callback preview-reference(string, string, string, string, string, string, string);
    callback apply-library-preview();
    callback refresh-references();
    callback preview-review-record(string, string);
    callback preview-review-screen(string, string, string, string, string, string);
    callback refresh-review(string);
    callback load-review-status(string, string, string);
    callback preview-extraction-form(string, string, string);
    callback preview-extraction-form-revision(string, string, string, string, string);
    callback preview-extraction-values(string, string, string, string);
    callback load-extraction-history(string);
    callback load-extraction-values(string);
    callback preview-analysis-import(string);
    callback apply-analysis-preview();
    callback inspect-dataset(string, string);
    callback run-descriptives(string, string, string);
    callback run-frequency(string, string, string);
    callback run-correlation(string, string, string, string);
    callback run-t-test(string, string, string, string, string, string);
    callback run-linear-model(string, string, string, string);
    callback inspect-variable-view(string, string);
    callback preview-variable-update(string, string, string, string);
    callback preview-analysis-result-save(string, string, string);
    callback apply-analysis-command-preview();
    callback load-analysis-result(string);
    callback render-analysis-report(string, string);
    callback export-analysis-script(string);
    callback run-mixed-joint-display(string, string, string, string, string, string);
    callback preview-writing-section(string, string, string, string);
    callback inspect-manuscript(string);
    callback export-manuscript(string, string);
    callback publishing-action(string, string, string);
    callback preview-conversation-create(string, string);
    callback preview-assistant-message(string, string, string);
    callback apply-ai-preview();
    callback load-assistant-history(string);
    callback list-assistant-conversations();
    callback preview-prompt-template(string, string, string);
    callback render-prompt-template(string, string);
    callback preview-agent-plan(string, string, string);
    callback stage-agent-action(string, string);
    callback approve-agent-action();
    callback deny-agent-action(string);
    callback execute-agent-action();
    callback load-agent-action-timeline();
    callback validate-provider(string, string, string, string, string);
    callback profile-action(string, string, string, string, string, string);
    callback list-provider-profiles();
    callback run-diagnostics();
    callback load-project-activity(string, string, string);
    callback clear-project-activity-view();
    callback preview-notebook-save(string);
    callback load-notebook-history();
    callback export-notebook();
    callback inspect-qualitative();
    callback preview-qualitative-code(string, string, string, string, string, string);
    callback preview-qualitative-transcript(string, string, string, string, bool);
    callback preview-qualitative-annotation(string, string, string, string, string, string, string);
    callback compute-qualitative-kappa(string, string);
    callback backup-action(string, string, string);
    callback restore-backup(bool, string, string, string);
    callback cloud-save-profile(string, string, string, string, string, string, string);
    callback cloud-save-credentials(string, string, string, string);
    callback cloud-save-encryption(string);
    callback cloud-local-action(string, string);
    callback cloud-network-action(string, string, string, string, string, string);
    callback set-cloud-auto-sync(bool, string, string);

    sync-widget-theme(dark) => {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    private property <[string]> pages: [
        "Welcome", "Dashboard", "Question", "Search", "Protocol", "Library", "Reader", "PDF Reader",
        "Evidence", "Review", "PRISMA", "Extraction", "Data View", "Variable View", "Statistics",
        "Analysis Results", "Qualitative", "Codebook", "Mixed Methods", "Manuscript", "References",
        "Notebook", "Publishing", "Agent", "Providers", "Privacy", "Integrations", "Exports",
        "Backups", "Recovery", "Diagnostics", "Jobs", "Notifications", "Tutorials", "Guidance",
        "Shortcuts", "Preferences", "Activity", "About", "Cloud Sync"
    ];

    // Activity roots are intentionally much smaller than the legacy 39-screen directory.
    // Legacy page ids remain stable for migration, automation and command aliases.
    private property <int> activity:
        (root.page == 0 || root.page == 1 || root.page == 2 || root.page == 4) ? 0 :
        (root.page == 3 || root.page == 5 || root.page == 6 || root.page == 7 || root.page == 8 ||
         root.page == 9 || root.page == 10 || root.page == 11 || root.page == 20) ? 1 :
        (root.page >= 12 && root.page <= 18) ? 2 :
        (root.page == 19 || root.page == 21 || root.page == 22 || root.page == 27) ? 3 :
        (root.page == 23 || root.page == 31 || root.page == 32) ? 4 : 5;
    private property <string> activity-name:
        root.activity == 0 ? "Home" :
        root.activity == 1 ? "Sources" :
        root.activity == 2 ? "Analyze" :
        root.activity == 3 ? "Synthesize" :
        root.activity == 4 ? "Automate" : "Manage";
    // Keep responsive state imperative so child layout metrics never feed back
    // into the width expression that decides whether those children collapse.
    // Do not replace these changed callbacks with a direct width-dependent
    // visibility binding: doing so creates a cyclic Slint layout dependency.
    private property <bool> show-context-sidebar: true;
    private property <bool> show-inspector: true;
    private property <length> responsive-width: root.width;
    private property <int> responsive-scale: Theme.ui-scale;
    changed responsive-width => {
        root.show-context-sidebar = Theme.ui-scale < 160 && root.responsive-width >= 980px * Theme.ui-scale / 100;
        root.show-inspector = root.responsive-width >= 1180px * Theme.ui-scale / 100;
    }
    changed responsive-scale => {
        root.show-context-sidebar = Theme.ui-scale < 160 && root.responsive-width >= 980px * Theme.ui-scale / 100;
        root.show-inspector = root.responsive-width >= 1180px * Theme.ui-scale / 100;
    }
    private property <string> object-kind:
        (root.page == 0 || root.page == 1 || root.page == 2 || root.page == 4) ? "Project" :
        (root.page >= 3 && root.page <= 11) || root.page == 20 ? "Source" :
        (root.page == 12 || root.page == 13) ? "Dataset" :
        (root.page >= 14 && root.page <= 18) ? "Analysis" :
        (root.page == 19 || root.page == 21 || root.page == 22 || root.page == 27) ? "Document" :
        (root.page == 23 || root.page == 31 || root.page == 32) ? "Automation" : "Workspace";
    private property <int> focus-region: 0;
    private property <int> statistics-mode: 0;

    FocusScope {
        KeyBinding {
            keys: @keys(F6);
            activated => {
                if (root.focus-region == 0) {
                    if (root.show-context-sidebar) {
                        context-start.focus();
                        root.focus-region = 1;
                    } else {
                        command-field.focus();
                        root.focus-region = 2;
                    }
                } else if (root.focus-region == 1) {
                    command-field.focus();
                    root.focus-region = 2;
                } else if (root.focus-region == 2) {
                    tray-focus.focus();
                    root.focus-region = 3;
                } else {
                    home-activity.focus();
                    root.focus-region = 0;
                }
            }
        }
        KeyBinding {
            keys: @keys(Shift + F6);
            activated => {
                if (root.focus-region == 0) {
                    tray-focus.focus();
                    root.focus-region = 3;
                } else if (root.focus-region == 3) {
                    command-field.focus();
                    root.focus-region = 2;
                } else if (root.focus-region == 2) {
                    if (root.show-context-sidebar) {
                        context-start.focus();
                        root.focus-region = 1;
                    } else {
                        home-activity.focus();
                        root.focus-region = 0;
                    }
                } else {
                    home-activity.focus();
                    root.focus-region = 0;
                }
            }
        }
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "k" || event.text == "K")) {
                command-field.focus();
                accept
            } else if (event.text == Key.Escape) {
                command-field.text = "";
                root.command-results = "Search views, resources, settings and help";
                home-activity.focus();
                root.focus-region = 0;
                accept
            } else if (event.modifiers.control && event.text == "1") {
                root.page = 0;
                accept
            } else if (event.modifiers.control && event.text == "2") {
                root.page = 1;
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            spacing: 0px;

            HorizontalLayout {
                spacing: 0px;

                // Activity rail: stable roots instead of 39 equal-weight destinations.
                Rectangle {
                    min-width: Theme.ui-scale > 150 ? 176px : (Theme.ui-scale > 120 ? 132px : 104px);
                    preferred-width: Theme.ui-scale > 150 ? 176px : (Theme.ui-scale > 120 ? 132px : 104px);
                    max-width: Theme.ui-scale > 150 ? 176px : (Theme.ui-scale > 120 ? 132px : 104px);
                    horizontal-stretch: 0;
                    background: Theme.rail-background;
                    accessible-role: navigation;
                    accessible-label: "Activity rail";
                    ScrollView {
                      VerticalLayout {
                        padding: 10px;
                        spacing: 5px;
                        alignment: start;
                        Image {
                            source: @image-url("../../../assets/branding/researchweave-mark.svg");
                            min-height: 34px;
                            preferred-height: 34px;
                            max-height: 34px;
                            image-fit: contain;
                        }
                        Text {
                            text: "WORKBENCH";
                            color: Theme.rail-muted;
                            font-size: Theme.ui-scale > 150 ? 12px : 9px;
                            horizontal-alignment: center;
                        }
                        Rectangle { height: 2px; }
                        home-activity := ActivityNavButton {
                            label: "Home";
                            icon: @image-url("../../../assets/icons/home.svg");
                            selected: root.activity == 0;
                            clicked => { root.page = 1; }
                        }
                        ActivityNavButton {
                            label: "Sources";
                            icon: @image-url("../../../assets/icons/sources.svg");
                            selected: root.activity == 1;
                            clicked => { root.page = 5; }
                        }
                        ActivityNavButton {
                            label: "Analyze";
                            icon: @image-url("../../../assets/icons/analyze.svg");
                            selected: root.activity == 2;
                            clicked => { root.page = 12; }
                        }
                        ActivityNavButton {
                            label: "Synthesize";
                            icon: @image-url("../../../assets/icons/synthesize.svg");
                            selected: root.activity == 3;
                            clicked => { root.page = 21; }
                        }
                        ActivityNavButton {
                            label: "Automate";
                            icon: @image-url("../../../assets/icons/automate.svg");
                            selected: root.activity == 4;
                            clicked => { root.page = 23; }
                        }
                        ActivityNavButton {
                            label: "Manage";
                            icon: @image-url("../../../assets/icons/manage.svg");
                            selected: root.activity == 5;
                            clicked => { root.page = 36; }
                        }
                      }
                    }
                }

                // Context sidebar changes with the active research activity.
                Rectangle {
                    visible: root.show-context-sidebar;
                    min-width: root.show-context-sidebar ? 180px * Theme.ui-scale / 100 : 0px;
                    preferred-width: root.show-context-sidebar ? 245px * Theme.ui-scale / 100 : 0px;
                    max-width: root.show-context-sidebar ? 255px * Theme.ui-scale / 100 : 0px;
                    horizontal-stretch: 0;
                    clip: true;
                    background: Theme.surface;
                    border-color: Theme.divider;
                    border-width: 1px;
                    accessible-role: navigation;
                    accessible-label: root.activity-name + " navigation";
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: root.activity-name;
                            color: Theme.ink;
                            font-size: 18px * Theme.ui-scale / 100;
                            font-weight: 650;
                        }
                        context-start := Button {
                            text: "Current activity";
                            max-height: 32px;
                            accessible-label: root.activity-name + " navigation start";
                            accessible-description: "Keyboard focus entry point for the current activity sidebar";
                            clicked => {
                                root.page =
                                    root.activity == 0 ? 1 :
                                    root.activity == 1 ? 5 :
                                    root.activity == 2 ? 12 :
                                    root.activity == 3 ? 21 :
                                    root.activity == 4 ? 23 : 36;
                            }
                        }
                        Text {
                            text: root.project-title;
                            color: Theme.muted-ink;
                            font-size: 12px * Theme.ui-scale / 100;
                        }
                        Rectangle { height: 6px; }

                        if root.activity == 0: VerticalLayout {
                            spacing: 5px;
                            Button { text: root.page == 0 ? "› Start Center" : "Start Center"; accessible-label: "Welcome workspace screen"; clicked => { root.page = 0; } }
                            Button { text: root.page == 1 ? "› Project Home" : "Project Home"; accessible-label: "Dashboard workspace screen"; clicked => { root.page = 1; } }
                            Button { text: root.page == 2 ? "› Research Question" : "Research Question"; accessible-label: "Question workspace screen"; clicked => { root.page = 2; } }
                            Button { text: root.page == 4 ? "› Protocol" : "Protocol"; accessible-label: "Protocol workspace screen"; clicked => { root.page = 4; } }
                        }
                        if root.activity == 1: VerticalLayout {
                            spacing: 5px;
                            Button { text: root.page == 5 ? "› Library" : "Library"; accessible-label: "Library workspace screen"; clicked => { root.page = 5; } }
                            Button { text: root.page == 3 ? "› Search" : "Search"; accessible-label: "Search workspace screen"; clicked => { root.page = 3; } }
                            Button { text: root.page == 6 ? "› Reader" : "Reader"; accessible-label: "Reader workspace screen"; clicked => { root.page = 6; } }
                            Button { text: root.page == 7 ? "› PDF Reader" : "PDF Reader"; accessible-label: "PDF Reader workspace screen"; clicked => { root.page = 7; } }
                            Button { text: root.page == 8 ? "› Evidence" : "Evidence"; accessible-label: "Evidence workspace screen"; clicked => { root.page = 8; } }
                            Button { text: root.page == 20 ? "› References" : "References"; accessible-label: "References workspace screen"; clicked => { root.page = 20; } }
                            Text { text: "SYSTEMATIC REVIEW"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                            Button { text: root.page == 9 ? "› Review" : "Review"; accessible-label: "Review workspace screen"; clicked => { root.page = 9; } }
                            Button { text: root.page == 10 ? "› PRISMA" : "PRISMA"; accessible-label: "PRISMA workspace screen"; clicked => { root.page = 10; } }
                            Button { text: root.page == 11 ? "› Extraction" : "Extraction"; accessible-label: "Extraction workspace screen"; clicked => { root.page = 11; } }
                        }
                        if root.activity == 2: VerticalLayout {
                            spacing: 5px;
                            Text { text: "DATA"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                            Button { text: root.page == 12 ? "› Data" : "Data"; accessible-label: "Data View workspace screen"; clicked => { root.page = 12; } }
                            Button { text: root.page == 13 ? "› Variables" : "Variables"; accessible-label: "Variable View workspace screen"; clicked => { root.page = 13; } }
                            Text { text: "ANALYSIS"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                            Button { text: root.page == 14 ? "› Statistics" : "Statistics"; accessible-label: "Statistics workspace screen"; clicked => { root.page = 14; } }
                            Button { text: root.page == 15 ? "› Results" : "Results"; accessible-label: "Analysis Results workspace screen"; clicked => { root.page = 15; } }
                            Button { text: root.page == 16 ? "› Qualitative" : "Qualitative"; accessible-label: "Qualitative workspace screen"; clicked => { root.page = 16; } }
                            Button { text: root.page == 17 ? "› Codebook" : "Codebook"; accessible-label: "Codebook workspace screen"; clicked => { root.page = 17; } }
                            Button { text: root.page == 18 ? "› Mixed Methods" : "Mixed Methods"; accessible-label: "Mixed Methods workspace screen"; clicked => { root.page = 18; } }
                        }
                        if root.activity == 3: VerticalLayout {
                            spacing: 5px;
                            Button { text: root.page == 21 ? "› Notebook" : "Notebook"; accessible-label: "Notebook workspace screen"; clicked => { root.page = 21; } }
                            Button { text: root.page == 19 ? "› Manuscript" : "Manuscript"; accessible-label: "Manuscript workspace screen"; clicked => { root.page = 19; } }
                            Button { text: root.page == 22 ? "› Publishing" : "Publishing"; accessible-label: "Publishing workspace screen"; clicked => { root.page = 22; } }
                            Button { text: root.page == 27 ? "› Exports" : "Exports"; accessible-label: "Exports workspace screen"; clicked => { root.page = 27; } }
                        }
                        if root.activity == 4: VerticalLayout {
                            spacing: 5px;
                            Button { text: root.page == 23 ? "› Assistant" : "Assistant"; accessible-label: "Agent workspace screen"; clicked => { root.page = 23; } }
                            Button { text: root.page == 31 ? "› Jobs" : "Jobs"; accessible-label: "Jobs workspace screen"; clicked => { root.page = 31; } }
                            Button { text: root.page == 32 ? "› Notifications" : "Notifications"; accessible-label: "Notifications workspace screen"; clicked => { root.page = 32; } }
                        }
                        if root.activity == 5: VerticalLayout {
                            spacing: 4px;
                            Button { text: root.page == 24 ? "› Providers" : "Providers"; accessible-label: "Providers workspace screen"; clicked => { root.page = 24; } }
                            Button { text: root.page == 25 ? "› Privacy & approvals" : "Privacy & approvals"; accessible-label: "Privacy workspace screen"; clicked => { root.page = 25; } }
                            Button { text: root.page == 26 ? "› Integrations" : "Integrations"; accessible-label: "Integrations workspace screen"; clicked => { root.page = 26; } }
                            Button { text: root.page == 28 ? "› Backups" : "Backups"; accessible-label: "Backups workspace screen"; clicked => { root.page = 28; } }
                            Button { text: root.page == 29 ? "› Recovery" : "Recovery"; accessible-label: "Recovery workspace screen"; clicked => { root.page = 29; } }
                            Button { text: root.page == 39 ? "› Cloud Sync" : "Cloud Sync"; accessible-label: "Cloud Sync workspace screen"; clicked => { root.page = 39; } }
                            Button { text: root.page == 30 ? "› Diagnostics" : "Diagnostics"; accessible-label: "Diagnostics workspace screen"; clicked => { root.page = 30; } }
                            Button { text: root.page == 36 ? "› Preferences" : "Preferences"; accessible-label: "Preferences workspace screen"; clicked => { root.page = 36; } }
                            Button { text: root.page == 35 ? "› Shortcuts" : "Shortcuts"; accessible-label: "Shortcuts workspace screen"; clicked => { root.page = 35; } }
                            Button { text: root.page == 33 ? "› Tutorials" : "Tutorials"; accessible-label: "Tutorials workspace screen"; clicked => { root.page = 33; } }
                            Button { text: root.page == 34 ? "› Guidance" : "Guidance"; accessible-label: "Guidance workspace screen"; clicked => { root.page = 34; } }
                            Button { text: root.page == 37 ? "› Activity" : "Activity"; accessible-label: "Activity workspace screen"; clicked => { root.page = 37; } }
                            Button { text: root.page == 38 ? "› About" : "About"; accessible-label: "About workspace screen"; clicked => { root.page = 38; } }
                        }
                    }
                }

                // Primary work area.
                VerticalLayout {
                    spacing: 0px;
                    accessible-role: main;
                    accessible-label: root.pages[root.page] + " work area";
                    Rectangle {
                        height: 84px * Theme.ui-scale / 100;
                        background: Theme.surface;
                        border-color: Theme.divider;
                        border-width: 1px;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: root.activity-name + "  /  " + root.pages[root.page];
                                    color: Theme.muted-ink;
                                    font-size: 11px * Theme.ui-scale / 100;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.pages[root.page];
                                    color: Theme.ink;
                                    font-size: 22px * Theme.ui-scale / 100;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle { width: 16px; }
                            command-field := LineEdit {
                                placeholder-text: "Find workbench views…  Ctrl+K";
                                accessible-id: "command-palette";
                                accessible-label: "Command palette";
                                accessible-description: "Press Control K, type a workbench activity or destination, and press Enter";
                                edited(text) => { root.command-results = root.query-command(text); }
                                accepted(text) => {
                                    root.run-command(text);
                                    root.command-results = root.query-command(text);
                                }
                            }
                            Text {
                                text: "Ctrl+K";
                                visible: Theme.ui-scale <= 150;
                                color: Theme.muted-ink;
                                font-size: 11px * Theme.ui-scale / 100;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.project-title + " · r" + root.project-revision;
                                visible: Theme.ui-scale <= 150 && root.width >= 1100px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: Theme.muted-ink;
                                font-size: 12px * Theme.ui-scale / 100;
                                    wrap: word-wrap;
                            }
                        }
                    }

                    if command-field.text != "": Rectangle {
                        height: 38px * Theme.ui-scale / 100;
                        background: Theme.accent-subtle;
                        border-color: Theme.divider;
                        border-width: 1px;
                        Text {
                            x: 14px;
                            width: parent.width - 28px;
                            vertical-alignment: center;
                            text: root.command-results;
                            color: Theme.ink;
                            font-size: 11px * Theme.ui-scale / 100;
                            accessible-label: "Command center results: " + root.command-results;
                        }
                    }

                    // A compact object-tab strip establishes persistent workbench structure.
                    Rectangle {
                        height: 34px * Theme.ui-scale / 100;
                        background: Theme.tab-strip;
                        border-color: Theme.divider;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Text {
                                text: root.object-kind;
                                color: Theme.muted-ink;
                                font-size: 9px * Theme.ui-scale / 100;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: min(300px, 170px * Theme.ui-scale / 100);
                                background: Theme.surface;
                                border-radius: 4px;
                                border-color: Theme.divider;
                                border-width: 1px;
                                Text {
                                    x: 10px;
                                    vertical-alignment: center;
                                    text: root.pages[root.page] + " · " + root.object-kind;
                                    color: Theme.ink;
                                    font-size: 12px * Theme.ui-scale / 100;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    if root.page == 0: Rectangle {
                        background: Theme.raised;
                        HorizontalLayout {
                            padding: 24px;
                            spacing: 20px;
                            Rectangle {
                                background: Theme.surface;
                                border-radius: Theme.panel-radius;
                                border-color: Theme.divider;
                                border-width: 1px;
                                VerticalLayout {
                                    padding: 22px;
                                    spacing: 12px;
                                    Text { text: "Start a research project"; font-size: 24px * Theme.ui-scale / 100; font-weight: 700; color: Theme.ink; }
                                    Text { text: "Private and local by default. Cloud sync is always opt-in."; color: Theme.muted-ink; font-size: 13px * Theme.ui-scale / 100; }
                                    Button {
                                        text: "Quick create in managed local storage";
                                        primary: true;
                                        accessible-label: "Create default project";
                                        accessible-description: "Create a private local project without choosing a filesystem path";
                                        clicked => { root.create-default-project(project-name.text); }
                                    }
                                    Text { text: "CUSTOM LOCATION"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: "PROJECT LOCATION"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    project-path := LineEdit {
                                        placeholder-text: "Absolute project folder path";
                                        accessible-id: "project-path";
                                        accessible-label: "Project path";
                                        accessible-description: "Absolute directory path for creating or opening a local project";
                                    }
                                    Text { text: "PROJECT TITLE"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    project-name := LineEdit {
                                        placeholder-text: "New project title";
                                        text: "My Research";
                                        accessible-id: "project-title";
                                        accessible-label: "Project title";
                                        accessible-description: "Title used when creating a new local project";
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button {
                                            text: "Create at custom path";
                                            accessible-label: "Create project";
                                            accessible-description: "Create a project in the specified directory";
                                            clicked => { root.create-project(project-path.text, project-name.text); }
                                        }
                                        Button {
                                            text: "Open existing";
                                            accessible-label: "Open project";
                                            accessible-description: "Open the existing project in the specified directory";
                                            clicked => { root.open-project(project-path.text); }
                                        }
                                    }
                                    Text { text: "Research note"; color: Theme.ink; font-weight: 600; }
                                    TextEdit {
                                        text: "Try multiline text, selection and international input.";
                                        accessible-id: "research-note";
                                        accessible-label: "Research note";
                                        accessible-description: "Multiline editable research note";
                                    }
                                }
                            }
                            Rectangle {
                                visible: root.show-inspector;
                                min-width: 0px;
                                preferred-width: root.show-inspector ? 280px : 0px;
                                max-width: root.show-inspector ? 280px : 0px;
                                horizontal-stretch: 0;
                                background: Theme.accent-subtle;
                                border-radius: Theme.panel-radius;
                                border-color: Theme.divider;
                                border-width: 1px;
                                accessible-role: complementary;
                                accessible-label: "Start Center guidance";
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 10px;
                                    Text { text: "ResearchWeave"; color: Theme.ink; font-size: 18px * Theme.ui-scale / 100; font-weight: 700; }
                                    Text { text: "A traceable research workbench"; color: Theme.accent; font-size: 12px * Theme.ui-scale / 100; }
                                    Rectangle { height: 6px; }
                                    Text { text: "• Question and protocol"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "• Sources and evidence"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "• Data and analysis"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "• Synthesis and publishing"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "• Approval-bound automation"; color: Theme.ink; font-size: 12px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Rectangle { height: 8px; }
                                    Text { text: "No project selected yet."; color: Theme.muted-ink; font-size: 12px * Theme.ui-scale / 100; }
                                }
                            }
                        }
                    }

                    if root.page == 1: Rectangle {
                        background: Theme.raised;
                        HorizontalLayout {
                            padding: 22px;
                            spacing: 18px;
                            VerticalLayout {
                                spacing: 12px;
                                Text { text: "Project home"; font-size: 22px * Theme.ui-scale / 100; font-weight: 700; color: Theme.ink; }
                                Text { text: "Current project"; color: Theme.muted-ink; font-size: 11px * Theme.ui-scale / 100; }
                                Text { text: root.project-title; color: Theme.ink; font-size: 18px * Theme.ui-scale / 100; font-weight: 600; }
                                Text { text: "Revision " + root.project-revision + " · local workspace"; color: Theme.muted-ink; }
                                Text { text: "Continue research"; color: Theme.muted-ink; font-size: 11px * Theme.ui-scale / 100; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Question"; icon: @image-url("../../../assets/icons/question.svg"); icon-size: 18px; colorize-icon: true; accessible-label: "Open research question"; clicked => { root.page = 2; } }
                                    Button { text: "Protocol"; icon: @image-url("../../../assets/icons/protocol.svg"); icon-size: 18px; colorize-icon: true; accessible-label: "Open protocol"; clicked => { root.page = 4; } }
                                    Button { text: "Library"; icon: @image-url("../../../assets/icons/sources.svg"); icon-size: 18px; colorize-icon: true; accessible-label: "Open library"; clicked => { root.page = 5; } }
                                    Button { text: "Data"; icon: @image-url("../../../assets/icons/data.svg"); icon-size: 18px; colorize-icon: true; accessible-label: "Open data view"; clicked => { root.page = 12; } }
                                }
                                Rectangle {
                                    height: 76px;
                                    background: Theme.accent-subtle;
                                    border-radius: Theme.panel-radius;
                                    border-color: Theme.divider;
                                    border-width: 1px;
                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 18px;
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text { text: "REVISION"; color: Theme.muted-ink; font-size: 9px * Theme.ui-scale / 100; }
                                            Text { text: root.project-revision; color: Theme.ink; font-size: 18px * Theme.ui-scale / 100; font-weight: 700; }
                                            Text { text: "immutable project state"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                        }
                                        Rectangle { width: 1px; background: Theme.divider; }
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text { text: "STORAGE"; color: Theme.muted-ink; font-size: 9px * Theme.ui-scale / 100; }
                                            Text { text: "Local first"; color: Theme.success; font-size: 14px * Theme.ui-scale / 100; font-weight: 650; }
                                            Text { text: "project-scoped data"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                        }
                                        Rectangle { width: 1px; background: Theme.divider; }
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text { text: "WRITES"; color: Theme.muted-ink; font-size: 9px * Theme.ui-scale / 100; }
                                            Text { text: "Approval bound"; color: Theme.accent; font-size: 14px * Theme.ui-scale / 100; font-weight: 650; }
                                            Text { text: "preview before mutation"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                        }
                                    }
                                }
                                Text { text: "Responsiveness"; color: Theme.ink; font-weight: 600; }
                                Button {
                                    text: "Run local responsiveness check";
                                    accessible-label: "Run local responsiveness check";
                                    clicked => { root.start-job(); }
                                }
                                SemanticProgress {
                                    progress: root.progress;
                                    label: "Background operation progress";
                                }
                                Text {
                                    text: "No sample research data is fabricated in the production workspace. Open or import real project data from Analyze.";
                                    color: Theme.muted-ink;
                                    font-size: 11px * Theme.ui-scale / 100;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle {
                                visible: root.show-inspector;
                                min-width: 0px;
                                preferred-width: root.show-inspector ? 250px : 0px;
                                max-width: root.show-inspector ? 250px : 0px;
                                horizontal-stretch: 0;
                                background: Theme.surface;
                                border-radius: Theme.panel-radius;
                                border-color: Theme.divider;
                                border-width: 1px;
                                accessible-role: complementary;
                                accessible-label: "Project context inspector";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text { text: "Context"; color: Theme.ink; font-size: 15px * Theme.ui-scale / 100; font-weight: 600; }
                                    Text { text: "Project revision"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: root.project-revision; color: Theme.ink; }
                                    Text { text: "Storage"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: "Local first"; color: Theme.success; }
                                    Text { text: "Network"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: "Explicit approval required"; color: Theme.ink; font-size: 11px * Theme.ui-scale / 100; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    if root.page == 7: Rectangle {
                        background: Theme.raised;
                        HorizontalLayout {
                            padding: 16px;
                            spacing: 14px;
                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "PDF source"; font-size: 18px * Theme.ui-scale / 100; font-weight: 700; color: Theme.ink; }
                                pdf-path := LineEdit {
                                    placeholder-text: "Absolute path to a local PDF";
                                    accessible-label: "PDF file path";
                                    accessible-description: "Absolute path to the PDF file to display";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    pdf-query := LineEdit {
                                        text: "PDFium";
                                        placeholder-text: "Search first page";
                                        accessible-label: "PDF search query";
                                    }
                                    Button {
                                        text: "Open";
                                        primary: true;
                                        accessible-label: "Open PDF";
                                        clicked => {
                                            root.pdf-job += 1;
                                            root.pdf-status = "Rendering PDF…";
                                            root.load-pdf(pdf-path.text, pdf-query.text);
                                        }
                                    }
                                    Button {
                                        text: "Search";
                                        accessible-label: "Search PDF";
                                        clicked => {
                                            root.pdf-job += 1;
                                            root.pdf-status = "Searching PDF…";
                                            root.load-pdf(pdf-path.text, pdf-query.text);
                                        }
                                    }
                                }
                                Text {
                                    text: root.pdf-status + " · matches: " + root.pdf-matches;
                                    color: Theme.muted-ink;
                                    accessible-label: "PDF search status: " + root.pdf-status + " matches: " + root.pdf-matches;
                                }
                                Rectangle {
                                    background: Theme.reader-canvas;
                                    clip: true;
                                    pdf-view := Image {
                                        source: root.pdf-image;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: contain;
                                        accessible-label: "Rendered PDF page";
                                    }
                                    if root.pdf-highlight-visible: Rectangle {
                                        x: root.pdf-highlight-x * pdf-view.width;
                                        y: root.pdf-highlight-y * pdf-view.height;
                                        width: root.pdf-highlight-w * pdf-view.width;
                                        height: root.pdf-highlight-h * pdf-view.height;
                                        background: Theme.accent-subtle;
                                        border-color: Theme.warning;
                                        border-width: 2px;
                                    }
                                }
                            }
                            Rectangle {
                                visible: root.show-inspector;
                                min-width: 0px;
                                preferred-width: root.show-inspector ? 250px : 0px;
                                max-width: root.show-inspector ? 250px : 0px;
                                horizontal-stretch: 0;
                                background: Theme.surface;
                                border-radius: Theme.panel-radius;
                                border-color: Theme.divider;
                                border-width: 1px;
                                accessible-role: complementary;
                                accessible-label: "PDF reader context inspector";
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text { text: "Reader context"; color: Theme.ink; font-size: 15px * Theme.ui-scale / 100; font-weight: 600; }
                                    Text { text: "Current native scope"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Text { text: "First-page render and search"; color: Theme.ink; font-size: 11px * Theme.ui-scale / 100; wrap: word-wrap; }
                                    Text { text: "Selection and annotations remain pending."; color: Theme.warning; font-size: 11px * Theme.ui-scale / 100; }
                                    Text { text: "Evidence"; color: Theme.muted-ink; font-size: 10px * Theme.ui-scale / 100; }
                                    Button { text: "Open evidence"; clicked => { root.page = 8; } }
                                }
                            }
                        }
                    }

                    if root.page == 5: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 10px;
                            Text { text: "Local source library"; font-size: 22px * Theme.ui-scale / 100; color: Theme.ink; }
                            source-title := LineEdit { placeholder-text: "Source title"; accessible-label: "Source title"; }
                            source-body := TextEdit { accessible-label: "Source text"; text: ""; }
                            HorizontalLayout {
                                spacing: 10px;
                                Button { text: "Add source"; accessible-label: "Add source"; clicked => { root.library-action("add", source-title.text, source-body.text); } }
                                Button { text: "Refresh sources"; accessible-label: "Refresh sources"; clicked => { root.library-action("list", "", ""); } }
                            }
                            Text { text: root.library-results; color: Theme.ink; wrap: word-wrap; accessible-label: "Library results"; }
                        }
                    }

                    if root.page == 36: Rectangle {
                        background: Theme.raised;
                        ScrollView {
                          VerticalLayout {
                            padding: 24px;
                            spacing: 14px;
                            Text { text: "Display preferences"; color: Theme.ink; font-size: 24px * Theme.ui-scale / 100; font-weight: 700; }
                            Text { text: "Saved locally and restored when you reopen ResearchWeave."; color: Theme.muted-ink; wrap: word-wrap; }
                            Button {
                                text: Theme.dark-mode ? "Dark theme: on" : "Dark theme: off";
                                accessible-label: "Toggle dark theme";
                                clicked => { root.update-preference("dark-mode", !Theme.dark-mode); }
                            }
                            Text { text: Theme.dark-mode ? "Dark theme: on" : "Dark theme: off"; accessible-label: Theme.dark-mode ? "Dark theme: on" : "Dark theme: off"; color: Theme.ink; }
                            Button {
                                text: Theme.high-contrast ? "High contrast: on" : "High contrast: off";
                                accessible-label: "Toggle high contrast";
                                clicked => { root.update-preference("high-contrast", !Theme.high-contrast); }
                            }
                            Text { text: Theme.high-contrast ? "High contrast: on" : "High contrast: off"; accessible-label: Theme.high-contrast ? "High contrast: on" : "High contrast: off"; color: Theme.ink; }
                            Button {
                                text: Theme.compact-density ? "Compact density: on" : "Compact density: off";
                                accessible-label: Theme.compact-density ? "Compact density: on" : "Compact density: off";
                                clicked => { root.update-preference("compact-density", !Theme.compact-density); }
                            }
                            Text { text: "Interface text scale: " + Theme.ui-scale + "%"; accessible-label: "Interface text scale: " + Theme.ui-scale + "%"; color: Theme.ink; }
                            HorizontalLayout {
                                spacing: Theme.space3;
                                Button { text: "Smaller"; accessible-label: "Decrease interface scale"; enabled: Theme.ui-scale > 80; clicked => { root.update-ui-scale(Theme.ui-scale - 10); } }
                                Button { text: "Larger"; accessible-label: "Increase interface scale"; enabled: Theme.ui-scale < 200; clicked => { root.update-ui-scale(Theme.ui-scale + 10); } }
                                Button { text: "Reset scale"; accessible-label: "Reset interface scale"; clicked => { root.update-ui-scale(100); } }
                            }
                            Button {
                                text: Theme.reduced-motion ? "Reduced motion: on" : "Reduced motion: off";
                                accessible-label: "Toggle reduced motion";
                                clicked => { root.update-preference("reduced-motion", !Theme.reduced-motion); }
                            }
                            Rectangle { vertical-stretch: 1; }
                          }
                        }
                    }

                    if root.page == 28: Rectangle {
                        background: Theme.raised;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            Text { text: "Project backups"; color: Theme.ink; font-size: 24px * Theme.ui-scale / 100; font-weight: 700; }
                            Text {
                                text: "Portable archives are verified before completion. Encrypted archives use scrypt + AES-256-GCM and never save the password.";
                                color: Theme.muted-ink;
                                wrap: word-wrap;
                            }
                            backup-path := LineEdit {
                                placeholder-text: "Absolute path ending in .rwproj or .rwproj.enc";
                                accessible-label: "Backup archive path";
                            }
                            backup-password := LineEdit {
                                placeholder-text: "Encryption password";
                                input-type: password;
                                accessible-label: "Backup encryption password";
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Button {
                                    text: "Export portable";
                                    accessible-label: "Export portable project archive";
                                    clicked => { root.backup-action("export", backup-path.text, ""); }
                                }
                                Button {
                                    text: "Export encrypted";
                                    accessible-label: "Export encrypted project archive";
                                    clicked => { root.backup-action("export-encrypted", backup-path.text, backup-password.text); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Button {
                                    text: "Verify portable";
                                    accessible-label: "Verify portable project archive";
                                    clicked => { root.backup-action("verify", backup-path.text, ""); }
                                }
                                Button {
                                    text: "Verify encrypted";
                                    accessible-label: "Verify encrypted project archive";
                                    clicked => { root.backup-action("verify-encrypted", backup-path.text, backup-password.text); }
                                }
                            }
                            Text { text: root.backup-results; color: Theme.ink; wrap: word-wrap; accessible-label: "Backup result"; }
                            Rectangle { vertical-stretch: 1; }
                        }
