# ResearchWeave has no required environment variables for offline launch.
# Optional local override for development, portable setups, and isolated QA.
# RESEARCHWEAVE_HOST_DATA_DIR=C:\path\to\researchweave-data
# CLI-only data-root override when exercising researchweave-cli directly.
# RESEARCHWEAVE_DATA_DIR=C:\path\to\researchweave-cli-data
