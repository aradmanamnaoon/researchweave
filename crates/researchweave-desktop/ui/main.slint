import { Button, LineEdit, TextEdit, ListView, ScrollView, StandardTableView, Palette } from "std-widgets.slint";
export { Palette } from "std-widgets.slint";

export struct QuickNoteCard {
    id: string,
    title: string,
    preview: string,
    labels: string,
    pinned: bool,
    archived: bool,
    revision: int,
}

export struct ManuscriptHeading {
    title: string,
    level: int,
    offset: int,
}

export struct ManuscriptReferenceChoice {
    reference-id: string,
    title: string,
}

export struct SourceListEntry {
    source-id: string,
    title: string,
    snippet: string,
}

export global Theme {
    in-out property <bool> dark-mode: false;
    in-out property <bool> high-contrast: false;
    in-out property <bool> compact-density: false;
    in-out property <int> ui-scale: 100;
    in-out property <bool> reduced-motion: false;
    in-out property <color> canvas: high-contrast ? #000000 : (dark-mode ? #101923 : #f6f5f1);
    in-out property <color> surface: high-contrast ? #111111 : (dark-mode ? #172438 : #ffffff);
    in-out property <color> raised: high-contrast ? #1b1b1b : (dark-mode ? #1d2e3a : #edf1f0);
    in-out property <color> ink: high-contrast ? #ffffff : (dark-mode ? #f4f6f8 : #172438);
    in-out property <color> muted-ink: high-contrast ? #ffffff : (dark-mode ? #b9c5d3 : #5b677a);
    in-out property <color> divider: high-contrast ? #ffffff : (dark-mode ? #81919f : #87989a);
    // Brand accent deliberately uses a darker teal in light mode so white
    // primary-button text remains WCAG-AA readable.
    in-out property <color> accent: high-contrast ? #ffff00 : (dark-mode ? #55c7bd : #147a75);
    in-out property <color> accent-subtle: high-contrast ? #262600 : (dark-mode ? #173d3b : #ddeDEA);
    in-out property <color> accent-ink: high-contrast ? #000000 : (dark-mode ? #101923 : #ffffff);
    in-out property <color> focus: high-contrast ? #00ffff : (dark-mode ? #a997e8 : #7564b5);
    in-out property <color> success: high-contrast ? #7cffb2 : (dark-mode ? #7fd4af : #237a57);
    in-out property <color> warning: high-contrast ? #ffd166 : (dark-mode ? #e0a17b : #8a5a00);
    in-out property <color> danger: high-contrast ? #ff8899 : (dark-mode ? #ff9fad : #a9243e);
    in-out property <color> conflict: high-contrast ? #ffffff : (dark-mode ? #a997e8 : #7564b5);
    in-out property <color> evidence-violet: high-contrast ? #ffffff : (dark-mode ? #a997e8 : #7564b5);
    in-out property <color> discovery-copper: high-contrast ? #ffd166 : (dark-mode ? #e0a17b : #9a5b3a);
    in-out property <color> rail-muted: high-contrast ? #ffffff : (dark-mode ? #b9c5d3 : #b8c4d4);
    in-out property <color> rail-background: high-contrast ? #000000 : (dark-mode ? #101923 : #172438);
    in-out property <color> reader-canvas: high-contrast ? #000000 : (dark-mode ? #0c141d : #efede7);
    in-out property <color> tab-strip: high-contrast ? #1b1b1b : (dark-mode ? #13202c : #edf1f0);
    // Scientific-visualization roles. Charts must still expose numeric labels,
    // uncertainty and machine-readable data rather than encoding meaning by color.
    in-out property <color> data-1: high-contrast ? #00ffff : (dark-mode ? #55c7bd : #147a75);
    in-out property <color> data-2: high-contrast ? #ff99ff : (dark-mode ? #a997e8 : #7564b5);
    in-out property <color> data-3: high-contrast ? #ffd166 : (dark-mode ? #e0a17b : #9a5b3a);
    in-out property <color> data-4: high-contrast ? #ffffff : (dark-mode ? #8fb9e8 : #315f8f);
    in-out property <length> panel-radius: 8px;
    in-out property <length> control-radius: 5px;
    in-out property <length> space1: 4px;
    in-out property <length> space2: 8px;
    in-out property <length> space3: compact-density ? 8px : 12px;
    in-out property <length> space4: compact-density ? 12px : 16px;
    in-out property <length> space5: compact-density ? 16px : 20px;
    in-out property <length> space6: compact-density ? 18px : 24px;
    in-out property <length> space8: 32px;
}

component SemanticProgress inherits Rectangle {
    in property <float> progress;
    in property <string> label;
    min-height: 6px;
    preferred-height: 6px;
    max-height: 6px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: Theme.divider;
    border-radius: 3px;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    accessible-value: root.progress;
    accessible-value-minimum: 0.0;
    accessible-value-maximum: 1.0;
    Rectangle {
        width: parent.width * min(1, max(0, root.progress));
        height: parent.height;
        background: Theme.accent;
        border-radius: parent.border-radius;
    }
}

component ActivityNavButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;

    min-height: Theme.ui-scale > 150 ? 62px : 50px;
    preferred-height: Theme.ui-scale > 150 ? 62px : 50px;
    max-height: Theme.ui-scale > 150 ? 62px : 50px;
    horizontal-stretch: 1;
    background: root.selected
        ? Theme.accent-subtle
        : (touch.has-hover ? (Theme.dark-mode ? #213244 : #26384f) : transparent);
    border-radius: 9px;
    border-width: root.selected ? 1px : 0px;
    border-color: root.selected ? Theme.accent : transparent;
    clip: true;

    accessible-role: button;
    accessible-label: root.label + " activity";
    accessible-description: root.selected
        ? "Current ResearchWeave activity"
        : "Switch to the " + root.label + " research activity";
    accessible-action-default => { root.clicked(); }
    forward-focus: focus-scope;

    Rectangle {
        x: 7px;
        y: 10px;
        width: 3px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: root.selected ? Theme.accent : transparent;
        accessible-role: none;
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 3px;
        alignment: center;

        Image {
            source: root.icon;
            min-width: Theme.ui-scale > 150 ? 24px : 18px;
            preferred-width: Theme.ui-scale > 150 ? 24px : 18px;
            max-width: Theme.ui-scale > 150 ? 24px : 18px;
            min-height: Theme.ui-scale > 150 ? 24px : 18px;
            preferred-height: Theme.ui-scale > 150 ? 24px : 18px;
            max-height: Theme.ui-scale > 150 ? 24px : 18px;
            image-fit: contain;
            colorize: root.selected ? Theme.accent : Theme.rail-muted;
            accessible-role: none;
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.ink : Theme.rail-muted;
            font-size: Theme.ui-scale > 150 ? 14px : 10px;
            font-weight: root.selected ? 700 : 550;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            focus-scope.focus();
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if focus-scope.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.focus;
        accessible-role: none;
    }
}

// Give every secondary destination the same compact, predictable hit area.
// The default standard Button stretch can turn a short sidebar into a set of
// enormous blank controls at tall window sizes.
component SidebarItem inherits Button {
    min-height: 32px;
    preferred-height: 34px;
    max-height: 36px;
    horizontal-stretch: 1;
}

// Actionable destination card: a single native Button handles mouse, keyboard
// and accessibility activation. Parent ScrollViews adapt to narrow work areas.
component WorkflowLink inherits Rectangle {
    in property <string> heading;
    in property <string> detail;
    in property <string> action-label;
    callback activated;

    background: Theme.surface;
    border-color: Theme.divider;
    border-width: 1px;
    border-radius: Theme.panel-radius;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: Theme.space4;
        spacing: Theme.space2;
        Text {
            text: root.heading;
            color: Theme.ink;
            font-weight: 650;
            font-size: 15px * Theme.ui-scale / 100;
            wrap: word-wrap;
        }
        Text {
            text: root.detail;
            color: Theme.muted-ink;
            wrap: word-wrap;
        }
        Button {
            text: root.action-label;
            accessible-label: root.action-label + ": " + root.heading;
            accessible-description: root.detail;
            clicked => { root.activated(); }
        }
    }
}

