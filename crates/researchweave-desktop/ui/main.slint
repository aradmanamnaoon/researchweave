import { Button, ComboBox, LineEdit, TextEdit, ListView, ScrollView, Palette } from "std-widgets.slint";
export { Palette } from "std-widgets.slint";

export struct QuickNote {
    id: string,
    title: string,
    body: string,
    tags: string,
    color: string,
    revision: int,
    pinned: bool,
    archived: bool,
}

export global Theme {
    in-out property <bool> dark-mode: false;
    in-out property <bool> high-contrast: false;
    in-out property <bool> compact-density: false;
    in-out property <int> ui-scale: 100;
    in-out property <bool> reduced-motion: false;
    // Meridian palette: deep ink, mineral blue, amethyst, clay and warm paper.
    in-out property <color> canvas: high-contrast ? #000000 : (dark-mode ? #111b26 : #f5f4ef);
    in-out property <color> surface: high-contrast ? #111111 : (dark-mode ? #1c2a36 : #ffffff);
    in-out property <color> raised: high-contrast ? #1b1b1b : (dark-mode ? #243544 : #eaeff2);
    in-out property <color> ink: high-contrast ? #ffffff : (dark-mode ? #f5f7fa : #202b37);
    in-out property <color> muted-ink: high-contrast ? #ffffff : (dark-mode ? #c2cfdc : #566574);
    in-out property <color> divider: high-contrast ? #ffffff : (dark-mode ? #8798a8 : #899aa5);
    // Stronger mineral blue on light surfaces preserves readable white CTA text.
    in-out property <color> accent: high-contrast ? #ffff00 : (dark-mode ? #98bcd5 : #3b5b88);
    in-out property <color> accent-subtle: high-contrast ? #262600 : (dark-mode ? #263e59 : #e3ecf6);
    in-out property <color> accent-ink: high-contrast ? #000000 : (dark-mode ? #14202c : #ffffff);
    in-out property <color> focus: high-contrast ? #00ffff : (dark-mode ? #c4b6ff : #6957a6);
    in-out property <color> success: high-contrast ? #7cffb2 : (dark-mode ? #80d0ae : #227857);
    in-out property <color> warning: high-contrast ? #ffd166 : (dark-mode ? #e8b274 : #905b18);
    in-out property <color> danger: high-contrast ? #ff8899 : (dark-mode ? #ff9bb3 : #a83047);
    in-out property <color> conflict: high-contrast ? #ffffff : (dark-mode ? #b4a0e4 : #6957a6);
    in-out property <color> evidence-violet: high-contrast ? #ffffff : (dark-mode ? #b4a0e4 : #6957a6);
    in-out property <color> discovery-copper: high-contrast ? #ffd166 : (dark-mode ? #e4a880 : #9b6042);
    in-out property <color> rail-muted: high-contrast ? #ffffff : (dark-mode ? #c7d6e1 : #c7d6e1);
    in-out property <color> rail-background: high-contrast ? #000000 : (dark-mode ? #172638 : #263245);
    in-out property <color> rail-hover: high-contrast ? #262600 : (dark-mode ? #32465e : #364d69);
    in-out property <color> reader-canvas: high-contrast ? #000000 : (dark-mode ? #0f1922 : #eceae4);
    in-out property <color> note-sage: high-contrast ? #111111 : (dark-mode ? #294238 : #e2efe5);
    in-out property <color> note-lilac: high-contrast ? #111111 : (dark-mode ? #3a3450 : #efe7f6);
    in-out property <color> note-sand: high-contrast ? #111111 : (dark-mode ? #463b30 : #f7edda);
    in-out property <color> note-blue: high-contrast ? #111111 : (dark-mode ? #293e56 : #e2edf9);
    in-out property <color> tab-strip: high-contrast ? #1b1b1b : (dark-mode ? #182633 : #e8ebef);
    // Scientific-visualization roles. Charts must still expose numeric labels,
    // uncertainty and machine-readable data rather than encoding meaning by color.
    in-out property <color> data-1: high-contrast ? #00ffff : (dark-mode ? #98bcd5 : #3b5b88);
    in-out property <color> data-2: high-contrast ? #ff99ff : (dark-mode ? #b4a0e4 : #6957a6);
    in-out property <color> data-3: high-contrast ? #ffd166 : (dark-mode ? #e4a880 : #9b6042);
    in-out property <color> data-4: high-contrast ? #ffffff : (dark-mode ? #84c5b3 : #2b756d);
    in-out property <length> panel-radius: 8px;
    in-out property <length> control-radius: 5px;
    in-out property <length> space1: 4px;
    in-out property <length> space2: 8px;
    in-out property <length> space3: compact-density ? 8px : 12px;
    in-out property <length> space4: compact-density ? 12px : 16px;
    in-out property <length> space5: compact-density ? 16px : 20px;
    in-out property <length> space6: compact-density ? 18px : 24px;
    in-out property <length> space8: 32px;
}

component SemanticProgress inherits Rectangle {
    in property <float> progress;
    in property <string> label;
    min-height: 6px;
    preferred-height: 6px;
    max-height: 6px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: Theme.divider;
    border-radius: 3px;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    accessible-value: root.progress;
    accessible-value-minimum: 0.0;
    accessible-value-maximum: 1.0;
    Rectangle {
        width: parent.width * min(1, max(0, root.progress));
        height: parent.height;
        background: Theme.accent;
        border-radius: parent.border-radius;
    }
}

component ActivityNavButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;

    min-height: Theme.ui-scale > 150 ? 62px : 50px;
    preferred-height: Theme.ui-scale > 150 ? 62px : 50px;
    max-height: Theme.ui-scale > 150 ? 62px : 50px;
    horizontal-stretch: 1;
    background: root.selected
        ? Theme.accent-subtle
        : (touch.has-hover ? Theme.rail-hover : transparent);
    border-radius: 9px;
    border-width: root.selected ? 1px : 0px;
    border-color: root.selected ? Theme.accent : transparent;
    clip: true;

    accessible-role: button;
    accessible-label: root.label + " activity";
    accessible-description: root.selected
        ? "Current ResearchWeave activity"
        : "Switch to the " + root.label + " research activity";
    accessible-action-default => { root.clicked(); }
    forward-focus: focus-scope;

    Rectangle {
        x: 7px;
        y: 10px;
        width: 3px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: root.selected ? Theme.accent : transparent;
        accessible-role: none;
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 3px;
        alignment: center;

        Image {
            source: root.icon;
            min-width: Theme.ui-scale > 150 ? 24px : 18px;
            preferred-width: Theme.ui-scale > 150 ? 24px : 18px;
            max-width: Theme.ui-scale > 150 ? 24px : 18px;
            min-height: Theme.ui-scale > 150 ? 24px : 18px;
            preferred-height: Theme.ui-scale > 150 ? 24px : 18px;
            max-height: Theme.ui-scale > 150 ? 24px : 18px;
            image-fit: contain;
            colorize: root.selected ? Theme.accent : Theme.rail-muted;
            accessible-role: none;
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.ink : Theme.rail-muted;
            font-size: Theme.ui-scale > 150 ? 14px : 10px;
            font-weight: root.selected ? 700 : 550;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            focus-scope.focus();
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if focus-scope.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.focus;
        accessible-role: none;
    }
}

