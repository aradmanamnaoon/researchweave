                                        text: "{\"label\":\"\",\"scale\":\"unknown\",\"privacy_class\":\"internal\"}";
                                    }
                                    Button { text: "Preview metadata revision"; accessible-label: "Preview variable metadata revision"; clicked => { root.preview-variable-update(variable-dataset-id.text, variable-revision.text, variable-column.text, variable-updates.text); } }
                                    Button { text: "Record previewed revision"; accessible-label: "Record previewed variable metadata revision"; clicked => { root.apply-analysis-command-preview(); } }
                                }
                                Text {
                                    text: "Allowed metadata keys: label, units, scale, value_labels, missing_values, category_order, allowed_min, allowed_max, privacy_class, private, dtype.";
